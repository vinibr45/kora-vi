function getCurrentLocalization(){
  var retorno = new Array;
  if (navigator.geolocation) {
    var startPos;
    var latitude, longitude;
    var geoSuccess = function(position) {
      startPos = position;
      latitude = startPos.coords.latitude;
      longitude = startPos.coords.longitude;
      retorno.push({
        'LA' : latitude,
        'LO' : longitude
      });
    };
    navigator.geolocation.getCurrentPosition(geoSuccess);
    return retorno;
  } else {
    aviso("Não foi possível obter a localização, revise as permissões.",2);
  }
}

function converteTimestampBRtoUS(timestamp){
  var parts1 = timestamp.split(" ");
  var parts2 = parts1[0].split("/");
  return parts2[2] + '-' + parts2[1] + '-' + parts2[0] + 'T' + parts1[1] ;
}


