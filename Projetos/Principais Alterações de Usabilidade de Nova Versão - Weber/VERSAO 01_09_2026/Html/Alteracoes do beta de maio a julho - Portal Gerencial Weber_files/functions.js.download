function setaPropFinalizada(element){

  var num_proposta = $("#JanelaAlt_num").val();
  var id_proposta = $("#id_prop").val();
  var concluida = element.checked;
  if(num_proposta > 0){
    swal({
      title: "Você tem certeza desta alteração?",
      text: "Ao setar a proposta como CONCLUÍDA você não poderá desafazer esta alteração ou alterar o status da mesma.",
      icon: "warning",
      buttons: ["Não", "Sim"],
      dangerMode: false,
    }).then(function(podeSalvar){
      if (podeSalvar) {
        carregando(1);
        $.ajax({
          url:"ajax_propostaSetaConcluida.php",
          type:"post",
          data: {
            num_proposta : num_proposta,
            concluida : concluida,
          },
          success: function (result){
            var resultado = null;
            try {
              resultado = JSON.parse(result);
              if(resultado.status == 1){
                carregando(2);
                switch(concluida){
                  case true:
                  $("#concluida_prop_"+num_proposta).val('S');
                  break;
                  case false:
                  $("#concluida_prop_"+num_proposta).val('N');
                  break;
                }
                swal("Sucesso", "Proposta finalizada com sucesso", "success");
              } else {
                carregando(2);
                desmarcaCheckbox(element);
                swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
              }

            } catch(err){
              carregando(2);
              desmarcaCheckbox(element);
              swal("Ops..", "Erro na solicitação\n"+err, "warning");
            }

          }, error: function(result) {
            carregando(2);
            desmarcaCheckbox(element);
            swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
          }
        });

      } else {
        desmarcaCheckbox(element);
      }

    });

  } else {
    swal("Ops..", "Erro ao obter Número da proposta", "warning");
  }

}

function movimentacaoProposta(num_proposta, id_proposta, reset, num_proposta_clear, id_proposta_clear){

  if(reset == 1){ $("#modal_mvto_content").html(null); }
  $('#modal_mvto #JanelaAlt_id').val(id_proposta_clear);
  $('#modal_mvto  #JanelaAlt_num').val(num_proposta_clear);
  $("#modal_mvto_content").html(setaLoadingModal());
  if(num_proposta != null){
    carregando(1);
    $.ajax({
      url:"ajax_formPropostaMVTO.php",
      type:"post",
      data: { num_proposta : num_proposta, id_proposta : id_proposta, },
      success: function (result){
        $("#modal_mvto_content").html(result);
        carregando(2);
      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
        $("#modal_mvto").modal('hide');
      }

    });

  }

}

function addPropostaMVTO(){

  if($("#proposta_mvto_tipo").val() == 7){
    swal({
      title: "Você tem certeza?",
      text: "Adicionar esta movimentação fará com que a proposta seja setada como concluida automaticamente.",
      icon: "warning",
      buttons: ["Não", "Sim"],
      dangerMode: false,
    }).then(function(podeSalvar){
      if (podeSalvar) {
        run_addPropostaMVTO();
      }
    });
  } else {
    run_addPropostaMVTO();
  }

  function run_addPropostaMVTO(){
    var num_proposta = $("#proposta_mvto_num").val();
    var id_proposta = $("#proposta_mvto_id").val();
    var proposta_mvto_tipo = $("#proposta_mvto_tipo").val();
    var proposta_mvto_obs = $("#proposta_mvto_obs").val();
    if(num_proposta != null && proposta_mvto_tipo > 0){
      carregando(1);
      $.ajax({
        url:"ajax_propostaMVTOadd.php",
        type:"post",
        data: {
          num_proposta : num_proposta,
          id_proposta : id_proposta,
          proposta_mvto_tipo : proposta_mvto_tipo,
          proposta_mvto_obs : proposta_mvto_obs,
        },
        success: function (result){
          var resultado = null;
          try {
            resultado = JSON.parse(result);
            if(resultado.status == 1){
              if(proposta_mvto_tipo == 7){
                location.reload();
              } else {
                carregando(2);
                movimentacaoProposta(num_proposta, id_proposta, 0);
              }
            } else {
              carregando(2);
              swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
            }

          } catch(err){
            carregando(2);
            swal("Ops..", "Erro na solicitação\n"+err, "warning");
          }

        }, error: function(result) {
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
        }

      });
    } else {
      swal("Ops..", "Erro ao obter dados","warning");
    }
  }

}

