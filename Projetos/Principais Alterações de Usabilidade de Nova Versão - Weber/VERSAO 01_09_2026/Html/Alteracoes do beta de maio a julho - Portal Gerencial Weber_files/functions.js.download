}

function criaFormChat(){

  if($('#dialog_chat').length == 0){

    xmlhttp = new XMLHttpRequest();
    xmlhttp.open('GET', 'chat/index.php', false);
    xmlhttp.send();
    var data = xmlhttp.responseText;

    openDialogExt('Chat interno', data + '<style>.ui-dialog{background:#F4F4F4;-webkit-box-shadow: 0px 3px 21px 0px rgba(0,0,0,0.45); -moz-box-shadow: 0px 3px 21px 0px rgba(0,0,0,0.45); box-shadow: 0px 3px 21px 0px rgba(0,0,0,0.45); }.ui-dialog .ui-dialog-content { overflow: hidden !important; }</style>')
  }  else {
    $('#dialog_chat').dialogExtend('restore');
  }

}


function servico_autorizacao_Salvar(ir_para_calendario){
  var error = 0;
  if($("#cod_cli").val()<1 && $("#motivo").val()!=5){ error = 'Você deve informar o cliente.'; }
  if(!$("#data_visita").val()){ error = 'Você deve informar a data da visita.'; }
  if(!$("#motivo_obs").val()){ error = 'Você deve informar o motivo da visita.'; }
  if(!$("#contato_nome").val()){ error = 'Você deve informar o contato nome.'; }
  if(!$("#contato_fone").val()){ error = 'Você deve informar o contato fone.'; }
  if(!$("#tipo_deslocamento").val()){ error = "Você deve informar o tipo de deslocamento.";}
  if(!$("#motivo").val()){ error = "Você deve selecionar um motivo.";}
  if(error == 0){
    var data = $("#visita_autorizacoes_FORM").serialize();
    if (data) {
      carregando(1);
      $.ajax({
        url:"ajax_servicoAutorizacao_Salvar.php",
        type:"post",
        dataType: "json",
        data: { data : data },
        success: function (result){
          if(result.status == 1){
            carregando(2);
            avisoDown(result.mensagem);
            carregando(1);
            if(ir_para_calendario == true){
              window.open(result.url_calendario,'_blank');
              location.reload();
            } else {
              location.reload();
            }
          } else {
            carregando(2);
            swal("Ops..", "Erro na solicitação\n"+result.mensagem, "warning");
          }
        }, error: function(result) {
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
        }
      });
    }
  } else {
    aviso(error,2);
  }
}



function servico_autorizacao_Dados(E){
  $("#visita_autorizacoes_FORM")[0].reset();
  if(E){
    carregando(1);
    $.ajax({
      url: "ajax_servicoAutorizacao_Dados.php",
      type: "post",
      dataType: "json",
      data: { E : E },
      success: function (result){
        if(result.status == 1){
          $("#visita_autorizacoes_FORM #ei").val(result.ei);
          $("#visita_autorizacoes_FORM #us").val(result.us);
          $("#visita_autorizacoes_FORM #num_proposta").val(result.content.NUM_PROPOSTA);
          $("#visita_autorizacoes_FORM #cod_cli").val(result.content.COD_CLIENTE);
          $("#visita_autorizacoes_FORM #data_visita").val(result.content.DATA_VISITA.replace(" ", "\T"));
          $("#visita_autorizacoes_FORM #contato_nome").val(result.content.CONTATO_NOME);
          $("#visita_autorizacoes_FORM #contato_fone").val(result.content.CONTATO_FONE);
          $("#visita_autorizacoes_FORM #motivo_obs").val(result.content.MOTIVO_OBS);
          $("#visita_autorizacoes_FORM #tipo_deslocamento").val(result.content.TIPO_DESLOC);
          $("#visita_autorizacoes_FORM #status_situacao").val(result.content.STATUS_SITUACAO);
          $("#visita_autorizacoes_FORM #motivo").val(result.content.MOTIVO);
          $("#visita_autorizacoes_FORM .visita_autorizacoes_STATUS_TR").show();
          $("#modal_visita_autorizacoes_add").modal('show');
          carregando(2);
        } else {
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+result.mensagem, "warning");
        }
      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
      }
    });
  }
}

