function uploadFoto(){

  var formData = new FormData( $("#formUploadFoto")[0] );
  var pos = 0;
  var error = null;
  var arqUpload_exibition = $("#arqUpload_exibition").val();
  var arqUpload_categoria  = $("#arqUpload_categoria").val();
  if(!arqUpload_exibition){ error = "Selecione o tipo de exibição"; }
  if(!arqUpload_categoria) { error = "Erro ao obter o tipo, tente recarregar a página"; }
  if(error == null){
    formData.append('arqUpload_id_treinamento', $("#arqUpload_id_treinamento").val());
    formData.append('arqUpload_cod_clie', $("#arqUpload_cod_clie").val());
    formData.append('arqUpload_categoria', arqUpload_categoria);
    formData.append('arqUpload_exibition', arqUpload_exibition);
    formData.append('arqUpload_legenda', $("#arqUpload_legenda").val());
    formData.append('arqUpload', $('#arqUpload')[0].files[0]);
    carregando(1);
    $.ajax({
      url:"ajax_galeriaUpload.php",
      type:"post",
      timeout:210000,
      data: formData,
      cache : false,
      contentType: false,
      processData: false,
      success: function (result){
        var resultado = null;
        try {
          resultado = JSON.parse(result);
          if(resultado.status == 1){
            carregando(2);
            swal("Sucesso", resultado.mensagem, "success").then(function(value){
              window.open('galeria_area_cliente.php?f='+arqUpload_categoria, '_blank');
            });
          } else {
            carregando(2);
            swal("Ops..", resultado.mensagem, "warning");
          }
        } catch(err){
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+err, "warning");
        }
      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      }

    });
  } else {
    swal("Atenção", error, "warning");
  }

}

function formUploadFoto(tipo,cod_clie,id_treinamento){

  var form = '<form action=" method="post" id="formUploadFoto" enctype="multipart/form-data"><table class="table table-striped table-bordered"><tr><th>Arquivo</th><th>Exibição</th><th>Categoria</th></tr>';
  form += '<tr><td><input accept="image/*" type="file" required="required" id="arqUpload" name="arqUpload"></td><td><select class="form-control" name="arqUpload_exibition" required="required" id="arqUpload_exibition"><option value="">Selecione..</option><option value="N">Privada</option><option value="S">Pública</option></select></td>';
  form += '<td>';
  var disabled_categ = '';
  if(tipo > 0){ disabled_categ = ' disabled="disabled" ' }
  form += '<select '+disabled_categ+' class="form-control" name="arqUpload_categoria" id="arqUpload_categoria" >';
  form += '<option value="0">Selecione..</option>';
  form += '<option value="1">Treinamento</option>';
  form += '<option value="2">Implantações</option>';
  form += '</select>';
  form += '</td>';
  form += '</tr>';
  form += '<tr><th colspan="3">Legenda</th></tr>';
  form += '<tr><td colspan="3"><input type="text" class="form-control" maxlength="50" id="arqUpload_legenda" name="arqUpload_legenda"></td></tr>';
  form += '<tr><th colspan="3"><button type="button" name="arqUpload_send" class="btn btn-success" onclick="uploadFoto()"><i class="glyphicon glyphicon-save"></i>&nbsp;&nbsp;Carregar</button></th>';
  form += '</tr>';
  form += '</table>';
  form += '<input type="hidden" value="'+id_treinamento+'" id="arqUpload_id_treinamento" name="arqUpload_id_treinamento">';
  form += '<input type="hidden" value="'+cod_clie+'" id="arqUpload_cod_clie" name="arqUpload_cod_clie">';
  form += '</form>';
  $("#modal_upload_foto_content").html(form);
  $("#arqUpload_categoria").val(tipo);

}

