var delay = (function(){
  var timer = 0;
  return function(callback, ms){
    clearTimeout (timer);
    timer = setTimeout(callback, ms);
  };
})();

function loadingInput(status, id_element){
  if(status == 1){
    $("#"+id_element).addClass('loadingInput');
  } else {
    $("#"+id_element).removeClass('loadingInput');
  }
}

function isInt(value) {
  return !isNaN(value) &&
  parseInt(Number(value)) == value &&
  !isNaN(parseInt(value, 10));
}

function addslashes(string) {
  return string.replace(/\\/g, '\\\\').
  replace(/\u0008/g, '\\b').
  replace(/\t/g, '\\t').
  replace(/\n/g, '\\n').
  replace(/\f/g, '\\f').
  replace(/\r/g, '\\r').
  replace(/'/g, '\\\'').
  replace(/"/g, '\\"');
}

var searchCliTermoAnt, searchCliFiltroAnt = '';
var searchingCli = false;
function atendimentoSearchCli(){
  if(!searchingCli){
    var pesq = true;
    if($("#filtro").val() == 1 && !isInt($("#pesquisa").val()) ){ pesq = false;  }
    if($("#filtro").val() > 1 &&  $("#pesquisa").val().length < 2){ pesq = false; }
    if($("#pesquisa").val() != '' && ( searchCliTermoAnt != $("#pesquisa").val() || searchCliFiltroAnt != $("#filtro").val() ) && pesq ){
      searchCliTermoAnt = $("#pesquisa").val();
      searchCliFiltroAnt = $("#filtro").val();
      localStorage.setItem("filtro_pesq_atend", $("#filtro").val());
      searchingCli = true;
      loadingInput(1, 'pesquisa');
      $.ajax({
        url:"ajax_atendimentoSearchClie.php",
        type:"post",
        timeout: 20000,
        assync : false,
        data: { termo : $("#pesquisa").val(), filtro : $("#filtro").val(), },
        success: function (result){
          loadingInput(2, 'pesquisa');
          var openContacts = getURLparameter("openContacts") ? true : false;
          var compURL = '?pesquisa=' + $("#pesquisa").val() + '&filtro=' + $("#filtro").val();
          window.history.replaceState({}, document.title, document.URL.split('?')[0]  + compURL );
          var html = '';
          var resultados = JSON.parse(result);
          var compTh = '';
          switch($("#filtro").val()){
            case '5':
            compTh = '<th>E-MAIL</th>';
            break;
            case '6':
            compTh = '<th>FONE1</th>';
            break
            case '7':
            compTh = '<th>FONE2</th>';
            break;
            case '8':
            compTh = '<th>FONE3</th>';
            break;
            default:
            compTh = '';
            break;
          }


          html += "<table class='table table-striped' style='border-top:1px solid #ddd'><tr><th>COD</th><th>RAZÃO</th><th>FANTASIA / LOJA</th><th>CLASSE / CIDADE</th><th>CNPJ</th>"+compTh+"<th>DETALHES</th> <th>AÇÃO</th></tr>";
          $.each(resultados, function(key, resultado) {

            if(openContacts && resultado.ID_CLIENTE == getURLparameter('pesquisa')){
              window.open('atendimento_cadastro_suporte.php?cli=' + resultado.CLI ,'_self');
            }

            if(resultado.NOME_RAZAO){
              var clieNovo = false;
              var desatualizado = false;
              if(resultado.DATA_CADASTRO){

                var data_cadastro_parts1 = resultado.DATA_CADASTRO.split("/");
                var data_cadastro_str = data_cadastro_parts1[2]+'-'+data_cadastro_parts1[1]+'-'+data_cadastro_parts1[0];
                var data_cadastro = new Date( data_cadastro_str );

                //30 dias limite
                var data_limite_clieNovo = new Date( Date.now() - (30 * 24 * 60 * 60 * 1000) );

                if( data_cadastro >= data_limite_clieNovo ){
                  clieNovo = true;
                } else {
                  clieNovo = false;
                }

                try {

                  var data_release_parts1 = resultado.ULT_REG_RELEASE.split(".");
                  var data_release_str = data_release_parts1[2]+'-'+data_release_parts1[1]+'-'+data_release_parts1[0];
                  var data_release = new Date( data_release_str );

                  //30 dias limite
                  var data_limite_Versao = new Date( Date.now() - (45 * 24 * 60 * 60 * 1000) );

                  if(data_release <= data_limite_Versao ){
                    desatualizado = true;
                  } else {
                    desatualizado = false;
                  }

                } catch(e){

                }

              }
              var vend_repr_func, vend_repr_icon, linkNovaOS = '';
              if( ( resultado.TIPO_REPR == 'S' || resultado.TIPO_VEND == 'S' || resultado.CONTRATO_TIPO == 4 ) && resultado.TIPO_FUNC != 'S' && resultado.ID_CLIENTE != 237 )
              {
                vend_repr_func = ' onclick="atendConfirmaVend_Repr('+resultado.POS+')" ';
                vend_repr_icon = " <i title='Re-locadora responsável pelo suporte' class='glyphicon glyphicon-user btn-warning' style='padding:5px;border-radius:15px;'></i>&nbsp;&nbsp;";
                linkNovaOS = "ondblclick='javascript: if(confirm(&#39;Re-locadora responsável pelo suporte. Deseja continuar ?&#39;)){ window.open(&#39;atendimento_registrar.php?cli="+resultado.CLI+"&#39; , &#39;_self&#39;); }'";
              } else {
                if(resultado.CANC_SN == 'S'){
                  vend_repr_func = " data-toggle='dropdown' ";
                  vend_repr_icon = " ";
                  linkNovaOS = "ondblclick='javascript: if(confirm(&#39;Cliente cancelado. Deseja continuar ?&#39;)){ window.open(&#39;atendimento_registrar.php?cli="+resultado.CLI+"&#39; , &#39;_self&#39;); }'";
                } else if(resultado.SITUACAO == 'B'){
                  vend_repr_func = " data-toggle='dropdown' ";
                  vend_repr_icon = " ";
                  linkNovaOS = "ondblclick='javascript: if(confirm(&#39;Cliente bloqueado. Deseja continuar ?&#39;)){ window.open(&#39;atendimento_registrar.php?cli="+resultado.CLI+"&#39; , &#39;_self&#39;); }'";
                }  else {
                  vend_repr_func = " data-toggle='dropdown' ";
                  vend_repr_icon = '';
                  linkNovaOS = "ondblclick='javascript:carregando(1); window.open(&#39;atendimento_registrar.php?cli="+resultado.CLI+"&#39; , &#39;_self&#39;)'";
                }
              }


              var tipos_historicos = resultado.TIPOS_HISTORICOS.split(',');
              var bgC, rOBS;

              if(resultado.CANC_SN == 'S'){
                bgC = 'style="background-color:#DF7971;color:#FFF"';
                rOBS = '<b style="color:#FFE793;">  -   CANCELADO</b>( Dt Hist:'+resultado.DATA_CANCELAMENTO_HISTORICO+', Dt Campo:'+resultado.DATA_CANCELAMENTO_CAMPO+', Anos:'+resultado.ANOS_DE_CANCELAMENTO+')' + ( resultado.ANOS_DE_CANCELAMENTO >= 5 ? '<label class="btn btn-warning blink" style="font-size:9px;;display:inline;"><i class="glyphicon glyphicon-time"></i>&nbsp;&nbsp;ANOS '+resultado.ANOS_DE_CANCELAMENTO+'</label>' : '' );
              } else if(resultado.SITUACAO == 'B'){
                bgC = 'style="background-color:#DF7971;color:#FFF"';
                rOBS = '<b style="color:#FFE793;">  -   BLOQUEADO</b>';
              } else if(tipos_historicos.includes('12') && ( resultado.ULT_TIPO_HISTORICO == "12" || resultado.ULT_TIPO_HISTORICO == "13" )){
                bgC = 'style="background-color:#DF7971;color:#FFF"';
                rOBS = '<b style="background:#777;color:#fff;padding:5px;border-radius:15px;margin-left:10px">EM TRAMITE DE CANCELAMENTO</b>';
              } else {
                bgC = '';
                rOBS = '';
              }

              if(tipos_historicos.includes('10') && !tipos_historicos.includes('11')){
                bgC += 'style="background-color:#DF7971;color:#FFF"';
                rOBS += '&nbsp;&nbsp;<label title="Cliente em tramite de congelamento" class="btn btn-secondary" style="font-size:9px;;display:inline;">TRAMITE DE CONGELAMENTO</label>';
              }

              if(clieNovo && resultado.SITUACAO != 'B'){
                bgC = 'style="background-color:#FFE793;color:#333"';
                rOBS += '&nbsp;&nbsp;<label title="Cadastrado em '+resultado.DATA_CADASTRO+'" class="btn btn-warning" style="font-size:9px;;display:inline;">NOVO</label>';
              }
              if(desatualizado && resultado.SITUACAO != 'B'){
                rOBS += '&nbsp;&nbsp;<label title="Última versão '+resultado.ULT_REG_RELEASE+'" class="btn btn-danger blink" style="font-size:9px;;display:inline;"><i class="glyphicon glyphicon-time"></i>&nbsp;&nbsp;DESATUALIZADO</label>';
              }

              //Adicionando a prioridade de atendimento do cliente na busca
              rOBS += resultado.BADGE_PRIORIDADE_ATEND;


              var compTd = '';
              switch($("#filtro").val()){
                case '5':
                compTd = "<td title='"+resultado.EMAIL+"'>"+resultado.EMAIL.substr(0,30)+"</td>";
                break;
                case '6':
                compTd = "<td>"+resultado.FONE1+"</td>";
                break;
                case '7':
                compTd = "<td>"+resultado.FONE2+"</td>";
                break;
                case '8':
                compTd = "<td>"+resultado.FONE3+"</td>";
                break;
                default:
                compTd = '';
                break;
              }
              //  <div class="container"><div class="row"><div class="col-sm">1</div><div class="col-sm">2</div></div></div>
              html += "<tr "+bgC+" id='tr_"+resultado.POS+"' "+linkNovaOS+">";
              html += "<td>"+resultado.ID_CLIENTE+"</td>";
              html += "<td>"+resultado.NOME_RAZAO + vend_repr_icon + rOBS  +"</td>";
              html += "<td>"+resultado.FANTASIA+"<br>LOJA "+resultado.LOJA+"</td>";
              html += "<td>"+resultado.NOME_CLASSE+"<br>"+resultado.CIDADE+"</td>";
              html += "<td>"+resultado.CNPJ_CPF+"</td>";
              html += compTd;
              html += "<td><input type='button' class='btn btn-normal'  value='Detalhes' onclick='atendDetalhesCli("+resultado.POS+")'></td>";
              html += "<input type='hidden' id='dtl_"+resultado.POS+"' value='"+btoa(JSON.stringify(resultados[key]))+"'>";
              html += "<td><div class='btn-group'> <button type='button' class='btn'>Ação</button><button type='button' class='btn dropdown-toggle' "+vend_repr_func+" id='btnDpd_"+resultado.POS+"'><span class='caret'></span></button></button>";
              html += "<ul class='dropdown-menu pull-right' role='menu'>";
              //  html += "<li><a href='atendimento_maquinas.php?cli="+resultado.CLI+"'>Máquinas</a></li>";
              html += "<li><a href='atendimento_maquinas_detalhes.php?cli="+resultado.CLI+"'>Máquinas Detalhes</a></li>";
              html += "<li><a href='atendimento_cadastro_suporte.php?cli="+resultado.CLI+"'>Cadastro de suporte</a></li>";
              html += "<li><a href='atendimento_lista_espera.php?cli="+resultado.CLI+"'>Últimas Listas de espera</a></li>";
              html += "<li><a href='atendimento_lista_os.php?cli="+resultado.CLI+"'>Lista de OS's</a></li>";
              html += "<li><a href='atendimento_nova_espera.php?cli="+resultado.CLI+"'>Gerar lista de espera</a></li>";
              if(resultado.CR){
                html += "<li><a href='atendimento_contas_receber.php?cli="+resultado.CLI+"'>Contas a receber</a></li>";
              }
              if(resultado.CARTEIRA_CLIENTES){
                html += "<li><a href='atendimento_carteira_clientes.php?cli="+resultado.CLI+"'>Carteira de clientes</a></li>";
              }
              html += "<li><a data-toggle='modal' data-target='#modal_upload_foto' href='javascript:void(0)' onclick='formUploadFoto(0,\""+resultado.ID_CLIENTE+"\",null)'>Anexar foto para este cliente</a></li>";
              html += "<li><a href='bancoArquivos_anexos.php?cli="+resultado.CLI+"'>Arquivos do cliente</a></li>";
              html += "<li><a href='atendimento_registrar.php?cli="+resultado.CLI+"'>Registrar atividade</a></li>";
              html += "</ul></div></td></tr>";
            }
          });
          html += "</table>";
          $("#listaSearchContent").html(html);
          searchingCli = false;
        }, error: function(result) {
          loadingInput(2, 'pesquisa');
          swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
          searchingCli = false;
        }, complete: function(result){
          searchingCli = false;
        }
      });
    }
  } else {
    window.setTimeout(atendimentoSearchCli,750);
  }
}

// dialog-extend options
var dialogExtendOptions = {
  "closable" : false,
  "maximizable" : false,
  "minimizable" : true,
  "minimizeLocation" : 'left',
  "collapsable" : false,
  "dblclick" : 'minimize',
  "titlebar" : 'transparent',
  "restore" : function(){
    $("#sendie").focus();
  }
};
$("#my-form [name=event]").each(function(){
  if ( $(this).is(":checked") ) {
    dialogExtendOptions[$(this).attr("rel")] = function(evt, a,b,c) {
      $(evt.target).prepend(evt.type+"@"+evt.timeStamp+"<br />");
    };
  }
});

var lastDialogExt = null;
function openDialogExt(title, html){
  //dialog options
  var dialogOptions = {
    "title" : title + "  ",
    "width" : 595,
    "height" : 600,
    "modal" : false,
    "resizable" : false,
    "draggable" : true,
    "close" : function(){
      $(this).remove();
    },
    "open" : function(){
      $(this).attr('id', 'dialog_chat');
    }

  };
  // dialog-extend options
  var dialogExtendOptions = {
    "closable" : false,
    "maximizable" : false,
    "minimizable" : true,
    "minimizeLocation" : 'left',
    "collapsable" : false,
    "dblclick" : 'minimize',
    "titlebar" : 'transparent',
    "restore" : function(){
      $("#sendie").focus();
    }
  };
  $("#my-form [name=event]").each(function(){
    if ( $(this).is(":checked") ) {
      dialogExtendOptions[$(this).attr("rel")] = function(evt, a,b,c) {
        $(evt.target).prepend(evt.type+"@"+evt.timeStamp+"<br />");
      };
    }
  });
  // open dialog
  lastDialogExt = $("<div />").dialog(dialogOptions).dialogExtend(dialogExtendOptions).html(html);
}

function equipamentosAnexarFoto(){

  var formData = new FormData($("#MODALADDEQUIP_UPLOADFOTO_FORM")[0]);
  var pos = 0;
  var error = null;
  var ID_EQUIP = $("#MODALADDEQUIP_UPLOADFOTO_EI").val();
  if(!ID_EQUIP){ error = "Erro ao obter o ID do equipamento."; }
  if(error == null){
    formData.append('ID_EQUIP', ID_EQUIP);
    formData.append('arqUpload', $('#MODALADDEQUIP_UPLOADFOTO_ARQUIVO')[0].files[0]);
    carregando(1);
    $.ajax({
      url:"ajax_equipamentoFotoUpload.php",
      type:"post",
      timeout:210000,
      data: formData,
      cache : false,
      contentType: false,
      processData: false,
      success: function (result){
        var resultado = null;
        try {
          resultado = JSON.parse(result);
          if(resultado.status == 1){
            carregando(2);
            swal("Sucesso", resultado.mensagem, "success").then();
          } else {
            carregando(2);
            swal("Ops..", resultado.mensagem, "warning");
          }
        } catch(err){
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+err, "warning");
        }
      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      }

    });
  } else {
    swal("Atenção", error, "warning");
  }

}

function imprimeMSGPag(titulo, msg, tipo){
  return '<div class="alert alert-'+tipo+'"><button type="button" class="close" data-dismiss="alert">&times;</button><h4>'+titulo+'</h4>'+msg+'</div>';
}

function selecionaCliente_FoneHelpAtend(idCliente){
  // Select the dropdown (select) element
  const selectElement = document.getElementById('modalPesquisaClienteFiltroConteudo');
  selectElement.value = idCliente;
  const event = new Event('keyup');
  selectElement.dispatchEvent(event);
  $('#MODAL_helpContato').modal('hide');
}

function pesq_FoneHelpAtend(){
  var conteudo = $("#conteudo_FoneHelpAtend").val();
  if(conteudo){
    carregando(1);
    $.ajax({
      url:"ajax_FoneHelpAtend_Pesquisa.php",
      type:"post",
      dataType:"json",
      data: {
        conteudo : conteudo,
      },
      success: function (result){
        if(result.status == 1){
          var html = '<table class="table table-strioed"><tr><th>CLIENTE</th><th>RAZÃO</th><th>NOME</th><th>TIPO CONTATO</th><th>CONTATO</th></tr>';
          $.each(result.mensagem, function(key,value){
            html += '<tr ondblclick="javascript:selecionaCliente_FoneHelpAtend(\''+value.ID_CLIENTE+'\');">';
            html += '<td>'+value.ID_CLIENTE+'</td>';
            html += '<td>'+value.NOME_RAZAO+'</td>';
            html += '<td>'+value.NOME+'</td>';
            html += '<td>'+value.TIPO_DESC+'</td>';
            html += '<td style="min-width:150px">'+value.CONTATO+'</td>';
            html += '</tr>';
          });
          html += '</table>';
          $("#FoneHelpAtend_content").html(html);
        } else {
          aviso(result.mensagem,2);
        }
      },
      error: function(result) {
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      },
      complete: function(result){
        carregando(2);
      }
    });
  } else {
    aviso('Informe o contato e clique em Pesquisar',2);
  }
}

function open_FoneHelpAtend(){
  var html = '<table class="table table-bordered"></tr><th>Contato</th><th></th></tr><tr><td><input type="text" id="conteudo_FoneHelpAtend" onkeypress="javascript: if(event.which == 13){ pesq_FoneHelpAtend(); }"  class="form-control"></td><td width="120px"><button type="button" class="btn btn-success" onclick="pesq_FoneHelpAtend()"><i class="icon-search"></i>Pesquisar</button></td></tr></table>';
  html += '<div id="FoneHelpAtend_content">';
  html += imprimeMSGPag('Atenção','Informe o contato e clique em Pesquisar','warning');
  html += '</div>';
  html += '<br>';
  criaModal('MODAL_helpContato','Pesquisa de contatos');
  $("#MODAL_helpContato_content").html(html);
  $("#MODAL_helpContato").modal('show');
  $("#conteudo_FoneHelpAtend").focus();
}

function equipamentoRemoverFoto(ID_MVTO,ID_SEQ,HASH){
  if(ID_MVTO && ID_SEQ && HASH){
    swal({
      title: "Você tem certeza?",
      text: "Não será possível reverter estas alterações.",
      icon: "warning",
      buttons: ["Não", "Sim"],
      dangerMode: true,
    }).then(function(podeSalvar){
      if (podeSalvar) {
        carregando(1);
        $.ajax({
          url:"ajax_equipamentoRemoverFoto.php",
          type:"post",
          data: {
            ID_MVTO : ID_MVTO,
            ID_SEQ : ID_SEQ,
            HASH : HASH,
          },
          success: function (result){
            var resultado = null;
            try {
              resultado = JSON.parse(result);
              if(resultado.status == 1){
                carregando(2);
                swal("Sucesso", resultado.mensagem, "success").then(
                  function(podeSalvar){
                    if (podeSalvar) {
                      equipamentosListaAnexos(ID_MVTO);
                    }
                  }
                );

              } else {
                carregando(2);
                swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
              }

            } catch(err){
              carregando(2);
              swal("Ops..", "Erro na solicitação\n"+err, "warning");
            }
          }, error: function(result) {
            carregando(2);
            swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
          }

        });
      }
    });
  }
}

