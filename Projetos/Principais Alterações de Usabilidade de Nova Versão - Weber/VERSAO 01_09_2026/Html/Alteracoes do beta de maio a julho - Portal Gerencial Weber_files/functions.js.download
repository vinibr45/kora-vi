                function testaConexaoExternaClie(cod,loja){
                  const divResponse = $('#modal_cad_suporte_teste_conexao_externa_content');
                  const modal = $('#modal_cad_suporte_teste_conexao_externa');
                  const ip = $('#vpn_ip').val();
                  const porta = $('#porta2').val();
                  divResponse.html('<h6>Aguarde testando conexão com '+ip+':'+porta+'</h6><hr>' + setaLoadingModal());
                  modal.modal('show');
                  $.ajax({
                    url: "ajax_testaConexaoExternaClie.php",
                    type: "post",
                    timeout: 10000,
                    data: {
                      cod : cod,
                      loja : loja,
                      ip : ip,
                      porta : porta
                    },
                    success: function (result){
                      divResponse.html(result);
                    },
                    error: function(result) {
                      modal.modal('hide');
                      carregando(2);
                      swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
                    }
                  });
                }

                function atendimento_AnexarPonto(func){
                  window.open('atendimento_anexos_pontoEletronico.php?func='+func, '_self');
                }


                function AWSconfirmExclusion(object_key){
                  if(object_key){
                    var resp = prompt('Se deseja realmente remover este anexo escreva a palavra REMOVER abaixo', '');
                    if (resp == 'REMOVER') {
                      removerArquivoAWS(object_key);
                    } else {
                      alert('Cancelado');
                    }
                  }
                }

                function removerArquivoAWS(object_key) {
                  carregando(1);
                  $.ajax({
                    url:"ajax_AWSdocumentRemove.php",
                    async: false,
                    type:"post",
                    data: { object_key : object_key },
                    dataType:"json",
                    success:function(data) {
                      if(data.status == 1){
                        aviso('Arquivo removido com sucesso.', 1);
                        location.reload();
                      } else {
                        aviso(data.mensagem,3);
                      }
                    },
                    complete:function(data){
                      carregando(2);
                    },
                    error:function(data){
                      aviso("Verifique sua conexão com internet.\n" + data.statusText, 3);
                    }
                  });
                }



                function PONTOE_DIA_setaConferida(ID_FUNC, ID_DATA, ID_LOJA){
                  var modalID = 'modalPontoDiaConferido';
                  var CHECKED = $('#'+modalID+ " #PONTOE_DIA_CONFERIDA").prop('checked');
                  $.ajax({
                    url:"ajax_atendimentoPONTOE_conferenciaDiaHE_set.php",
                    async: false,
                    type:"post",
                    data: {
                      ID_DATA : ID_DATA,
                      ID_FUNC : ID_FUNC,
                      ID_LOJA : ID_LOJA,
                      OBS : $('#'+modalID+ " #PONTOE_DIA_CONF_OBS").val(),
                      AUT_HE : $('#'+modalID+ " #PONTOE_DIA_CONF_AUT_HE").val(),
                      CHECKED : CHECKED
                    },
                    dataType:"json",
                    beforeSend: function(){
                      carregando(1);
                    },
                    success:function(data) {
                      if(data.status == 1){
                        $("#"+modalID).modal('hide');
                        $("#ckb_DiaPontoChecked_" + ID_DATA.replace(/\D/g, "")).prop('checked', CHECKED);
                        $("#obs_DiaPonto_" + ID_DATA.replace(/\D/g, "")).html('Aut HE: ' + data.aut_he + '<br>' + data.obs );
                        avisoDown("Alterado com sucesso.");
                      } else {
                        aviso(data.mensagem,3);
                      }
                    },
                    complete:function(data){
                      carregando(2);
                    },
                    error:function(data){
                      aviso("Verifique sua conexão com internet.\n" + data.statusText, 3);
                    }
                  });
                }

                function PONTOE_DIA_modalConferido(elm, ID_FUNC, ID_DATA, ID_LOJA){
                  $(elm).prop('checked', !$(elm).prop('checked'));
                  var modalID = 'modalPontoDiaConferido';
                  $("#"+modalID).modal('hide');
                  $('#'+modalID + " #btnSalvarDiaConferidoPonto").removeAttr('onclick');
                  $.ajax({
                    url:"ajax_atendimentoPONTOE_conferenciaDiaHE_get.php",
                    async: false,
                    type:"post",
                    data: {
                      ID_DATA : ID_DATA,
                      ID_FUNC : ID_FUNC,
                      ID_LOJA : ID_LOJA,
                    },
                    dataType:"json",
                    beforeSend: function(){
                      carregando(1);
                    },
                    success:function(result) {
                      if(result.status == 1){

                        $('#'+modalID+ " #PONTOE_DIA_CONF_OBS").val(''),
                        $('#'+modalID+ " #PONTOE_DIA_CONF_AUT_HE").val(''),
                        $('#'+modalID+ " #PONTOE_DIA_CONFERIDA").prop('checked', false);
                        $('#'+modalID+ " #PONTOE_DIA_DETALHES").html('');

                        //Registro existente
                        if(result.mensagem[0].ID_DATA){

                          $('#'+modalID+ " #PONTOE_DIA_CONF_OBS").val(result.mensagem[0].OBS),
                          $('#'+modalID+ " #PONTOE_DIA_CONF_AUT_HE").val(result.mensagem[0].AUT_HE),
                          $('#'+modalID+ " #PONTOE_DIA_CONFERIDA").prop('checked', result.mensagem[0].CONFERIDA == 'S' ? true : false);

                          var detalhes = '<hr>' +
                          'Criado por ' + result.mensagem[0].USUA_INCLUSAO + ' em ' + result.mensagem[0].DTHR_INCLUSAO + '<br>' +
                          'Alterado última vez por ' + result.mensagem[0].USUA_ALTERACAO + ' em ' + result.mensagem[0].DTHR_ALTERACAO;

                          $('#'+modalID+ " #PONTOE_DIA_DETALHES").html(detalhes);

                        }

                        $('#'+modalID + " #btnSalvarDiaConferidoPonto").attr('onclick', 'PONTOE_DIA_setaConferida(\''+ID_FUNC+'\', \''+ID_DATA+'\', \''+ID_LOJA+'\')');
                        $("#"+modalID).modal('show');

                      } else {
                        $("#"+modalID).modal('hide');
                        aviso(result.mensagem,3);
                      }
                    },
                    complete:function(data){
                      carregando(2);
                    },
                    error:function(data){
                      $("#"+modalID).modal('hide');
                      aviso("Verifique sua conexão com internet.\n" + data.statusText, 3);
                    }
                  });


                }

                function atendimento_ListaHolding(HOLDING_COD, HOLDING_NOME){
                  if(HOLDING_COD > 0){
                    criaModal('ModalAtend_ListHolding', 'Lista de clientes no Holding: ' + HOLDING_NOME);
                    $("#ModalAtend_ListHolding_content").html(setaLoadingModal());
                    $("#ModalAtend_ListHolding").modal('show');
                    var html = '';
                    $.ajax({
                      url: "ajax_atendimentoListaClientesHolding.php",
                      type: "post",
                      dataType: "json",
                      data: {  HOLDING_COD : HOLDING_COD },
                      success: function (result){
                        if(result.status == 1){
                          html = '<table class="table table-bordered"><tr><th>COD. CLIENTE</th><th>RAZÃO SOCIAL</th><th>FANTASIA</th><th>CNPJ/CPF</th></tr>';
                          $.each(result.mensagem,function(key, value){
                            html += '<tr><td>'+value.ID_CLIENTE+'</td><td>'+value.NOME_RAZAO+'</td><td>'+value.FANTASIA+'</td><td>'+value.CNPJ_CPF+'</td></tr>';
                          });
                          html += '</table>';
                          html += '<br><br>';
                        } else {
                          swal("Ops..", result.mensagem, "warning");
                        }
                      }, error: function(result) {
                        swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
                      }, complete:function(result){
                        $("#ModalAtend_ListHolding_content").html(html);
                      }
                    });
                  } else {
                    aviso("Erro ao obter ID do Holding",2);
                  }
                }

