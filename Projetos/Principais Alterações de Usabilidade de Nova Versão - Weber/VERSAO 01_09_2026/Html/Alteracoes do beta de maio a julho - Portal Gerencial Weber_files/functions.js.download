function enviaSMS(){
  var TELEFONE = $('#envioSMS_celular').val();
  var MENSAGEM = $('#envioSMS_mensagem').val();
  if(TELEFONE && MENSAGEM){
    carregando(1);
    $.ajax({
      url:"ajax_enviaSMS.php",
      type:"post",
      dataType:"json",
      data: {
        TELEFONE : TELEFONE,
        MENSAGEM : MENSAGEM
      },
      success: function (result){
        if(result.status == 1){
          carregando(2);
          aviso(result.mensagem,1);
          $("#envioSMS_celular").val('');
          $("#envioSMS_mensagem").val('');
        } else {
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+result.mensagem, "warning");
        }
      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      }
    });
  }
}

