function equipamentosEditarEquip(EQUIP){

  if(EQUIP){
    carregando(1);
    $.ajax({
      url:"ajax_equipamentoDetalhesEdit.php",
      type:"post",
      data: { EQUIP : EQUIP },
      success: function (result){

        var resultado = null;
        try {
          resultado = JSON.parse(result);
          if(resultado.status == 1){
            $("#MODALADDEQUIP_EDIT").val(resultado.edit);
            $("#MODALADDEQUIP_TIPO").val(resultado.tipo);
            $("#MODALADDEQUIP_TECNICO_RESP").val(resultado.tecnico_resp);
            $("#MODALADDEQUIP_DTMVTO").val(resultado.dtmvto);
            $("#MODALADDEQUIP_STATUS").val(resultado.status_equip);
            $("#MODALADDEQUIP_DTPRAZO").val(resultado.dtprazo);
            $("#MODALADDEQUIP_HISTORICO").val(resultado.historico);
            $("#MODALADDEQUIP_COD_CLIE").val(resultado.cod_cliente);
            $("#MODALADDEQUIP_NOME_EQUIP").val(resultado.nome_equip);
            $("#MODALADDEQUIP_MODELO_EQUIP").val(resultado.modelo_equip);
            $("#MODALADDEQUIP_FABRICANTE_EQUIP").val(resultado.fabric_equip);
            $("#MODALADDEQUIP_SERIE_EQUIP").val(resultado.serie_equip);
            $("#MODALADDEQUIP_VALOR_EQUIP").val(resultado.valor_equip);
            formataDinheiro();
            $("#MODALADDEQUIP_ADD_MODAL").modal('show');
            carregando(2);
          } else {
            carregando(2);
            swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
          }
        } catch(err){
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+err, "warning");
        }
      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      }
    });
  }

}

