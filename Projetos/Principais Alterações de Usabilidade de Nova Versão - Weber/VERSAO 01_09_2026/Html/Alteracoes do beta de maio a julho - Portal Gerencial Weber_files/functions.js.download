                      },
                      success: function (result){
                        if(result.status == 1){
                          carregando(2);
                          swal("Sucesso", result.mensagem, "success");
                          funcionarioListaPermissoes();
                        } else {
                          carregando(2);
                          swal("Ops..", "Erro na solicitação\n"+result.mensagem, "warning");
                        }
