function obtemHoras(minutes) {
  var h = Math.floor(minutes / 60);
  var m = minutes % 60;
  h = h < 10 ? '0' + h : h;
  m = m < 10 ? '0' + m : m;
  return h + ':' + m;
}

function transfereInputValue(origem,destino){
  $("#"+destino).val($("#"+origem).val());
}

function atendimento_PontoMVTOprocessaHORAE(D,C){
  if(D && C){
    carregando(1);
    $.ajax({
      url: "ajax_atendimentoPONTOE_processaHoraE.php",
      type: "post",
      dataType: "json",
      data: { D : D, C : C },
      success: function (result){
        if(result.status == 1){
          if(result.data.DIA_SEMANA){
            if(result.data.TOT_APURADO > result.data.TOT_JORNADA || result.data.HORA_S_AVISO > 0){
              var diff_ = ( ( result.data.TOT_APURADO - result.data.TOT_JORNADA ) - ( result.data.TOT_S_AVISO - result.data.TOT_S_AVISO_TRABALHADO ) ) ;
              var limiteMin_ = 30;
              if(diff_ > limiteMin_){
                //  aviso('Possui mais de '+limiteMin_+' minutos de extra.\n\n Verifique as autorizações.',2);
              }
              $("#horae_edit_hora_50").val( obtemHoras(diff_) );

              if(result.data.FERIADO == true){

                aviso("Este dia foi feriado. Confira os dados",2);

                $("#horae_edit_hora_50").val( obtemHoras(0) );
                $("#horae_edit_hora_100").val( obtemHoras(diff_) );

              } else {

                //experimento
                switch(result.data.DIA_SEMANA){

                  case 'SAB':
                  var tot50 = 0;
                  var tot80 = 0;
                  $.each(result.data.INTERVALOS, function(key,value){
                    for( i=value.MINI+1; i<=value.MINF; i++ ){
                      if( i <= 720 ){
                        tot50 += 1;
                      } else {
                        tot80 += 1;
                      }
                    }
                  });
                  $("#horae_edit_hora_50").val( obtemHoras(tot50) );
                  $("#horae_edit_hora_80").val( obtemHoras(tot80) );
                  break;

                  case 'DOM':
                  alert('Em desenvolvimento, revise.');
                  $("#horae_edit_hora_50").val( obtemHoras(0) );
                  $("#horae_edit_hora_100").val( obtemHoras(diff_) );
                  break;

                }

              }

            } else {
              aviso("Este dia não teve horas extras.",2);
            }
          }
          carregando(2);
        } else {
          carregando(2);
          swal("Ops..", result.mensagem, "warning");
        }
      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação \n"+result.responseText, "error");
      }
    });
  } else {
    aviso("Erro ao obter referências JS",2);
  }
}

function atendimento_PontoMVTOremover(D){
  if(D){
    swal({
      title: "Você tem certeza?",
      text: "Não será possível reverter estas alterações.",
      icon: "warning",
      buttons: ["Não", "Sim"],
      dangerMode: true,
    }).then(function(podeSalvar){
      if (podeSalvar) {
        carregando(1);
        $.ajax({
          url: "ajax_atendimentoPONTOE_remove.php",
          type: "post",
          dataType: "json",
          data: { D : D },
          success: function (result){
            if(result.status == 1){
              avisoDown(result.mensagem);
              location.reload();
              carregando(2);
            } else {
              carregando(2);
              swal("Ops..", result.mensagem, "warning");
            }
          }, error: function(result) {
            carregando(2);
            swal("Ops..", "Erro na solicitação \n"+result.responseText, "error");
          }
        });
      }
    });
  }
}

