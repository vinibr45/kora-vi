              $("#modal_listaAnexosDocsDetalhes_content").html(doc);
              $("#modal_listaAnexosDocsDetalhes").modal('show');
            }
            carregando(2);
          } else {
            carregando(2);
            swal("Ops..", resultado.mensagem, "warning");
          }
        } catch(err){
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+err, "warning");
        }
      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      }

    });
  }

}

function validaHora(inputStr) {
  if (!inputStr || inputStr.length<1) {return false;}
  var time = inputStr.split(':');
  return time.length === 2
  && parseInt(time[0],10)>=0
  && parseInt(time[0],10)<=23
  && parseInt(time[1],10)>=0
  && parseInt(time[1],10)<=59;
}

function valida_form_os (){

  if(document.getElementById("hr_final_os").value.length == 0){

    var date = new Date;
    var minutes = date.getMinutes();
    var hour = date.getHours();

    //var hora_final = ("00" + date.getHours()).slice(-2) + ':' + ("00" + date.getMinutes()).slice(-2);
    var hora_final = getTimeServer().time.split(" ")[1].slice(0,5);
    document.getElementById("hr_final_os").value = hora_final;

  }



  var tipo = document.getElementById("tipo_atend").value;
  if(document.getElementById("descricao").value == ''){
    alert('Por favor, informe uma descrição');
    document.getElementById("descricao").focus();
    carregando(2);
    return false;
  }
  if(document.getElementById("hr_inicio_os").value.length != 5 || !validaHora(document.getElementById("hr_inicio_os").value) ){
    alert('Por favor, informe um horario inicio');
    document.getElementById("hr_inicio_os").focus();
    carregando(2);
    return false;
  }
  if(document.getElementById("hr_final_os").value.length > 0){
    if(document.getElementById("hr_final_os").value.length != 5){
      alert('Por favor, informe um horario final correto');
      document.getElementById("hr_final_os").focus();
      carregando(2);
      return false;
    }
  } else {
    alert('Por favor, informe um horario final correto');
    document.getElementById("hr_final_os").focus();
    carregando(2);
    return false;
  }
  if(document.getElementById("data_os").value.length != 10){
    alert('Por favor, informe uma data');
    document.getElementById("data_os").focus();
    carregando(2);
    return false;
  }
  var hora_inicio = document.getElementById("hr_inicio_os").value;
  var hora_final = document.getElementById("hr_final_os").value;
  var min_1 = hora_inicio.split(':');
  var min_2 = hora_final.split(':');
  var hora_inicio = (parseInt(min_1[0])*60)+parseInt(min_1[1]);
  var hora_final = (parseInt(min_2[0])*60)+parseInt(min_2[1]);
  if(hora_final.length > 0){
    if(isNaN(hora_inicio) || isNaN(hora_final)){
      alert("Informe um intervalo de horário válido.");
      carregando(2);
      return false;
    }
  }
  if(hora_final.length > 0){
    if(min_1[0] < 1 || min_1[0] > 23 || min_2[0] < 1 || min_2[0] > 23 || min_1[1] < 0 || min_2[1] < 0 || min_1[1] > 59 || min_2[1] > 59){
      alert("Informe um intervalo de horário válido.");
      carregando(2);
      return false;
    }
  }
  var calc = hora_final - hora_inicio;
  if(calc < 1){
    alert("O atendimento deve ter no minimo 1 minuto.");
    carregando(2);
    return false;
  }
  if(tipo == 1 || tipo == 2){
    if(document.getElementById("placa_os").value.length !== 7){
      alert('Por favor, informe a placa do veiculo com 7 caracteres');
      document.getElementById("placa_os").focus();
      carregando(2);
      return false;
    }
    if(document.getElementById("km_final_os").value < 2){
      alert('Por favor, informe os KM final');
      document.getElementById("km_final_os").focus();
      carregando(2);
      return false;
    }
    if(document.getElementById("km_inicial_os").value < 2){
      alert('Por favor, informe os KM inicial');
      document.getElementById("km_inicial_os").focus();
      carregando(2);
      return false;
    }
    if(document.getElementById("protocolo_os").value < 1){
      alert('Por favor, informe o protocolo');
      document.getElementById("protocolo_os").focus();
      carregando(2);
      return false;
    }
  }

}

function carregaDetalhesListaEspera(pos){

  el_detalhes = 'detalhes_'+pos;
  if(document.getElementById(el_detalhes).length !== 0){


    dt_detalhes = 'dt_servico_'+pos;
    nome_detalhes = 'nome_tecnico_'+pos;
    hr_inicio = 'hr_inicio_'+pos;
    hr_final = 'hr_final_'+pos;
    id_os = 'id_os_'+pos;
    tot_horas = 'tot_horas_'+pos;
    origem =  $("#OSI_"+pos).val();
    uuid = $("#OSUUID_"+pos).val();
    id_enc = $("#OSIDENC_"+pos).val();
    cli = $("#OSC_"+pos).val();
    assuntos = 'assuntos_'+pos;
    if(origem && cli){

      descricao = document.getElementById(el_detalhes).value;
      nome = document.getElementById(nome_detalhes).value;
      data = document.getElementById(dt_detalhes).value;
      hrinicio = document.getElementById(hr_inicio).value;
      hrfinal = document.getElementById(hr_final).value;
      id_os = document.getElementById(id_os).value;
      tot_horas = document.getElementById(tot_horas).value;
      assuntos = atob(document.getElementById(assuntos).value);

      document.getElementById("descricao_os").value = descricao;
      document.getElementById("tecnico_detalhes").value = nome;
      document.getElementById("data_detalhes").value = data;
      document.getElementById("inicio_detalhes").value = hrinicio;
      document.getElementById("final_detalhes").value = hrfinal;
      document.getElementById("id_os_detalhes").value = id_os;
      document.getElementById("tot_horas_detalhes").value = tot_horas;
      document.getElementById("assuntos_detalhes").innerHTML = assuntos;

      var btnAcao = "<a style='margin-right:5px;float:right;' class='btn btn-normal' onclick='imprimeDIVstyled(\"modal_detalhes\")'><i class='glyphicon glyphicon-print'></i>&nbsp;&nbsp;Imprimir esta OS</a><a style='margin-right:5px;float:right;' class='btn btn-normal' target='_blank' href='atendimento_anexos_os.php?id="+id_enc+"&uuid="+uuid+"'><i class='glyphicon glyphicon-file'></i>&nbsp;&nbsp;Listar anexos</a>";

      document.getElementById("botoes").innerHTML = "<input type='button' id='anterior' onclick='carregaDetalhesListaEspera("+(pos-1)+")'  value='Anterior' class='btn btn-success' />&nbsp;<input type='button' onclick='carregaDetalhesListaEspera("+(pos+1)+")' id='proxima'  value='Próxima' class='btn btn-success' />"+btnAcao+"<br><br>";

    }

  }

}

function generateUUID() {
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
    const r = (crypto.getRandomValues(new Uint8Array(1))[0] & 0x0f) | (c === 'x' ? 0 : 0x8);
    return r.toString(16);
  });
}

