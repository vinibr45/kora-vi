  const cli = getURLparameter('cli');
  const serializedData = 'horae_edit_id_data='+ dataYMD +'&horae_edit_hora_50=00%3A00%3A00&horae_edit_hora_80=00%3A00%3A00&horae_edit_hora_100=00%3A00%3A00&horae_edit_hora_noturno=00%3A00%3A00&cli: ' + cli;
  if(cli && tipo && serializedData){
    carregando(1);
    $.ajax({
      url: "ajax_atendimentoPONTOE_salva_horae.php",
      type: "post",
      dataType: "json",
      data: {
        data : serializedData,
        cli : cli,
        tipo : tipo
      },
      success: function (result){
        if(result.status == 1){
          avisoDown(result.mensagem);
          location.reload();
        } else {
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+result.mensagem, "warning");
        }
      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação \n"+result.responseText, "error");
      }
    });
  } else {
    aviso("Erro ao obter dados",2);
  }
}

