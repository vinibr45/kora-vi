$(document).ready(function(){

  $('#toggleButtonSidebarTotal').on('click', function(){

    var barraSidebarBg = document.getElementById('barra_lateral_total_bg');
     var barraSidebarTotal = document.getElementById('barra_lateral_total');
    if (barraSidebarTotal.style.display === 'none' || barraSidebarTotal.style.display === '') {
      barraSidebarTotal.style.display = 'block';
      barraSidebarBg.style.display = 'block';
      $(this).innerHTML = '←';
    } else {
      barraSidebarTotal.style.display = 'none';
      barraSidebarBg.style.display = 'none';
      $(this).innerHTML = '→';
    }
  });

  // Fecha ao clicar fora
  document.addEventListener('click', function (event) {
    var barra = document.getElementById('barra_lateral_total');
    var btn = document.getElementById('toggleButtonSidebarTotal');
    const isClickInsideBarra = barra.contains(event.target);
    const isClickToggleBtn = btn.contains(event.target);

    if (!isClickInsideBarra && !isClickToggleBtn && barra.style.display === 'block') {
        $('#toggleButtonSidebarTotal').click();
    }
  });

});


