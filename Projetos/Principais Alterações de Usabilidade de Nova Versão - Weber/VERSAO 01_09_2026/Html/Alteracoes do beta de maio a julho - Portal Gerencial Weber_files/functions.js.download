                function malaDireta_AddEmailCodClie(){
                  carregando(1);
                  var cod_clie = $("#cod_clie_addEmail").val();
                  var coluna =   $("#coluna_addEmail").val();
                  if( cod_clie > 0 && coluna > 0 ){
                    $.ajax({
                      url: "ajax_malaDiretaBuscaEmail.php",
                      type: "post",
                      dataType: "json",
                      data: {
                        cod_clie : cod_clie,
                        coluna : coluna
                      },
                      success: function (result){
                        if(result.status == 1){
                          if(result.mensagem.length > 0 && result.mensagem[0].CONTATO  != ''){
                            $.each(result.mensagem, function(key,value){
                              $("#email_add").val(value.CONTATO);
                              adiciona_EmailMalaDireta(cod_clie);
                              $("#cod_clie_addEmail").val('');
                            });
                          } else {
                            aviso("Não foi possível localizar nenhum contato deste tipo para o cliente informado.",2);
                          }
                        } else {
                          swal("Ops..", result.mensagem, "warning");
                        }
                      }, error: function(result) {
                        swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
                      }, complete:function(result){
                        carregando(2);
                      }
                    });
                  } else {
                    aviso('Você deve informar o código do cliente.',2);
                  }
                }

                function adiciona_EmailMalaDireta(cliente){
                  var emails = document.getElementById('email_add').value;
                  var emails_array = emails.split(';');
                  var acao = 1;
                  for (index = 0, len = emails_array.length; index < len; ++index) {

                    if(emails_array[index].indexOf('@') !== -1 && emails_array[index].indexOf('.') !== -1){

                      var nova_pos = parseInt(document.getElementById('total_destinos').value)+1;
                      document.getElementById('total_destinos').value = parseInt(document.getElementById('total_destinos').value)+1;

                      $.ajax({
                        url:"ajax_Emails.php",
                        type:"post",
                        data: {
                          email : emails_array[index],
                          acao : acao,
                          pos : nova_pos,
                          cliente : cliente
                        },
                        success: function (result){
                          if(result != false && !result.startsWith("ERRO:") ){
                            $('#lista_destinatarios').append(result);
                          } else {
                            aviso(result,2);
                          }
                        }
                      });
                    }
                  }
                  document.getElementById('email_add').value = '';
                }

