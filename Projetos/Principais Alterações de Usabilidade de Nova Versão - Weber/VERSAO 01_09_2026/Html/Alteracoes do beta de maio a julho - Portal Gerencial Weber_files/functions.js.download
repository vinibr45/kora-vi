            function atendimento_cadastro_suporte_edita_cad(T,C){
              var data = $("#formCadSuporteCadastro").serialize();
              if(T && C && data){
                carregando(1);
                $.ajax({
                  url: "ajax_atendimentoCADSUPORTE_salvarCadastro.php",
                  type: "post",
                  dataType: "json",
                  data: {
                    C : C,
                    T : T,
                    data : data, },
                    success: function (result){
                      if(result.status == 1){
                        avisoDown(result.mensagem);
                        atendimento_cadastro_suporte_dados(C,T);
                      } else {
                        carregando(2);
                        swal("Ops..", result.mensagem, "warning");
                      }
                    }, error: function(result) {
                      carregando(2);
                      swal("Ops..", "Erro na solicitação \n"+result.responseText, "error");
                    }
                  });
                }
              }

