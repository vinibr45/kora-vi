function removeToken(TOKEN_ID){

  if(TOKEN_ID != null){
    swal({
      title: "Você tem certeza?",
      text: "Não será possível reverter estas alterações.",
      icon: "warning",
      buttons: ["Não", "Sim"],
      dangerMode: true
    }).then(function(podeSalvar){
      if (podeSalvar) {
        carregando(1);
        $.ajax({
          url:"ajax_removeTokenCliente.php",
          type:"post",
          data: {
            TOKEN_ID : TOKEN_ID
          },
          success: function (result){
            var resultado = null;
            try {
              resultado = JSON.parse(result);
              if(resultado.status == 1){
                carregando(2);
                swal("Sucesso", "Link removido com sucesso.", "success");
                var urlRedirect = document.URL;
                urlRedirect = urlRedirect.split("?");
                urlRedirect = urlRedirect[0];
                window.open(urlRedirect, '_self');
              } else {
                carregando(2);
                swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
              }
            } catch(err){
              carregando(2);
              swal("Ops..", "Erro na solicitação\n"+err, "warning");
            }
          }, error: function(result) {
            carregando(2);
            swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
          }
        });
      }
    });
  }
}

