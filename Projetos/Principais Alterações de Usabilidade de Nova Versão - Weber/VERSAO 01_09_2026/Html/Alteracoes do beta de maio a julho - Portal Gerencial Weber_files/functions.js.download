                function atendimento_novaOS_inTipoDetalhe(){
                  var in_detalhe = $("#tipo_atend").find(':selected').attr('in_detalhe');
                  var in_detalhe_ARR = in_detalhe.split(',');
                  $("#ATEND_CATEGORIAS option").each(function()
                  {
                    if( in_detalhe_ARR.includes( $(this).val() ) ){
                      $(this).show();
                    } else {
                      $(this).hide();
                    }
                  });
                  if( !document.URL.includes("portal_gerencial/atendimento_edita_os") ){
                    $('#ATEND_CATEGORIAS').selectMultiple('deselect_all');
                  }
                  $('#ATEND_CATEGORIAS').selectMultiple('refresh');
                }

                function treinamentoFormCadastroAvulso(ID_TREINA,EVENTO,DT_CURSO){
                  $("#treinamentoCadastroAvulsoFORM")[0].reset();
                  if(ID_TREINA > 0){
                    $("#treinamentoCadastroAvulsoFORM #cadAv_id_treina").val(ID_TREINA);
                    $("#treinamentoCadastroAvulsoFORM #cadAv_title_treina").val(EVENTO);
                    $("#treinamentoCadastroAvulsoFORM #cadAv_data_treina").val(DT_CURSO);
                    $("#modal_cadastro_avulso").modal('show');
                  } else {
                    aviso("Erro ao obter ID do treinamento.",2);
                  }

                }

                function treinamentoCadastroAvulsoSALVAR(){
                  if($("#treinamentoCadastroAvulsoFORM #cadAv_id_treina").val() > 0){
                    carregando(1);
                    var data = $("#treinamentoCadastroAvulsoFORM").serialize();
                    if (data) {
                      carregando(1);
                      $.ajax({
                        url:"ajax_treinamentoCadastroAvulso.php",
                        type:"post",
                        dataType:"json",
                        data: { data : data },
                        success: function (result){
                          if(result.status == 1){
                            aviso(result.mensagem,1);
                            location.reload();
                          } else {
                            aviso(result.mensagem,2);
                          }
                          carregando(2);
                        }, error: function(result) {
                          carregando(2);
                          swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
                        }
                      });
                    } else {
                      aviso("Erro ao obter dados do formulário",2);
                    }
                  } else {
                    aviso("Erro ao obter ID do treinamento",2);
                  }
                }

                function atendimento_cadastro_suporte_add_contato(C,T){
                  if(C && T ){
                    var error = null;
                    if(error == null){
                      var data = $("#FORM_cadSuporte_add_contato").serialize();
                      if(data){
                        carregando(1);
                        $.ajax({
                          url: "ajax_atendimentoCADSUPORTE_addContato.php",
                          type: "post",
                          dataType: "json",
                          data: {
                            C : C,
                            data : data,
                          },
                          success: function (result){
                            if(result.status == 1){
                              avisoDown(result.mensagem);
                              $("#modal_cad_suporte_contato").modal('hide');
                              atendimento_cadastro_suporte_dados(C,T);
                            } else {
                              carregando(2);
                              swal("Ops..", result.mensagem, "warning");
                            }
                          }, error: function(result) {
                            swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
                          }, complete: function(result) {
                            carregando(2);
                          }
                        });
                      } else {
                        aviso("Não foi possível obter os dados do formulário.",2);
                      }
                    } else {
                      aviso(error,2);
                    }
                  } else {
                    aviso("Erro ao obter referências do registro.",3);
                  }
                }

                function atendimento_cadastro_suporte_del_contato(C,S,T){
                  if(C && S && T ){
                    swal({
                      title: "Você tem certeza?",
                      text: "Não será possível reverter estas alterações.",
                      icon: "warning",
                      buttons: ["Não", "Sim"],
                      dangerMode: false,
                    }).then(function(podeSalvar){
                      if (podeSalvar) {
                        var error = null;
                        if(error == null){
                          carregando(1);
                          $.ajax({
                            url: "ajax_atendimentoCADSUPORTE_delContato.php",
                            type: "post",
                            dataType: "json",
                            data: {
                              C : C,
                              S : S,
                              T : T
                            },
                            success: function (result){
                              if(result.status == 1){
                                avisoDown(result.mensagem);
                                atendimento_cadastro_suporte_dados(C,T);
                              } else {
                                carregando(2);
                                swal("Ops..", result.mensagem, "warning");
                              }
                            }, error: function(result) {
                              swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
                            }, complete: function(result) {
                              carregando(2);
                            }
                          });
                        } else {
                          aviso(error,2);
                        }
                      }
                    });

                  } else {
                    aviso("Erro ao obter referências do registro.",3);
                  }
                }

                function atendimento_ListaContatos(CLI, AF){
                  if(CLI > 0){
                    criaModal('ModalAtend_ListaDeContatos', 'Lista de contatos do cliente ' + CLI);
                    $("#ModalAtend_ListaDeContatos_content").html(setaLoadingModal());
                    $("#ModalAtend_ListaDeContatos").modal('show');
                    var html = '';
                    $.ajax({
                      url: "ajax_atendimentoListaContatosClie.php",
                      type: "post",
                      dataType: "json",
                      data: {  CLI : CLI, AF : AF  },
                      success: function (result){
                        if(result.status == 1){
                          html = '<table class="table table-bordered"><tr><th>TIPO</th><th>CONTATO</th><th>NOME</th></tr>';
                          $.each(result.mensagem,function(key, value){
                            html += '<tr><td>'+value.TIPO_DESC+'</td><td>'+value.CONTATO+'</td><td>'+value.NOME+'</td></tr>';
                          });
                          html += '</table>';
                          html += '<a class="p-2" target="_blank" href="atendimento_cadastro_suporte.php?cli='+result.clie_encryp+'">Gerenciar contatos</a>';
                          html += '<br><br>';
                        } else {
                          swal("Ops..", result.mensagem, "warning");
                        }
                      }, error: function(result) {
                        swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
                      }, complete:function(result){
                        $("#ModalAtend_ListaDeContatos_content").html(html);
                      }
                    });
                  } else {
                    aviso("Erro ao obter ID do cliente",2);
                  }
                }


                function obtemSubTableListaKeyUsers(keyusers, id){
                  var html = '<table class="table table-bordered"><tr><th>Competência</th><th>Observação</th></tr>';
                  $.each(keyusers, function(key,value){
                    if(id == value.ID){
                      html += '<tr>';
                      html += '<td>' + value.COMPETENCIAS + '</td><td>' + value.OBSERVACAO + '</td>';
                      html += '</tr>';
                    }
                  });
                  html += '</table>';
                  return html;
                }

