        carregando(2);

      } else {
        carregando(2);
        swal("Ops..", "Erro na solicitação\n"+result.mensagem, "warning");
      }
    }, error: function(result) {
      carregando(2);
      swal("Ops..", "Erro na solicitação \n"+result.responseText, "error");
    }
  });
}

