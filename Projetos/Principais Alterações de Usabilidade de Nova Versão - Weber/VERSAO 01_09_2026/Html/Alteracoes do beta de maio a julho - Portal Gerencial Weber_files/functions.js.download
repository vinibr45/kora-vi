                html += '<td><input class="form-control" disabled="disabled"  type="checkbox" '+checked_pdo+' >PDO</td>';
                if(value.FUNCAO_PDV == "S"){ checked_pdv = ' checked="checked" '; TOT_FUNCAO_PDV++;  } else {  checked_pdv = '';  }
                html += '<td><input class="form-control" disabled="disabled" type="checkbox" '+checked_pdv+' >ECF</td>';
                if(value.FUNCAO_SERVIDOR == "S"){ checked_servidor = ' checked="checked" '; TOT_FUNCAO_SERVIDOR++;  } else {  checked_servidor = '';  }
                html += '<td><input class="form-control" disabled="disabled"  type="checkbox" '+checked_servidor+' >Servidor</td>';
                if(value.FUNCAO_TEF == "S"){ checked_tef = ' checked="checked" '; TOT_FUNCAO_TEF++;  } else {  checked_tef = '';  }
                html += '<td><input class="form-control" disabled="disabled"  type="checkbox" '+checked_tef+' >TEF</td>';
                html += '</tr></table></td>';
                var formEdicao = '<form id="editMaq_FORM"><table class="table table-bordered"><tr><th>MÁQUINA</th></tr><tr><td><input type="text" class="form-control" id="editMaq_id" name="editMaq_id" value="'+value.ID_MAQUINA+'"></td></tr><!--<th>IP</th></tr><tr><td><input type="text" class="form-control" id="editMaq_ip" name="editMaq_ip" value="'+value.IP_MAQ+'"></td></tr>--><tr><th>LIBERAÇÕES</th></tr><tr><td><input type="checkbox" id="editMaq_funcao_estacao" name="editMaq_funcao_estacao" '+checked_estacao+'>Estação<br><input type="checkbox" id="editMaq_funcao_nfce" name="editMaq_funcao_nfce" '+checked_nfce+'>NFCe<br><input type="checkbox" id="editMaq_funcao_pdo" name="editMaq_funcao_pdo" '+checked_pdo+'>PDO<br><input type="checkbox" id="editMaq_funcao_pdv" name="editMaq_funcao_pdv" '+checked_pdv+'>ECF<br><input type="checkbox" id="editMaq_funcao_servidor" name="editMaq_funcao_servidor" '+checked_servidor+'>Servidor<br><input type="checkbox" id="editMaq_funcao_tef" name="editMaq_funcao_tef" '+checked_tef+'>TEF<br></td></tr></table><input type="button" class="btn btn-success" onclick="atendimento_cadastro_suporte_edita_maquina(\''+C+'\',\''+T+'\',\''+btoa(
                  value.ID_MAQUINA)+'\',\''+btoa(value.HASH_ULT_GRAVACAO)+'\')" value="Salvar alterações"><br><br></form>';
                  html += '<td><div class="btn-group" style="float:right;"><button type="button" class="btn">Ação</button><button type="button" class="btn dropdown-toggle" data-toggle="dropdown"><span class="caret"></span></button> <span class="sr-only">Clique para expandir</span></button><ul class="dropdown-menu pull-right" role="menu"><li><a href="javascript:void(0)" onclick="atendimento_cadastro_suporte_formEdit(\''+btoa(formEdicao)+'\',1)">Editar máquina</a></li><li><a href="javascript:void(0)" onclick="atendimento_cadastro_suporte_reseta_maquina(\''+C+'\',\''+T+'\',\''+btoa(
                    value.ID_MAQUINA)+'\',\''+btoa(value.IP_MAQ)+'\')"  >Resetar máquina</a></li><li><a href="javascript:void(0)" onclick="atendimento_cadastro_suporte_excluir_maquina(\''+C+'\',\''+T+'\',\''+btoa(
                      value.ID_MAQUINA)+'\',\''+btoa(value.IP_MAQ)+'\')" >Excluir máquina</a></li></ul></td>';
                      html += '</tr>';
                    }

                  });
                  html += '</table>';
                  html += '<table class="table table-bordered"><tr>';
                  html += '<th>Utilizados</th><th>Liberados</th></tr>';
                  html += '<tr>';
                  html += '<td>';
                  html += '<b>ESTAÇÕES: </b>'+TOT_FUNCAO_ESTACAO+'<br>';
                  html += '<b>NFCE('+TOT_FUNCAO_NFCE+') + PDV('+TOT_FUNCAO_PDV+') + PDO('+TOT_FUNCAO_PDO+'): </b>'+(TOT_FUNCAO_NFCE+TOT_FUNCAO_PDV+TOT_FUNCAO_PDO)+'<br>';
                  html += '<b>SERVIDORES: </b>'+TOT_FUNCAO_SERVIDOR+'<br>';
                  html += '<b>TEF\'S: </b>'+TOT_FUNCAO_TEF+'<br>';
                  html += '</td>';
                  html += '<td>';
                  html += '<b>ESTAÇÕES: </b>'+(parseInt(result.dados[0]['CONTRATO_QTD_TERM'])+1)+'<br>';
                  html += '<b>NFCE + PDV + PDO: </b>'+(result.dados[0]['CONTRATO_QTD_PDV'])+'<br>';
                  html += '<b>SERVIDORES: </b>'+1+'<br>';
                  html += '<b>TEF\'S: </b>'+result.dados[0]['CONTRATO_QTD_TEF']+'<br>';
                  html += '</td>';
                  html += '</tr>';
                  html += '</table>';
                  html += '<input type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalAtend_addMaq" value="Adicionar máquina">';
                  $("#maquinas #maquinas_content").html(html);
                }
                if(result.t == '3'){
                  $("#t3r").val(1);
                  var html = '';
                  /*
