function abreWeberPIXAdm(source){

  carregando(1);
  $.ajax({
    url:"ajax_getTokenRedirectWPix.php",
    type:"post",
    dataType:"json",
    data: { source : source },
    success:function(data) {

      if(data.status == 1){
        window.open(data.urlRedirect,'_blank');
      } else {
        aviso(data.mensagem,3);
      }

    },
    complete:function(data){
      carregando(2);
    },
    error:function(data){
      aviso("Verifique sua conexão com internet.\n\n" + data.statusText, 3);
    }
  });
}

