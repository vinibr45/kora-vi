    html += '<button type="button" class="btn btn-default" data-dismiss="modal"><i class="glyphicon glyphicon-remove mr-2"></i>Cancelar</button>';
    html += '&nbsp;&nbsp;';
    html += '<button type="button" class="btn btn-success" onclick="confirmarVersaoMinimaBD(\'' + HASH_SHA256 + '\', ' + (VERSAO_MIN_ATUAL > 0 ? VERSAO_MIN_ATUAL : 0) + ')"><i class="glyphicon glyphicon-ok mr-2"></i>Confirmar alteração</button>';
    html += '</div>';
    html += '<hr>';
    html += '</form>';
    
    $("#modalVersaoMinimaBD_content").html(html);
    $("#modalVersaoMinimaBD").modal('show');
    carregando(2);
    
    // Foco no input para melhor UX
    setTimeout(function(){
      $("#inputNovaVersaoMinima").focus();
    }, 500);
  } else {
    aviso("Erro ao obter dados da versão.",2);
  }
}

function confirmarVersaoMinimaBD(HASH_SHA256, VERSAO_MIN_ATUAL){
  if(HASH_SHA256){
    var novaVersao = $("#inputNovaVersaoMinima").val().trim();
    
    // Validação: aceita apenas números ou vazio
    if(novaVersao === "" || /^\d+$/.test(novaVersao)){
      carregando(1);
      $.ajax({
        url:"appsWeberBetaChangeBdUpdateVersionMin.php",
        type:"get",
        data: {
          hashsha256 : HASH_SHA256,
          versaoMinimaUpdateBd : (novaVersao === "" ? "0" : novaVersao),
          versaoMinimaUpdateBdAtual : VERSAO_MIN_ATUAL,
          prevUrl : btoa(window.location.href)
        },
        success: function (result){
          // Se result começa com OK: é sucesso, caso contrário é erro
          if(result.substring(0,3) == "OK:"){
            carregando(2);
            $("#modalVersaoMinimaBD").modal('hide');
            aviso("Versão mínima do BD alterada com sucesso!",1);
            location.reload();
          } else {
            carregando(2);
            aviso("Erro ao processar a solicitação.\n" + result,3);
          }
        }, error: function(result) {
          carregando(2);
          $("#modalVersaoMinimaBD").modal('hide');
          aviso("Erro ao processar a solicitação.\n" + result.statusText,3);
        }
      });
    } else {
      aviso("Digite apenas números para a versão!",3);
    }
  } else {
    aviso("Erro ao processar a solicitação.",3);
  }
}

function enviaToken(ACAO){

  var URL = $("#TOKEN_URL").val();
  var EMAIL = $("#TOKEN_EMAIL").val();
  if(URL && EMAIL && ACAO){
    if(validateEmail(EMAIL)){
      carregando(1);
      $.ajax({
        url:"ajax_enviaTokenCliente.php",
        type:"post",
        data: {
          URL : URL,
          EMAIL : EMAIL,
          ACAO : ACAO
        },
        success: function (result){
          var resultado = null;
          try {
            resultado = JSON.parse(result);
            if(resultado.status == 1){
              swal("Sucesso", "Link enviado com sucesso.", "success");
              carregando(2);
            } else {
              carregando(2);
              swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
            }

          } catch(err){
            carregando(2);
            swal("Ops..", "Erro na solicitação\n"+err, "warning");
          }

        }, error: function(result) {
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
        }

      });
    } else {
      swal("Atenção", "Você deve informar um e-mail válido", "warning");
    }
  } else {
    swal("Atenção", "Você deve informar um e-mail", "warning");
  }
}

