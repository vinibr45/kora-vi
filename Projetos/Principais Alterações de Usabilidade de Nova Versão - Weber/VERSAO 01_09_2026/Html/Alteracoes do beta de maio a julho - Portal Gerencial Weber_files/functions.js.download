function refreshSidebar(){

  return;

  const minutesToWait = 5;
  if( localStorage.getItem('PG_sb_lastSinc') != null && localStorage.getItem('PG_sb_data') != null ){
    const lastSinc = new Date(localStorage.getItem('PG_sb_lastSinc'));
    const nextSinc = lastSinc.setTime(lastSinc.getTime() + ( minutesToWait * 60 * 1000));
    const pNow = new Date().getTime();
    if(pNow < nextSinc){
      mountSidebar( localStorage.getItem('PG_sb_data') );
      return false;
    }
  }

  if(portal_gerencial_sleep == true)
  return false;

  $.ajax({
    url:'ajax_refreshSidebar.php',
    type:'post',
    success: function (result){
      localStorage.setItem( 'PG_sb_lastSinc', new Date() );
      if(result != "not_yet"){
        resultados = JSON.stringify(JSON.parse(result));
        localStorage.setItem( 'PG_sb_data', resultados );
        mountSidebar(resultados);
      } else {
        if( localStorage.getItem( 'PG_sb_data') ){
          mountSidebar( localStorage.getItem('PG_sb_data') );
        }
      }
    }
  });


  function mountSidebar(data){
    data = JSON.parse(data);
    $.each(data[0]["SIDEBAR"],function(index, value){
      $("#"+value["ID_DIV"]).html(value["QTD"]);
    });
    $('#ntf_topo').html(data[0]["TOTAL_TOP"]);
    $("#notificacoes_topo_ntf").html(data[0]["HTML_TOP"]);
  }
}

String.prototype.replaceAll = function(search, replacement) {
  var target = this;
  return target.replace(new RegExp(search, 'g'), replacement);
};

