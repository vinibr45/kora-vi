                      var formEdicao = '<form id="editPDV_FORM"><table class="table table-bordered"><tr class="d-none"><th>Validade TEF</th></tr><tr class="d-none"><td><input type="date" name="editPDV_TEF_VALIDADE" class="form-control" value="'+value.TEF_VALIDADE.split("/").reverse().join("-")+'"></td></tr>';
