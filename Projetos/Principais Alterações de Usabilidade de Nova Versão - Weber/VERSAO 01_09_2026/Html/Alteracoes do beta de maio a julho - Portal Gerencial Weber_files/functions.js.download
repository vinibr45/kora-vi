function alteraStatus(num,id){
  $('#JanelaAlt_id').val(id);
  $('#JanelaAlt_num').val(num);
  $('#JanelaAlt_motivo').val($('#motivo_'+num).val());
  $('#JanelaAlt_motivo_id').val($('#id_motivo_'+num).val());
  $('#JanelaAlt_status').val($('#status_prop_'+num).val());
  if($('#concluida_prop_'+num).val() == 'S'){
    document.getElementById('JanelaAlt_finalizada').checked = true;
  } else {
    document.getElementById('JanelaAlt_finalizada').checked = false;
  }
  document.getElementById("id_prop").value = id;
}


