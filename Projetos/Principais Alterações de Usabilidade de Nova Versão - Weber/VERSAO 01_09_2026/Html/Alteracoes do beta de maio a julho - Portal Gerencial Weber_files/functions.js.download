                        html += '<td><div class="btn-group" style="float:right;"><button type="button" class="btn">Ação</button><button type="button" class="btn dropdown-toggle" data-toggle="dropdown"><span class="caret"></span></button> <span class="sr-only">Clique para expandir</span></button><ul class="dropdown-menu pull-right" role="menu"><li><a href="javascript:void(0)" onclick="atendimento_cadastro_suporte_formEdit(\''+btoa(formEdicao)+'\',2)"  >Editar caixa</a></li><li><a href="javascript:void(0)" onclick="window.open(\'atendimento_cadastro_suporte_tefs.php?cli='+C+'&serie='+btoa(
