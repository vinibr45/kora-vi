function atendimento_LancarPontoConfirmacaoBloco(msg){

  swal({
    title: "Atenção",
    text: " " + msg + "\nUtilize o campo Observação para correção.\n\nDeseja continuar mesmo assim?",
    icon: "warning",
    buttons: ["Não", "Sim"],
    dangerMode: true,
  }).then(function(podeSalvar){
    if (podeSalvar) {
      G_pontoConfirmacaoBlocoDiferente = true;
      atendimento_LancarPonto();
    }
  });

}

var G_pontoConfirmacaoBlocoDiferente = false;
function atendimento_LancarPonto(){

  var ES = $("#AtendLP_ES").val();
  var TJ = $("#AtendLP_TJ").val();
  var OBS = $("#AtendLP_OBS").val();

  if(ES && TJ){
    carregando(1);
    $.ajax({
      url: "ajax_atendimentoPONTOE_lcto.php",
      type: "post",
      dataType: "json",
      data: {
        ES : ES,
        TJ : TJ,
        OBS : OBS,
        CBDF : G_pontoConfirmacaoBlocoDiferente
      },
      success: function (result){
        if(result.status == 1){

          G_pontoConfirmacaoBlocoDiferente = false;
          $("#modalAtendLP").modal('hide');

          swal("Sucesso", "Registro lançado com sucesso.","success").then(function(value){
            try{

              $("#modalAtendLP #AtendLP_OBS").val('');
              $("#modalAtendLP #AtendLP_ES").val('');



    } catch(e){
      alert(e);
    }
  });
} else if(result.need_confirm == true){
  atendimento_LancarPontoConfirmacaoBloco(result.mensagem_confirmacao);
} else {
  swal("Ops..", "Erro na solicitação\n"+result.mensagem, "error");
}
}, error: function(result) {
  swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
}, complete: function(result){
  carregando(2);
}
});
} else {
  aviso("Você deve informar o tipo de movimentação.",2);
}
}

