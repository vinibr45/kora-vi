function atendimentoListaEsperaGeral(SETOR,ORDENACAO){
  var openList = getURLparameter('olid');
  if(SETOR){
    $('.filtro-lista').hide();
    carregando(1);
    $.ajax({
      url:"ajax_atendimentoListaEsperaGeral.php",
      type:"post",
      data: {
        SETOR : SETOR,
        ORDENACAO : ORDENACAO,
        USER_RESP : $('#filtroUser_resp').val(),
        USER_CLIE : $('#filtroUser_clie').val(),
        USER_CRIOU : $('#filtroUser_criou').val(),
        USER_ALTEROU : $('#filtroUser_alterou').val()
      },
      success: function (result){
        var compURL = '?s=' + $('#filtroSetor').val() + '&o=' + ORDENACAO + '&u_r=' + $('#filtroUser_resp').val() + '&u_cl=' + $('#filtroUser_clie').val() + '&u_cr=' + $('#filtroUser_criou').val() + '&u_a=' + $('#filtroUser_alterou').val();
        window.history.replaceState({}, document.title, document.URL.split('?')[0]  + compURL );
        if(openList){
          result += "<script>setTimeout(function(){ $('#btnDetalhesLista_" + openList + "').click(); }, 1000);</script>";
        }
        $("#atendimentoListaEsperaGeralContent").html(result);
        $('.filtro-lista').show();
        $("#filtroDIV").html(null);
        carregando(2);
      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      }, complete: function(result){
        try {
          var _qtdAtrasada = 0;
          var nowServer = new Date($('#_timeServidorListaEsperaGeral').val());
          $('.td_atendMetaData').each(function(){
            var _date = $(this).text().replaceAll("\n","").trim();
            _date = new Date( _date.split("/").reverse().join("-"));
            if(_date < nowServer){
              _qtdAtrasada++;
            }
          });
          $('#footerPage').html('<br><b>Quantidade de listas foras da meta:</b> ' + _qtdAtrasada);
        } catch (e) {
          console.log('l3329 ' + e);
        }




      }
    });
  } else {
    aviso("Erro ao obter setor : ",2);
  }

}

