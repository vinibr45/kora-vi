                        html += '<hr>';
                        html += '<table class="table table-bordered"><tr><th>Usuário</th><th>Status</th><th>Última alteração</th><th>Master</th></tr>';
                        $.each(result.dados, function(key,value){
                          html += '<tr><td>'+value.ID_USUARIO+'</td><td>'+value.STATUS+'</td><td>'+value.ULT_GRAVACAO+'</td><td><input type="checkbox" class="form-control" onchange="setaMasterMobile(this.checked,'+value.ID_USUARIO+')" ' + ( value.MASTER == 'S' ? ' checked="checked" ' : '' ) + '></td></tr>';
                        });
                        html += '</table>';
                        $("#mobile_content").html(html);
