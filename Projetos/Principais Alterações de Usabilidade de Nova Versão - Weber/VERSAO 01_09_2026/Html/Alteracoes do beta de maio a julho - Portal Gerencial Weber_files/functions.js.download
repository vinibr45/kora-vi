                    if($("#editPDV_caixa").val()<1){error = "Você deve informar um PDV.";}
                    if(!$("#editPDV_versao").val()){error="Você deve informar a versão do PDV.";}
                    if(!$("#editPDV_modelo").val()){error="Você deve informar o modelo do PDV.";}
                    if(!$("#editPDV_marca").val()){error="Você deve informar a marca do PDV.";}
                    if(error == null){
                      var data = $("#editPDV_FORM").serialize();
                      if(data){
                        carregando(1);
                        $.ajax({
                          url: "ajax_atendimentoCADSUPORTE_editPDV.php",
                          type: "post",
                          dataType: "json",
