function getDiaSemana(data){
  var days = ['Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sabado','Domingo'];
  var parts = data.split('/');
  var d = new Date(parts[2]+'-'+parts[1]+'-'+parts[0]);
  return days[d.getDay()];
}

