function posVenda_Cliente(){

  id = $("#add_cod_cli").val();
  if(id != null){

    carregando(1);
    $.ajax({

      url:"ajax_posvendaCliente.php",
      type:"post",
      data: {
        id : id
      },
      success: function (result){
        var resultado = null;
        try {
          resultado = JSON.parse(result);
          if(resultado.status == 1){

            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth()+1; //janeiro é 0!
            var yyyy = today.getFullYear();
            if(dd<10){  dd='0'+dd; }
            if(mm<10){  mm='0'+mm; }
            var today = dd+'/'+mm+'/'+yyyy;
            if(today == resultado.ult_pv_dmY.split(' ')[0]){
              aviso("Este cliente já possui Pós-venda realizado hoje.",2);
            }

            $("#add_ult_contato").val(resultado.ult_os);
            $("#add_qtd_lista").val(resultado.qtd_lista);
            $("#add_nome_razao").val(resultado.nome_razao);
            $("#add_ult_lista").val(resultado.ult_lista);
            $("#add_ult_pv").val(resultado.ult_pv);
            $("#div_ult_os").html(resultado.ult_os_dias);
            $("#div_ult_pv").html(resultado.ult_pv_dias);
            $("#div_ult_lista").html(resultado.ult_lista_dias);
            $('#add_data').val(resultado.now);
            document.getElementById("add_link_os").href = "atendimento_registrar.php?&cli="+resultado.cli_crip+'#lista_os';
            document.getElementById("add_link_lista").href = "atendimento_registrar.php?&cli="+resultado.cli_crip+'#status_clie';
            document.getElementById("add_link_pv").href = "pos_venda_lctos.php?&filtro=1&pesquisar=Pesquisar&termo="+id;
            try {
              $.ajax({
                url:"ajax_posvendaTelefones.php",
                type:"post",
                timeout:5000,
                data: { id : id },
                success: function (result){
                  $("#add_fones").html(result);
                }
              });
            } catch(err){}
            carregando(2);
          } else {
            posVenda_ResetaDados();
            swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
            carregando(2);
          }

        } catch(err){
          posVenda_ResetaDados();
          swal("Ops..", "Erro na solicitação\n"+err, "warning");3
          carregando(2);
        }
      }, error: function(result) {
        posVenda_ResetaDados();
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
        carregando(2);
      }

    });

  }

}

function salvarPosVenda(){

  var data =              $("#add_data").val();
  var tipo =              $("#add_tipo_pv").val();
  var cod_cli =           $("#add_cod_cli").val();
  var nome_razao =        $("#add_nome_razao").val();
  var ult_contato =       $("#add_ult_contato").val();
  var ult_pv =            $("#add_ult_pv").val();
  var ult_lista =         $("#add_ult_lista").val();
  var contato =           $("#add_contato").val();
  var nota1 =             $("#add_nota1").val();
  var nota1_obs1 =        $("#add_nota1_obs1").val();
  var nota1_obs2 =        $("#add_nota1_obs2").val();
  var nota2 =             $("#add_nota2").val();
  var nota2_obs1 =        $("#add_nota2_obs1").val();
  var nota2_obs2 =        $("#add_nota2_obs2").val();
  var pendencia =         $("#add_pendencia:checked").val();
  var prox_contato =      $("#add_prox_contato").val();
  var prox_contato_nome = $("#add_prox_contato_nome").val();
  var prox_contato_hora = $("#add_prox_contato_hora").val();
  var erro = null;
  if(!cod_cli || !nome_razao){
    erro = "Você deve informar o cliente";
  }
  if(!contato){
    erro = "Você deve informar o contato";
  }
  if(!nota1){
    erro = "Você deve informar a nota referente a empresa";
  }
  if(!nota2){
    erro = "Você deve informar a nota referente ao sistema";
  }
  if(!tipo){
    erro = "Você deve informar o tipo";
  }
  if(!prox_contato_nome){
    //  erro = "Você deve informar o nome do próximo contato";
  }
  if(prox_contato || prox_contato_hora){
    if(!prox_contato || !prox_contato_hora){
      erro = "Você deve informar uma DATA e HORA para próximo contato validas, ou deixar em branco";
    }
  }
  if(tipo < 1){
    erro = "Você deve informar o tipo de pós-venda";
  }
  if(!pendencia){
    erro = "Você deve informar se existe ou não pendências";
  }

  if(erro == null){

    carregando(1);
    $.ajax({
      url:"ajax_posvendaSalvar.php",
      type:"post",
      data: {
        data : data,
        tipo : tipo,
        cod_cli : cod_cli,
        ult_contato : ult_contato,
        ult_pv : ult_pv,
        ult_lista : ult_lista,
        contato : contato,
        nota1 : nota1,
        nota1_obs1 : nota1_obs1,
        nota1_obs2 : nota1_obs2,
        nota2 : nota2,
        nota2_obs1 : nota2_obs1,
        nota2_obs2 : nota2_obs2,
        pendencia : pendencia,
        prox_contato : prox_contato,
        prox_contato_hora : prox_contato_hora,
        prox_contato_nome : prox_contato_nome
      },
      success: function (result){

        var resultado = null;
        try {
          resultado = JSON.parse(result);
          if(resultado.status == 1){
            swal("Sucesso", resultado.mensagem, "success").then(function(value){
              location.reload();
            });
            location.reload();
          } else {
            carregando(2);
            swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
          }

        } catch(err){
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+err, "warning");
        }

      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      }

    });

  } else {
    swal("Atenção", erro, "warning");
  }

}

function ajudaCliente(campo, coluna, campo2){
  $('#ajudaCliente_campo').val(campo);
  $("#ajudaCliente_campo2").val(campo2);
  $('#ajudaCliente_coluna').val(coluna);
  $('#modal_ajudaCliente').modal('show');
  $('#ajudaCliente_termo').keypress(function (e) {
    if (e.which == 13 || event.keyCode == 13) {
      ajudaCliente_pesquisa();
    }
  });
  //CORRIGE SCROLL DO MODAL ANTERIOR
  $('#modal_ajudaCliente').on('hidden.bs.modal', function () {
    $('body').addClass('modal-open');
  });
}

function ajudaCliente_pesquisa(tipo_pesq){

  var termo  =  $("#ajudaCliente_termo").val();
  var filtro =  $("#ajudaCliente_filtro").val();
  var coluna =  $("#ajudaCliente_coluna").val();
  if(termo != null){
    carregando(1);
    $.ajax({
      url:"ajax_ajudaCliente_pesquisa.php",
      type:"post",
      data: {
        termo : termo,
        filtro : filtro,
        coluna : coluna,
        tipo_pesq : tipo_pesq
      },
      success: function (result){
        $("#ajudaCliente_result").html(result);
        carregando(2);
      }, error: function(result) {
        carregando(2);
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      }

    });
  }

}

function ajudaCliente_selecionar(valor,nome_razao){
  var campo = $('#ajudaCliente_campo').val();
  var campo2 = $("#ajudaCliente_campo2").val();
  $("#"+campo).val(valor);
  if(campo2 != ''){
    $("#"+campo2).val(nome_razao);
  }
  if(campo == "add_cod_cli"){
    posVenda_Cliente();
  }
  $('#modal_ajudaCliente').modal('hide');
}

function salvarAtaReuniao(id_ata, no_redirect_page){

  swal({
    title: "Ei, você revisou todos os dados ?",
    text: "Estas informações são importantes, logo, devem ser preenchidas de maneira correta",
    icon: "warning",
    buttons: ["Irei revisar os dados", "Revisei os dados"],
    dangerMode: false,
  }).then(function(podeSalvar){
    if (podeSalvar) {

      var participantes = new Array;

      var divs = document.querySelectorAll('.participou');
      for (i = 0; i < divs.length; ++i) {

        var participou;
        if( divs[i].checked ){
          participou = 'S';
        } else {
          participou = 'N';
        }

        participantes.push({
          ID_CLIENTE: divs[i].value,
          FANTASIA: $("#"+divs[i].value+"_FANTASIA").val(),
          OBS: $("#"+divs[i].value+"_OBS").val(),
          PARTICIPOU:  participou
        });

      }

      var assunto_discutir = CKEDITOR.instances.editor1.getData();
      var assunto_decidido = CKEDITOR.instances.editor2.getData();
      var assunto_pendente = CKEDITOR.instances.editor3.getData();
      var data_inicio =   $("#dt_inicio").val();
      var data_termino =  $("#dt_fim").val();
      var informativo =   $("#informativo").val();
      var erro = null;

      var qtd_assunto_discutir = assunto_discutir.length;

      if(qtd_assunto_discutir < 10){
        erro = "Você deve preencher mais os assuntos a serem discutidos", "warning";
      }


      if(data_inicio.length != 16 || data_termino.length != 16){
        erro = "Você deve informar a data inicial e final corretamente: " + data_inicio + " - " + data_termino;
      }

      if(informativo < 1){
        erro = "Você deve informar o informativo desta reunião";
      }

      if(participantes.length < 1){
        erro = "Você deve informar pelo menos um participante";
      }

      if(erro == null){

        var participantesJSON = JSON.stringify(participantes);

        var usua_abriu = $('#usua_abriu').val();
        var ult_alteracao = $('#ult_alteracao').val();

        carregando(1);
        $.ajax({
          url:"ajax_atareuniaoSalvar.php",
          type:"post",
          data: {
            assunto_discutir : assunto_discutir,
            assunto_decidido : assunto_decidido,
            assunto_pendente : assunto_pendente,
            data_inicio : data_inicio,
            data_termino : data_termino,
            informativo : informativo,
            participantes : participantesJSON,
            id_ata : id_ata,
            ult_alteracao : ult_alteracao,
            usua_abriu : usua_abriu
          },
          success: function (result){

            var resultado = null;
            try {
              resultado = JSON.parse(result);
              if(resultado.status == 1){
                carregando(2);
                swal("Sucesso", resultado.mensagem, "success").then(function(value){
                  if(!no_redirect_page){
                    window.open('reuniao_gerenciar_ata.php', '_self');
                  }
                });
              } else {
                carregando(2);
                swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
              }
            } catch(err){
              carregando(2);
              swal("Ops..", "Erro na solicitação\n"+err, "warning");
            }

          }, error: function(result) {
            carregando(2);
            swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
          }

        });

      } else {
        swal("Ops..", erro, "warning");
      }

    }

  });

}


function ataReuniao_CarregaDetalhes(id,num,btn){
  $('.trAtaReuniaoListagem').removeClass('active');
  $(btn).closest('.trAtaReuniaoListagem').addClass('active');
  if(id != null){
    $("#79rga_btnAnt").prop("onclick", null).off("click");
    $("#80rga_btnProx").prop("onclick", null).off("click");
    $("#modal_detalhes").modal('show');
    carregando(1);
    $("#modal_detalhes_content").html(null);
    $("#77rga_numAtaLBL").html(num);
    $.ajax({
      url:"ajax_atareuniaoDetalhes.php",
      type:"post",
      data: {
        id : id
      },
      success: function (result){
        $("#modal_detalhes_content").html(result);
        $("#80rga_btnProx").on("click", function(){
          $(".btn-detalhes-ata").eq( $(".btn-detalhes-ata").index( $(btn) ) + 1 ).click();
        });
        $("#79rga_btnAnt").on("click", function(){
          $(".btn-detalhes-ata").eq( $(".btn-detalhes-ata").index( $(btn) ) - 1 ).click();
        });
        $("#Ckb65548_ataLida_"+id).prop('checked', true);
        carregando(2);
      }, error: function(result) {
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
        carregando(2);
      }
    });
  }
}

function imprimeAta(){
  $("#modal_detalhes_content").print();
}


function imprimeDIVstyled(div_id){

  var txtsAreas = new Array;
  var cache_txtHeight = 0;
  var cache_divHeight = 0;

  $(function() {
    $('#' + div_id +' textarea').each(function() {
      txtsAreas.push(this);
      if(cache_txtHeight == 0){
        cache_txtHeight = $(this).height();
      }
      $(this).height($(this).prop('scrollHeight'));
    });
  });

  $("#"+div_id).print({
    globalStyles: true,
    mediaPrint: true,
    stylesheet: null,
    noPrintSelector: ".no-print",
    iframe: true,
    append: false,
    prepend: null,
    manuallyCopyFormValues: true,
    deferred: $.Deferred(),
    timeout: 750,
    title: null,
    doctype: '<!doctype html>'
  });

  $.each( txtsAreas, function( key, value ) {
    $(value).height(cache_txtHeight);
  });

  /*avisoDown("Seu PDF será baixado em breve.");
  var now = new Date;
  var title_PDF = 'Impressao_'+now.getTime()+'.pdf';
  html2canvas($("#"+div_id), {
  onrendered: function(canvas) {
  var imgData = canvas.toDataURL(
  'image/png');
  var doc = new jsPDF('p', 'mm');
  doc.addImage(imgData, 'PNG', 10, 10);
  doc.save(title_PDF);
}});*/

}

