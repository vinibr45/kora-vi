                        html += '<br><hr><table class="table table-bordered"><tr><th>Liberação em confiança disponível</th><th>Quantidade de dias</th></tr>';
                        $.each(result.dados, function(key,value){
                          html += '<tr><td>' + ( value.LIBERA_CONFIANCA == 'S' ? 'Sim' : 'Não' ) + '</td><td>' + value.LIBERA_CONFIANCA_DIAS + '</td></tr>';
                        });
                        html += '</table>';
                        $("#registro_content").html(html);
                      }
                      if(result.t == '10'){
                        $('#t10r').val(0);

                        var html = '<form id="formCadSuporteCadastro">';

                        html += '<table class="table table-bordered"><tr><th>Classe estratégica</th><th>Grupo Holding</th></tr>';
                        html += '<tr>';
                        html += '<td>';
                        html += '<select class="form-control" name="cadastro_classeEstrategica" id="cadastro_classeEstrategica">';
                        html += '<option value="">Selecione..</option>';
                        $.each(result.classes_estrategicas, function(key,value){
                          html += '<option value="' + key + '">' + value + '</option>';
                        });
                        html += '</select>';
                        html += '</td>';
                        html += '<td>';
                        html += '<select class="form-control" name="cadastro_grupoHolding" id="cadastro_grupoHolding">';
                        html += '<option value="">Selecione..</option>';
                        $.each(result.grupos_holding, function(key,value){
                          html += '<option value="' + value.ID_HOLDING + '">' + value.DESCRICAO + '</option>';
                        });
                        html += '</select>';
                        html += '</td>';
                        html += '</tr>';
                        html += '</table>';

                        html += '<table class="table table-bordered"><tr><th>Prioridade de atendimento</th></tr>';
                        html += '<tr>';
                        html += '<td colspan="2">';
                        html += '<select class="form-control" name="cadastro_prioridadeAtendimento" id="cadastro_prioridadeAtendimento">';
                        html += '<option value="">Selecione..</option>';
                        $.each(result.prioridades_Atendimento, function(key,value){
                          html += '<option value="' + key + '">' + value + '</option>';
                        });
                        html += '</select>';
                        html += '</td>';
                        html += '</tr>';
                        html += '</table>';

                        html += '</form>';
                        html += '<hr>';
                        html += '<input type="button" class="btn btn-success" onclick="atendimento_cadastro_suporte_edita_cad(\''+T+'\',\''+C+'\')" value="Salvar alterações"><br><br>';
                        $("#cadastro_content").html(html);

                        //Setando valores atuais do cliente
                        $('#cadastro_content #cadastro_grupoHolding').val(result.dados[0].COD_HOLDING);
                        $('#cadastro_content #cadastro_classeEstrategica').val(result.dados[0].CLASSE_ABC);
                        $('#cadastro_content #cadastro_prioridadeAtendimento').val(result.dados[0].CLASSE_ATEND);

                      }
                      carregando(2);
                    } else {
