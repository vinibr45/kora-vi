                function portalGerencialListarSessoesAtivas(){

                    $('#divListagemSessoesAtivasPg').html(setaLoadingModal());
                    var html = '';
                    $.ajax({
                      url: "ajax_doLoginPortalGerencialSessoesAbertas.php",
                      type: "post",
                      dataType: "json",
                      data: {    },
                      success: function (result){
                        if(result.success == true){

                          html = '<table class="table table-bordered"><tr><th>USUÁRIO</th><th>HORÁRIO DE INICIO</th><th>ENDEREÇO DE IP</th><th>DESCONECTAR</TH></tr>';
                          $.each(result.data,function(key, value){
                            html += '<tr><td>' + value.COD_USUARIO_LOGIN + ' - ' + value.NOME_USUARIO_LOGIN + '</td><td>'+value.DTHR_LOGIN+'</td><td>' + value.IP_LOGIN + '</td><td><a href="javascript:portalGerencialForcaLogout(' +  value.COD_USUARIO_LOGIN + ')" class="text-danger"><i class="fas fa-sign-out-alt mr-2"></i>Desconectar</a></td></tr>';
                          });
                          html += '</table><br>';
                        } else {
                          html = result.message;
                        }


                      }, error: function(result) {
                        swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
                      }, complete:function(result){


                        var htmlToPrint = '<div class="px-4 pt-4"><a href="javascript:portalGerencialListarSessoesAtivas()"><i class="fas fa-redo-alt mr-2"></i>Atualizar listagem</a><a class="ml-3" href="gerenciar_sessoesLoginPortalGerencialHistorico.php"><i class="fas fa-list mr-2"></i>Consultar histórico</a></div><hr>'
                        + html;

                        $("#divListagemSessoesAtivasPg").html(htmlToPrint);

                      }
                    });

                }


                function portalGerencialForcaLogout(idUsuario){

                  $('#divListagemSessoesAtivasPg').html(setaLoadingModal());
                  $.ajax({
                    url:"ajax_doLogoutPortalGerencialForcado.php",
                    type:"post",
                    dataType:"json",
                    data: {
                        idUsuario : idUsuario
                    },
                    beforeSend: function(result){

                    },
                    success: function (result){

                      if(result.success != true){
                        aviso(result.message, 3);
                      }

                      portalGerencialListarSessoesAtivas();
                    },
                    error: function(result) {
                      aviso("Erro na solicitação\n"+result.responseText, 3);
                    },
                    complete: function(result){
                    ;
                    }
                  });

                }


                function portalGerencialListarSessoesHistorico(){

                    $('#divListagemSessoesHistoricoPg').html(setaLoadingModal());
                    var htmlToPrint = '';
                    $.ajax({
                      url: "ajax_doLoginPortalGerencialSessoesHistorico.php",
                      type: "post",
                      dataType: "json",
                      data: {  dataInicio : $('#sessoesHistoricoPgDataInicio').val()  },
                      success: function (result){
                        if(result.success == true){


                          htmlToPrint = '<table id="tableListHistoricoSessoesPg" class="table table-bordered">';
                          htmlToPrint += '<thead>';
                          htmlToPrint += '<tr>';
                          htmlToPrint += '<th>Usuário</th>';
                          htmlToPrint += '<th>Login em</th>';
                          htmlToPrint += '<th>Login IP</th>';
                          htmlToPrint += '<th>Logout em</th>';
                          htmlToPrint += '<th>Logout por</th>';
                          htmlToPrint += '</thead>';
                          htmlToPrint += '</tr>';
                          htmlToPrint += '<tbody>';

                          $.each(result.data, function(key,value){

                            htmlToPrint += '<tr>';
                            htmlToPrint += '<td>' + value.COD_USUARIO_LOGIN + ' - ' + value.NOME_USUARIO_LOGIN +  '</td>';
                            htmlToPrint += '<td>' + value.DTHR_LOGIN + '</td>';
                            htmlToPrint += '<td>' + value.IP_LOGIN + '</td>';
                            htmlToPrint += '<td>' + value.DTHR_LOGOUT + '</td>';
                            htmlToPrint += '<td>' + ( value.DTHR_LOGOUT ?   ( value.COD_USUARIO_LOGIN != value.COD_USUARIO_LOGOUT ? ( 'Forçado por ' + value.NOME_USUARIO_LOGOUT ) : 'Próprio usuário' ) : '' )  + '</td>';
                            htmlToPrint += '</tr>';


                          });

                          htmlToPrint += '</tbody>';
                          htmlToPrint += '</table>';





                        } else {
                          htmlToPrint = result.message;
                        }


                      }, error: function(result) {
                        swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
                      }, complete:function(result){


                        htmlToPrint = '<div class="px-4 pt-4"><a href="javascript:portalGerencialListarSessoesHistorico()"><i class="fas fa-redo-alt mr-2"></i>Atualizar listagem</a>'  + htmlToPrint;

                        $("#divListagemSessoesHistoricoPg").html(htmlToPrint);

                        var table = $('#tableListHistoricoSessoesPg').DataTable({
                          "destroy": true,
                          "pageLength" : 25,
                          "paging" : true,
                          "language": {
                            "url": "plugins/dataTables/pt-BR.json"
                          }
                        });


                      }
                    });

                }
