  var modalInCount = document.querySelectorAll('.modal.in').length;
  if (modalInCount > 0) {
    // If it exists, set a custom attribute on the body
    document.body.setAttribute('data-modal-open', 'true');
    document.body.classList.add('modal-open');
  }
}, 1000);  //  milliseconds

