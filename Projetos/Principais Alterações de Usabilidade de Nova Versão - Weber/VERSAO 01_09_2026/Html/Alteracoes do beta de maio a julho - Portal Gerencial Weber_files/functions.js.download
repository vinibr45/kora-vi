function aviso(msg,tipo_aviso){

  switch(tipo_aviso){
    case 1:
    var cor_bg = "#19A15E";
    var tipo = "success";
    var titulo = "Sucesso";
    break;

    case 2:
    var cor_bg = "#615529";
    var tipo = "warning";
    var titulo = "Atenção";
    break;

    case 3:
    var cor_bg = "#A1342B";
    var tipo = "error";
    var titulo = "Ops..";
    break;

  }
  swal(titulo, msg, tipo).then();
}

function validateEmail(email) {
  var re = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
  return re.test(String(email).toLowerCase());
}

