function atendimento_cadastro_suporte_getRegime(regime){
  switch(parseInt(regime)){
    case 1:
    return 'Lucro Real';
    break;

    case 2:
    return 'Simples Nacional';
    break;

    case 3:
    return 'Lucro Presumido';
    break;

    case 4:
    return 'Simples Nacional - Excesso de Sublimite de Receita Bruta';
    break;

    case 5:
    return 'MEI';
    break;

  }
}

