                        },
                        success: function (result){
                          if(result.status == 1){

                            html = "<h6><b>Listando sugestões que contenham:</b> " + $('#form_Sugestao_Assunto #sugestao_descricao').val() + "</h6>";
                            html += "<table class='table table-bordered'><tr><th>Sugestão</th><th>Quantidade</th></tr>";
                            $.each(result.mensagem, function(key,value){
                              html += "<tr><td>" + value.SUGESTAO + "</td><td>" + value.QTD + "</td></tr>";
                            });
                            html += "</table><br><br>";
                            //  $("#form_Sugestao_Assunto")[0].reset();
                          } else {
                            aviso(result.mensagem,2);
                          }
                          carregando(2);
                        }, error: function(result) {
                          console.log(result);
                          carregando(2);
                          swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
                        }, complete: function(){
                          $('#sugestoesLista').html(html);
                        }
                      });
                    }
                  } else {
                    aviso(error,2);
                  }
                }

                function atendimentoCarteira_FormEditar(data){
                  var data_json = JSON.parse( atob(data) );
                  $('#atendimentoCarteiraEditar_form #ID_CLIENTE').val( data_json.ID_CLIENTE );
                  $('#atendimentoCarteiraEditar_form #ID_TECNICO').val( data_json.ID_TECNICO );
                  $('#atendimentoCarteiraEditar_form #ORDEM_PREF').val( data_json.ORDEM_PREF );
                  $('#modalAtendimentoCarteira_editar').modal('show');
                }

