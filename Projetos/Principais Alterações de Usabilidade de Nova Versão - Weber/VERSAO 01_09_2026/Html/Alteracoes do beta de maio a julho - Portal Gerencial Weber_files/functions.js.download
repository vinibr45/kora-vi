function importarAtaCookie(){

  swal({
    title: "Você tem certeza?",
    text: "Após importar o conteúdo salvo em cookie não poderá ser recuperado o atual",
    icon: "warning",
    buttons: ["Não", "Sim"],
    dangerMode: false,
  }).then(function(podeSalvar){
    if (podeSalvar) {

      var participantes = JSON.parse(localStorage.getItem("portal_gerencial_ata_participantes"));
      for(i=0;i < participantes.length; i++){
        if(participantes[i]['PARTICIPOU'] == 'S'){
          $(".participou[value='" + participantes[i]['ID_CLIENTE'] + "']").prop("checked", true);
        }
        $("#" + participantes[i]['ID_CLIENTE'] + "_OBS").val(participantes[i]['OBS']);
      }

      CKEDITOR.instances.editor1.setData(localStorage.getItem('portal_gerencial_ata_assunto_discutir'));
      CKEDITOR.instances.editor2.setData(localStorage.getItem('portal_gerencial_ata_assunto_decidido'));
      CKEDITOR.instances.editor3.setData(localStorage.getItem('portal_gerencial_ata_assunto_pendente'));
      avisoDown("Conteúdo importado");
    }
  });

}

function serialize_inverse(query) {
  var pairs, i, keyValuePair, key, value, map = {};
  if (query.slice(0, 1) === '?') {
    query = query.slice(1);
  }
  if (query !== '') {
    pairs = query.split('&');
    for (i = 0; i < pairs.length; i += 1) {
      keyValuePair = pairs[i].split('=');
      key = decodeURIComponent(keyValuePair[0]);
      value = (keyValuePair.length > 1) ? decodeURIComponent(keyValuePair[1]) : undefined;
      map[key] = value;
    }
  }
  return map;
}

function importaAtendCookie(){
  swal({
    title: "Você tem certeza?",
    text: "A importação irá substituir os dados atuais.",
    icon: "warning",
    buttons: ["Não", "Sim"],
    dangerMode: true,
  }).then(function(podeSalvar){
    if (podeSalvar) {
      var data = JSON.parse(localStorage.getItem("dataOS"));
      $.each(data, function(key,value){
        $('[name='+key+']').val( value );
      });
      eventsNovaOS();
    }
  });
}

function getFormData($form){
  var unindexed_array = $form.serializeArray();
  var indexed_array = {};

  $.map(unindexed_array, function(n, i){
    indexed_array[n['name']] = n['value'];
  });

  return indexed_array;
}


function salvaAtendCookie(){
  window.setInterval( function() {
    if( $("#formNovaOS #descricao").val().length > 30 ){
      var data = JSON.stringify(getFormData($("#formNovaOS")));
      localStorage.setItem("dataOS", data);
    }
  }, 2500);
}

function salvaAtaCookie(){
  window.setInterval( function() {
    var salvo = false;
    var participantes = new Array;
    var divs = document.querySelectorAll('.participou');
    for (i = 0; i < divs.length; ++i) {
      var participou;
      if( divs[i].checked ){
        participou = 'S';
      } else {
        participou = 'N';
      }
      participantes.push({
        ID_CLIENTE: divs[i].value,
        FANTASIA: $("#"+divs[i].value+"_FANTASIA").val(),
        OBS: $("#"+divs[i].value+"_OBS").val(),
        PARTICIPOU:  participou
      });
    }
    var assunto_discutir = CKEDITOR.instances.editor1.getData();
    var assunto_decidido = CKEDITOR.instances.editor2.getData();
    var assunto_pendente = CKEDITOR.instances.editor3.getData();
    if(assunto_discutir.length > 20){ localStorage.setItem("portal_gerencial_ata_assunto_discutir", assunto_discutir); salvo = true; }
    if(assunto_decidido.length > 20){ localStorage.setItem("portal_gerencial_ata_assunto_decidido", assunto_decidido); localStorage.setItem("portal_gerencial_ata_informativo", $("#informativo").val() );
    localStorage.setItem("portal_gerencial_ata_dt_inicio", $("#informativo").val()); salvo = true; }
    if(assunto_pendente.length > 20){ localStorage.setItem("portal_gerencial_ata_assunto_pendente", assunto_pendente); salvo = true; }
    if(salvo == true){
      localStorage.setItem("portal_gerencial_ata_participantes", JSON.stringify(participantes));
      avisoDown('Conteúdo salvo localmente');
    }
  }, 10000);
}

