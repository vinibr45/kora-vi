                function atendimentoCarteira_Remover(CLIENTE, TECNICO){
                  swal({
                    title: "Você tem certeza?",
                    text: "Não será possível reverter estas alterações.",
                    icon: "warning",
                    buttons: ["Não", "Sim"],
                    dangerMode: true
                  }).then(function(podeSalvar){
                    if (podeSalvar) {
                      carregando(1);
                      $.ajax({
                        url: "ajax_atendimentoCARTEIRA_remover.php",
                        type: "post",
                        dataType: "json",
                        data: {
                          ID_CLIENTE : CLIENTE,
                          ID_TECNICO : TECNICO
                        },
                        success: function (result){
                          if(result.status == 1){
                            aviso(result.mensagem,1);
                            location.reload();
                          } else {
                            aviso(result.mensagem,2);
                          }
                          carregando(2);
                        }, error: function(result) {
                          console.log(result);
                          carregando(2);
                          swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
                        }
                      });
                    }
                  });
                }

