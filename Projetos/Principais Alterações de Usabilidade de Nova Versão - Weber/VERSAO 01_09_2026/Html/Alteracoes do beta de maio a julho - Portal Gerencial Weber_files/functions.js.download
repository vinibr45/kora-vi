    beforeSend: function(){
      carregando(2);
      criaModal("envioMalasDiretasPendentes", "Envio de Malas Diretas Pendentes(E-mail)");
      $("#envioMalasDiretasPendentes").modal('show');
      $("#envioMalasDiretasPendentes_content").html(setaLoadingModal());
    },
    success: function (result){
      $("#envioMalasDiretasPendentes_content").html("Resultado do envio:<br><hr>" + result + "<hr>");
    },
    complete: function(){
      carregando(2);
    },
    error: function(result) {
      carregando(2);
      swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
    }
  });
}

function atendimento_cadastro_suporte_dados(C,T){

  if(C,T){
    carregando(1);
    $.ajax({
      url: "ajax_atendimentoCADSUPORTE_dados.php",
      type: "post",
      dataType: "json",
      data: { C : C, T : T },
      success: function (result){
        if(result.status == 1){
          if(result.t == '1'){
            $("#t1r").val(1);
            $("#vpn #vpn_ip").val(result.dados[0].VPN_HOST);
            $("#vpn #porta1").val(result.dados[0].VPN_PORTA1);
            $("#vpn #porta2").val(result.dados[0].VPN_PORTA2);
            $("#vpn #vpn_local_ip").val(result.dados[0].VPN_LOCAL_HOST);
            $("#vpn #vpn_local_porta").val(result.dados[0].VPN_LOCAL_PORTA);
            $("#vpn #vpn_token_mac").val(result.dados[0].VPN_TOKEN_MAC);
            $('#vpn #bdw_pro_token_mac').val(result.dados[0].BDW_CHAVE)
            $('#vpn #vpn_ult_ipext').html('Atualizado última vez pela VPN em ' + result.dados[0].VPN_ULT_IPEXT);
            $('#vpn #clie_conta_ult_alteracao').html('Dados alterados última vez pelo usuário ' + result.dados[0].ULT_ALTERACAO_USUA + ' em ' + result.dados[0].ULT_ALTERACAO_DTHR);
            if(result.dados[0].ATUALIZA_AUTOMATICO == 'S'){
              $("#vpn #atualiza_automatico").prop('checked','true');
            }
            if(result.dados[0].ATUALIZA_VPN == 'S'){
              $("#vpn #atualiza_vpn").prop('checked', true);
            }
            //Fecha mês
            if(result.dados[0].HAB_FECHA_MES == 'S'){
              $("#vpn #hab_fecha_mes").prop('checked', true);
            }
            //Multi preço
            if(result.dados[0].HAB_MULTI_PRECO == 'S'){
              $("#vpn #hab_multi_preco").prop('checked', true);
            }
            //Estoque novo
            if(result.dados[0].HAB_ESTOQUE_NOVO == 'S'){
              $("#vpn #hab_estoque_novo").prop('checked', true);
            }
            //Atualiza IP Externo
            if(result.dados[0].AA_IPEXTERNO == 'S'){
              $("#vpn #hab_atualiza_ip_externo").prop('checked', true);
            }
            $("#vpn #atualiza_vpn_dthr").val(converteTimestampBRtoUS(result.dados[0].ATUALIZA_VPN_DTHR));
            $("#vpn #atualiza_vpn_compila").val(result.dados[0].ATUALIZA_VPN_COMPILA);
            $("#vpn #atualiza_lista_excluidos").html(result.dados[0].ATUALIZA_LISTA_EXCLUIDOS);
          }

          if(result.t == '2'){
            $("#t2r").val(1);
            var html = '<table class="table table-bordered"><tr><th>MAQUINA</th><th>IP</th><th>SISTEMA OPERACIONAL</th><th>MAC</th><th>LIBERAÇÕES</th><th>AÇÃO</th></tr>';
            var TOT_FUNCAO_ESTACAO = 0;
            var TOT_FUNCAO_NFCE = 0;
            var TOT_FUNCAO_PDO = 0;
            var TOT_FUNCAO_PDV = 0;
            var TOT_FUNCAO_SERVIDOR = 0;
            var TOT_FUNCAO_TEF = 0;

            if(result.dados[0].MAQUINAS_REVISADO == 'S'){
              $('#maquinas_revisadas').prop('checked',true);
            } else {
              $('#maquinas_revisadas').prop('checked',false);
            }

            $.each(result.dados, function(key,value){
              if(value.ID_MAQUINA){
                html += '<tr>';
                html += '<td>'+value.ID_MAQUINA+'</td>';
                html += '<td>'+value.IP_MAQ+'</td>';
                html += '<td>'+value.SIST_OPERAC+'</td>';
                html += '<td>'+value.MAC+'</td>';
                html += '<td><table class="table tbFuncoes"><tr>';
                if(value.FUNCAO_ESTACAO == "S"){ checked_estacao = ' checked="checked" '; TOT_FUNCAO_ESTACAO++;  } else {  checked_estacao = '';  }
                html += '<td><input class="form-control" disabled="disabled"  type="checkbox" '+checked_estacao+' >Estação</td>';
                if(value.FUNCAO_NFCE == "S"){ checked_nfce = ' checked="checked" '; TOT_FUNCAO_NFCE++;  } else {  checked_nfce = '';  }
                html += '<td><input class="form-control" disabled="disabled"  type="checkbox" '+checked_nfce+' >NFCe</td>';
