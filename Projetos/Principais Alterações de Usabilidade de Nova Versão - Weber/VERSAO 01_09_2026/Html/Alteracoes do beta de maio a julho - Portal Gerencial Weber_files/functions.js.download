                      formEdicao += '<tr><th>LIBERAÇÕES</th></tr><tr ><td><input type="checkbox" id="editPDV_tef_usa" name="editPDV_tef_usa" '+checked_tef_usa+'>Usa TEF<br><input type="checkbox" id="editPDV_tef_sitef" name="editPDV_tef_sitef" '+checked_tef_sitef+'>SiTEF<br><input type="checkbox" id="editPDV_tef_tecban" name="editPDV_tef_tecban" '+checked_tef_tecban+'>TecBan<br><input type="checkbox" id="editPDV_tef_hipercard" name="editPDV_tef_hipercard" '+checked_tef_hipercard+'>HiperCard<br><input type="checkbox" id="editPDV_tef_direcao" name="editPDV_tef_direcao" '+checked_tef_direcao+'>Direção<br><input type="checkbox" id="editPDV_tef_visa" name="editPDV_tef_visa" '+checked_tef_visa+'>Visa/RedeCard/Amex<br></td></tr><tr><th><input type="checkbox" name="editPDV_situacao" id="editPDV_situacao" '+checked_bloqueado+'>Bloqueado</th></tr></table><input type="button" class="btn btn-success" onclick="atendimento_cadastro_suporte_edita_pdv(\''+C+'\',\''+T+'\',\''+btoa(
