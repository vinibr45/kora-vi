}


function salvaAlteracaoEstatistica(id){
  var id = document.getElementById("JanelaEst_id").value;
  var num = document.getElementById("JanelaEst_num").value;
  var fechamento_ano_provavel = document.getElementById("JanelaEst_fechamento_ano_provavel").value;
  var fechamento_percentual_chance = document.getElementById("JanelaEst_fechamento_percentual_chance").value;
  carregando(1);
  $.ajax({
    url:"ajax_PropostaEstatisticas.php",
    type:"post",
    dataType:"json",
    data: {id : id, fechamento_ano_provavel : fechamento_ano_provavel, fechamento_percentual_chance : fechamento_percentual_chance },
    success: function (result){
      if(result.status == 1){
        swal("Sucesso", "Estatísticas alterado com sucesso.", "success");
        $('#fechamento_ano_provavel_'+num).val(fechamento_ano_provavel);
        $('#fechamento_percentual_chance_'+num).val(fechamento_percentual_chance);
        carregando(2);
      }else {
        carregando(2);
        swal("Ops..", "Erro ao gravar registro "+result.mensagem, "error");
      }
    }
  });
}

function salvaAlteracao(id){
  var status = document.getElementById("JanelaAlt_status").value;
  var id = document.getElementById("JanelaAlt_id").value;
  var num = document.getElementById("JanelaAlt_num").value;
  var motivo = document.getElementById("JanelaAlt_motivo").value;
  var motivo_id = document.getElementById("JanelaAlt_motivo_id").value;
  if(status == 'A'){
    avisoDown("Não esqueça de criar a movimentação da proposta");
  }
  if(status == 'C' && motivo_id < 1){
    aviso("Você deve informar o motivo do cancelamento.",2);
    return false;
  }
  carregando(1);
  $.ajax({
    url:"ajax_Proposta.php",
    type:"post",
    dataType:"json",
    data: {id : id, status : status, motivo : motivo, motivo_id : motivo_id, },
    success: function (result){
      if(result.status == 1){
        swal("Sucesso", "Status alterado com sucesso.", "success");
        var classe, txt;
        switch(status){
          case 'R':
          classe = 'btn-danger';
          txt = 'Recusada';
          break;
          case 'C':
          classe = 'btn-danger';
          txt = 'Cancelada';
          break;
          case 'P':
          classe = 'btn-warning';
          txt = 'Pendente';
          break;
          case 'A':
          classe = 'btn-success';
          txt = 'Aprovada';
          break;
          case 'E':
          classe = 'btn-primary';
          txt = 'Pré-aprovada';
          break;
        }
        if(result.movimentacao_iniciada == true){
          $("#lbl_mvto_"+num).html('Aprovação do setor comercial');
        }
        $("#status_"+num).html(txt);
        document.getElementById("motivo_"+num).value = motivo;
        $("#status_"+num).removeClass().addClass("btn " + classe);
        $("#status_drop_"+num).removeClass().addClass("btn " + classe + " dropdown-toggle");
        $('#status_prop_'+num).val(status);
        $('#id_motivo_'+num).val(motivo_id);
        carregando(2);
      }else {
        carregando(2);
        swal("Ops..", "Erro ao gravar registro "+result.mensagem, "error");
      }
    }
  });
}

