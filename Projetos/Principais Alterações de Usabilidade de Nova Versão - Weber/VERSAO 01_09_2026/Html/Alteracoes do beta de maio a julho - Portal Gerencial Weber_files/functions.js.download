  var DETALHES_EVENTO = $("#DETALHES_EVENTO").val();
  var ID_MVTO = $("#ID_MVTO").val();

  if(TIPO_EVENTO < 1){ error = "Você deve informar o tipo de evento."; }
  if(!DT_EVENTO){ error = "Você deve informar a data do evento."; }
