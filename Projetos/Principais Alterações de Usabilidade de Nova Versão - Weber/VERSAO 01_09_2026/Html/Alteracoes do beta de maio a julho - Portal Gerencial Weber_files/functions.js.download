function compartilhaToken(CLIENTE, CNPJ, TOKEN, EMAIL, ACAO){

  var PAGE = '';
  switch(ACAO){

    case '3':
    PAGE = 'cancelamento_link';
    break;

    case '4':
    PAGE = 'troca_de_cnpj';
    break;

    case '5':
    PAGE = 'novo_cadastro';
    break;

  }

  var URL = "https://www.weberinfo.com.br/2017/weber/"+ PAGE +".php?acao="+ ACAO +"&token=" + TOKEN + "&cod=" + CLIENTE + "&cnpj=" + CNPJ;
  var DIV_CONTENT = '<table class="table table-striped table-bordered"><tr><th>Cliente</th><th>Token</th></tr><tr><td><input type="text" class="form-control" value="'+CLIENTE+'" readonly="readonly"></td><td><input type="text" class="form-control" readonly="readonly" value="'+TOKEN+'"></td></tr><tr><th colspan="2">URL</th></tr><tr><td colspan="2"><input readonly="readonly" class="form-control" type="text" id="TOKEN_URL" value="'+URL+'"></td></tr><tr><th colspan="2">E-mail</th></tr><tr><td><input type="text" id="TOKEN_EMAIL" value="'+EMAIL+'" class="form-control" ></td><td><button type="button" onclick="enviaToken('+ACAO+')" class="btn btn-success"><i class="glyphicon glyphicon-send"></i>&nbsp;&nbsp;Enviar para e-mail</button></td></tr></table><br><br>';
  $("#modal_compartilha_content").html(DIV_CONTENT);
  $("#modal_compartilha").modal('show');

}

function comparer(index) {
  return function(a, b) {
    var valA = getCellValue(a, index), valB = getCellValue(b, index)
    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
  }
}
function getCellValue(row, index){ return $(row).children('td').eq(index).text() }

function setaOrdenacaoTB(){
  try {
    $('.tr-ordenavel th').click(function(){
      var table = $(this).parents('table').eq(0)
      var rows = table.find('tr:gt(0)').toArray().sort(comparer($(this).index()))
      this.asc = !this.asc
      if (!this.asc){rows = rows.reverse()}
      for (var i = 0; i < rows.length; i++){table.append(rows[i])}
    });
  } catch(err){
    console.log("Erro:" +err);
  }
}

function formataDinheiro(){
  //$("input.dinheiro").maskMoney({ allowZero: true, prefix:'R$ ', thousands:'.', decimal:','});
  // Masking input element to money with options.
  var element = document.getElementsByClassName('dinheiro');
  VMasker(element).maskMoney({
    // Decimal precision -> "90"
    precision: 2,
    // Decimal separator -> ",90"
    separator: ',',
    // Number delimiter -> "12.345.678"
    delimiter: '.',
    // Money unit -> "R$ 12.345.678,90"
    unit: 'R$',
    // Money unit -> "12.345.678,90 R$"
    suffixUnit: '',
    // Force type only number instead decimal,
    // masking decimals with ",00"
    // Zero cents -> "R$ 1.234.567.890,00"
    zeroCents: false
    //TODO devido a esta função usar onkeyup deve-se utilizar onclick pois esta função ira forçar o click no elemento

  });

}

