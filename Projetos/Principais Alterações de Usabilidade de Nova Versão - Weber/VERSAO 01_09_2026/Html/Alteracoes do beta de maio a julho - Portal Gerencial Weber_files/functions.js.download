                function funcionarioEditaPermissoesAtendimento(func){

                  var permissoes = new Array;
                  var divs = document.querySelectorAll('.tipoATENDPerm');
                  for (i = 0; i < divs.length; ++i) {

                    if( divs[i].checked ){
                      permissoes.push({
                        ID_TIPO_ATEND: divs[i].value
                      });
                    }

                  }

                  var permissoesJSON = JSON.stringify(permissoes);
                  var erro = null;
                  if(erro == null){
                    carregando(1);
                    $.ajax({
                      url:"ajax_funcionarioEditaPermissoesAtendimento.php",
                      type:"post",
                      dataType:"json",
                      data: {
                        func : func,
                        permissoes : permissoesJSON,
                      },
                      success: function (result){
                        if(result.status == 1){
                          carregando(2);
                          swal("Sucesso", result.mensagem, "success");
                          funcionarioListaPermissoesAtendimento();
                        } else {
                          carregando(2);
                          swal("Ops..", "Erro na solicitação\n"+result.mensagem, "warning");
                        }
                      }, error: function(result) {
                        carregando(2);
                        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
                      }
                    });

                  } else {
                    swal("Ops..", erro, "warning");
                  }

                }

                function funcionarioEditaPermissoes(func){

                  var permissoes = new Array;
                  var divs = document.querySelectorAll('.ferramentasPerm');
                  for (i = 0; i < divs.length; ++i) {

                    if( divs[i].checked ){
                      permissoes.push({
                        ID_FERRAMENTA: divs[i].value,
                        PERM: $("#"+divs[i].value+"_PERM").val()
