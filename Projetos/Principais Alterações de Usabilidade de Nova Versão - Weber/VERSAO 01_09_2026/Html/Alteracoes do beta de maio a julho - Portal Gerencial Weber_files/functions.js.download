          DT_EVENTO : DT_EVENTO,
          RESUMO_EVENTO : RESUMO_EVENTO,
          DETALHES_EVENTO : DETALHES_EVENTO,
          ID_MVTO : ID_MVTO
        },
        success: function (result){

          var resultado = null;
          try {
            resultado = JSON.parse(result);
            if(resultado.status == 1){
              carregando(2);
              swal("Sucesso", "O evento foi salvo com sucesso.", "success").then(function(value){
                carregando(1);
                location.reload();
              });
            } else {
              carregando(2);
              swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
            }
          } catch(err){
            carregando(2);
            swal("Ops..", "Erro na solicitação\n"+err, "warning");
          }
        }, error: function(result) {
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
        }
      });
    } else {
      swal("Ops..", "Erro ao obter ID", "warning");
    }

  } else {
    aviso(error,2);
  }

}



