                var atendimento_form_detalhes_first_call = 1;
                function atendimento_form_Detalhes(id_cli){
                  var html = '<div style="width:100%;text-align:center;padding:30px;font-size:15px;"><a href="#" onclick="atendimento_form_Detalhes(\''+id_cli+'\');">Tentar novamente</a></div>';
                  if(id_cli){
                    $("#detalhes_clie_FORM").html(setaLoadingModal());
                    $.ajax({
                      url: "ajax_atendimento_DETALHES_form.php",
                      type: "post",
                      dataType: "json",
                      data: {
                        id_cli : id_cli,
                      },
                      success: function (result){

                        if(result.status == 1){

                          var htmlMaquinas = result.htmlDetalhes;

                          html = '<table style="font-size:12px;" class="table table-striped table-bordered"> <tr> <th colspan="4"> Particularidades </th> <th colspan="3"> Máquinas </th> </tr> <tr> <td colspan="4"> <textarea rows="18" id="detalhes_clie_particularidades" readonly="readonly" class="form-control">'+result.mensagem.OBS_PARTICULAR+'</textarea> </td> <td colspan="4"> <textarea rows="18" readonly="readonly" id="detalhes_clie_maquinas" class="form-control">'+htmlMaquinas+'</textarea> </td> </tr> <tr> <th>Nicho</th> <th>Regime</th> <th>PDVs contratados</th> <th>Estações contratadas</th> <th>TEFs contratados</th> <th>NFCes ativos</th> <th>PDO ativos</th> <th>ECF ativos</th> </tr> <tr> <td><input type="text" id="detalhes_clie_nicho" value="'+result.mensagem.CLASSE+'" class="form-control" readonly="readonly"></td> <td><input type="text" id="detalhes_clie_regime" value="'+result.mensagem.REGIME+'" class="form-control" readonly="readonly"></td> <td><input type="text" id="detalhes_clie_pdvs" value="'+result.mensagem.QTD_PDV+'" class="form-control" readonly="readonly"></td> <td><input type="text" id="detalhes_clie_estacoes" value="'+result.mensagem.QTD_ESTACAO+'" class="form-control" readonly="readonly"></td> <td><input type="text" id="detalhes_clie_tef" value="'+result.mensagem.QTD_TEF+'" class="form-control" readonly="readonly"></td> <td><input type="text" id="detalhes_clie_nfce" value="" class="form-control" readonly="readonly"></td> <td><input type="text" id="detalhes_clie_pdo" value="" class="form-control" readonly="readonly"></td> <td><input type="text" id="detalhes_clie_ecf" value="" class="form-control" readonly="readonly"></td> </tr> </table>';
                          atendimento_form_detalhes_first_call = 0;
                        } else {
                          aviso(result.mensagem,2);
                        }
                      },
                      complete:function(result){
                        $('#detalhes_clie_FORM').html( html );
                      },
                      error:function(result){
                        aviso("Verifique sua conexão com internet: \n" + result.statusText,2);
                      }
                    });
                  }
                }

                function atendimento_gravarLista(id_clie){
                  if(id_clie){
                    var data = $("#atendimento_lista_FORM").serialize();
                    if($("#atendimento_lista_FORM #setor").val() < 1){ aviso("Você deve informar o setor resposável.",2); return false;}
                    if(!$("#atendimento_lista_FORM #contato").val()){ aviso("Você deve informar o contato.",2); return false;}
                    if(!$("#atendimento_lista_FORM #descricao").val()){ aviso("Você deve escrever algo sobre este atendimento.",2); return false;}
                    if(data){
                      carregando(1);
                      $.ajax({
                        url: "ajax_atendimento_LISTAESPERA_gerar.php",
                        type: "post",
                        dataType: "json",
                        data: {
                          id_clie : id_clie,
                          data : data,
                        },
                        success: function (result){
                          if(result.status == 1){
                            if( document.URL.includes("portal_gerencial/atendimento_nova_espera") ){
                              window.open('atendimento.php?lista='+result.id_lista_enc+'&setor='+result.setor_lista+'&ms=Lista gerada com sucesso.','_self');
                            } else {
                              carregando(2);
                              aviso("Lista gerada com sucesso",1);
                              swal({
                                title: "Lista gerada com sucesso",
                                text: "Escolha como deseja continuar",
                                icon: "success",
                                buttons: ["Anexar arquivos", "Continuar sem anexar"],
                                dangerMode: false,
                              }).then(function(podeSalvar){
                                if (!podeSalvar) {
                                  window.open('atendimento_anexos.php?id='+result.id_lista_enc,'_blank');
                                }
                              });
                              $("#atendimento_lista_FORM")[0].reset();
                            }
                          } else {
                            carregando(2);
                            swal("Ops..", result.mensagem, "warning");
                          }
                        }, error: function(result) {
                          carregando(2);
                          swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
                        }
                      });
                    } else {
                      aviso("Não foi possível obter os dados do formulário.",2);
                    }

                  } else {
                    aviso("Erro ao obter referências do registro.",3);
                  }
                }



                function atendimento_alertaClienteOS(C){
                  if(C){
                    $.ajax({
                      url: "ajax_atendimentoAlertaCliente.php",
                      type: "post",
                      async: true,
                      dataType: "json",
                      data: {  C : C,  },
                      success: function (result){
                        if(result.status == 1){
                          if(result.qtd > 5){
                            var html = '<div style="width:350px"><label  title="Este alerta aparece quando o cliente atinge 5 atendimentos ou mais em um período de 7 dias." class="btn-warning alertaCliente"><i class="glyphicon glyphicon-exclamation-sign btn-warning" style="padding:5px;border-radius:15px;"></i>Este cliente teve '+result.qtd+' atendimentos na última semana.</label><br><br>';
                            function assuntosComp(a, b) {
                              if (a[1] > b[1]) return -1
                              if (a[1] < b[1]) return 1
                              return 0
                            }
                            var out = new Array();
                            for (var key in result.assuntos){
                              out.push([key,result.assuntos[key]]);
                            }
                            out.sort(assuntosComp);
                            $.each(out, function(key,value){
                              html += "<label class='lblAssuntoOSAlerta'>"+value[0]+" ("+value[1]+")</label>";
                            });
                            html += '</div>';
                            $("#alertaClienteOS").html(html);
                          };
                        }
                      }
                    });
                  }
                }

