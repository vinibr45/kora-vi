  $('#formModalPontoLCTO').on('change', function(){
    G_pontoConfirmacaoBlocoDiferente = false;
  });

  var URL = document.URL;
  if(URL.includes("portal_gerencial/atendimento")){
    $('input').attr('autocomplete', 'off');
  }
  if(URL.includes("portal_gerencial/atendimento_lista_espera_geral") ){
    $('body').append('<style>textarea { resize: vertical; }</style>');
    $(document).click(function(e){
      var LAST_HEIGHT = localStorage.getItem("listaEsperaModal_descricao_os_height");
      if(LAST_HEIGHT){
        $("#listaEsperaModal_descricao_os").attr('style', 'height: '+LAST_HEIGHT+' !important');
      }
    });
    $(document).keydown(function(e){

      //Navegação pelas setas lista de espera
      if( $('#modal_detalhes_atendimentoLista').hasClass('in') && $('#listaEsperaModal_tabHome').hasClass('active')  && !$("#listaEsperaModal_descricao_os").is(":focus") ){
        if((e.keyCode || e.which) == 37){
          $('textarea').blur();
          $('#listaEsperaModal_anterior').click();
        }//left
        if((e.keyCode || e.which) == 39)
        {$('textarea').blur();
        $('#listaEsperaModal_proxima').click();
      }//right
    }

  });
}
