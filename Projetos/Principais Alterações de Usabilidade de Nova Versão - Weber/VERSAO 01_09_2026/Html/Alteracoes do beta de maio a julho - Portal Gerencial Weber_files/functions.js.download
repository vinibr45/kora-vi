function baseName(str)
{
  var base = new String(str).substring(str.lastIndexOf('/') + 1);
  if(base.lastIndexOf(".") != -1)
  base = base.substring(0, base.lastIndexOf("."));
  return base;
}

function removeMvtoListaEspera(id,seq){

  swal({
    title: "Você tem certeza?",
    text: "Não será possível reverter estas alterações.",
    icon: "warning",
    buttons: ["Não", "Sim"],
    dangerMode: false,
  }).then(function(podeRemover){
    if (podeRemover) {
      carregando(1);
      $.ajax({
        url:"ajax_atendimentoListaEsperaMvtos_remove.php",
        type:"post",
        dataType:"json",
        data: {
          id : id,
          seq: seq
        },
        success: function (result){
          var html='';
          if(result.status == 1){
            carregaMvtoListaEspera(id);
          } else {
            swal("Ops..", "Erro na solicitação\n"+result.mensagem, "error");
          }
        }, error: function(result) {
          swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
        }, complete: function(result){
          carregando(2);
        }
      });
    }
  });

}

function insereMvtoListaEspera(id){
  carregando(1);
  $.ajax({
    url:"ajax_atendimentoListaEsperaMvtos_insere.php",
    type:"post",
    dataType:"json",
    data: {
      id : id,
      mvto: $('#atendEsperaMvto_Txt').val(),
      cod_setor : $('#atendEsperaMvto_setor').val(),
      cod_situacao : 0,
      ult_seq_local : $('#atendEsperaMvto_ult_seq_local').val()
    },
    success: function (result){
      var html='';
      if(result.status == 1){
        $('#atendEsperaMvto_Txt').val('');
        carregaMvtoListaEspera(id);
      } else {
        if(result.need_reload){
          carregaMvtoListaEspera(id);
        }
        swal("Ops..", "Erro na solicitação\n"+result.mensagem, "error");
      }
    }, error: function(result) {
      swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
    }, complete: function(result){
      carregando(2);
    }
  });
}

function gerarLinkOS(id_cliente, txt){
  if(id_cliente && txt){

    //base64 decode
    txt = atob(txt);

    $.ajax({
      url:"ajax_atendimentoGeraLinkOS.php",
      type:"post",
      dataType:"json",
      data: {
        id_cliente : id_cliente,
        txt : txt
      },
      beforeSend: function(){
        carregando(1);
      },
      success: function (result){
        if(result.status == 1){
          window.open(result.link, '_blank');
        } else {
          aviso(result.mensagem,3);
        }
      }, error: function(result) {
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      }, complete: function(result){
        carregando(2);
      }
    });
  }
}

function carregaMvtoListaEspera(id){
  $('#atendEsperaMvto_ult_seq_local').val(0);
  $('#atendEsperaMvto_inputDiv').hide();
  if(id){
    $('#modal_detalhes_atendimentoLista #atendEsperaMvto_List').html(setaLoadingModal());
    $('#listaEsperaModal_tabMvto .badge').remove();
    $.ajax({
      url:"ajax_atendimentoListaEsperaMvtos.php",
      type:"post",
      dataType:"json",
      data: {
        id : id
      },
      success: function (result){
        var html='';
        if(result.STATUS == 1){
          var ult_seq_local = 0;
          if(result.DATA[0].ID_REG > 0){
            $.each(result.DATA, function(key,value){
              ult_seq_local = parseInt(value.ID_SEQ) > parseInt(ult_seq_local) ? parseInt(value.ID_SEQ) : parseInt(ult_seq_local);
              html += '<div class="border p-3 mt-2">';
              html += '<p class="p-3 font-weight-bold" style="background:#F0F2F2;">' + value.OBS_MVTO.replaceAll('&#13;&#10;','<br>') + '</p>';
              html += '<hr class="m-1">';
              html += '<div style="font-size:9px;" class="pt-2" >';
              html += 'Inserido em ' + value.DT_MVTO + ' por ' + value.USUA_MVTO + ' ' + value.USUA_MVTO_NOME + ', setor ' + value.COD_SETOR + ' - ' + value.NOME_SETOR + '';
              html += '<a href="#" onclick="removeMvtoListaEspera(\''+id+'\','+value.ID_SEQ+')" class="float-right text-danger"><i class="fas fa-trash mr-2"></i>Remover</a>';
              html += '<a href="#" title="Clique para gerar uma OS" onclick="gerarLinkOS('+value.ID_CLIENTE_LISTA+',\''+btoa(value.OBS_MVTO)+'\')" class="float-right text-primary mr-3"><i class="fas fa-paste mr-2"></i>Gerar OS</a>';
              html += '</div>';
              html += '</div>';
            });

            $('#listaEsperaModal_tabMvto').append('<badge class="badge badge-danger ml-2">'+result.DATA.length+'</badge>');
          } else {
            html = '<h6 class="d-block text-center p-5">Nenhuma movimentação para esta lista.</h6>';
          }
          $('#atendEsperaMvto_ult_seq_local').val(ult_seq_local);
          $('#atendEsperaMvto_inputDiv').show();
        } else {
          html = result.DATA;
        }
        $('#modal_detalhes_atendimentoLista #atendEsperaMvto_List').html(html);
      }, error: function(result) {
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      }, complete: function(result){

      }
    });
  }
}

function getBadgePriorListaGeral(prior){

  switch(prior){

    //Urgente
    case '1':
    return '<i title="Pronto" class="glyphicon glyphicon-fire btn-danger" style="padding:5px;border-radius:15px"></i>';
    break;

    //Importante
    case '2':
    return '<i title="Importante" class="glyphicon glyphicon-exclamation-sign btn-info" style="background-color:#F86605;padding:5px;border-radius:15px;"></i>';
    break;

    //Pronto
    case '3':
    return '<i title="Pronto" class="glyphicon glyphicon-ok btn-success" style="padding:5px;border-radius:15px"></i>';
    break;

    //Novo
    case '9':
    return '<i title="Novo" class="glyphicon glyphicon-certificate btn-warning" style="padding:5px;border-radius:15px;"></i>';
    break;

    //Novo
    case '10':
    return '<i title="Aguardando" class="glyphicon glyphicon-time btn-light" style="background-color:#ccc;padding:5px;border-radius:15px;"></i>';
    break;

  }

}

// Função para gerar uma cor aleatória no formato rgba
function gerarCorAleatoria() {
  const r = Math.floor(Math.random() * 255);
  const g = Math.floor(Math.random() * 255);
  const b = Math.floor(Math.random() * 255);
  return 'rgba('+r+','+g+', '+b+', 0.6)'; // Cor aleatória com opacidade de 0.6
}

// Gera um array de cores aleatórias
function gerarCoresAleatoriasArray(quantidade) {
  var cores = [];
  for (var i = 0; i < quantidade; i++) {
    cores.push(gerarCorAleatoria());
  }
  return cores;
}

function carregaDetalhesListaGeralV2(id, pos, next_prev){

  if(!id){
    id = $('#listaEsperaModal_dtl_'+pos).data('id_lista');
  }

  if(id){

    $.ajax({
      url:"ajax_atendimentoListaEsperaDetalhes.php",
      type:"post",
      dataType:"json",
      data: {
        id : id
      },
      beforeSend: function(result){
        carregando(1);
      },
      success: function (result){
        var html='';
        if(result.status == 1){
          var details = result.atendimento;
          if(details.ID_ATEND != '' && details.RESUMO != '' && details.CLIENTE > 0){

            id = details.ID_ATEND;
            ug = details.UG;
            document.getElementById("listaEsperaModal_cod_atend").innerHTML = details.COD_ATEND;
            document.getElementById("listaEsperaModal_descricao_os").value = details.RESUMO;
            document.getElementById("listaEsperaModal_setor_detalhes").value = details.SETOR;

            document.getElementById("listaEsperaModal_prioridade_detalhes").value = details.PRIORIDADE;
            document.getElementById("listaEsperaModal_tecnico_resp_detalhes").value = details.TECNICO_RESP;

            document.getElementById("listaEsperaModal_nome_detalhes").value = details.NOME;
            document.getElementById("listaEsperaModal_cliente_detalhes").value = details.CLIENTE;
            document.getElementById("listaEsperaModal_prioridade_icon_detalhes").innerHTML = getBadgePriorListaGeral(details.PRIORIDADE);
            document.getElementById("listaEsperaModal_prazo_data_detalhes").value = details.PRAZO_DATA;
            document.getElementById("listaEsperaModal_meta_data_detalhes").value = details.META_DATA;


            document.getElementById("listaEsperaModal_tot_hrs_estimado").value = details.TOT_HRS_ESTIMADO;
            document.getElementById("listaEsperaModal_cliat").value = btoa(details.CLIENTE);
            document.getElementById("listaEsperaModal_setat").value = btoa(details.SETOR);

            var rOBS = '';
            if(details.CLASSE_ATEND == 1){
              rOBS += '<label title="Prioridade de atendimento URGENTE" class="btn btn-danger blink" style="font-size:9px;display:inline;"><i class="glyphicon glyphicon-fire"></i>&nbsp;&nbsp;Urgente</label>';
            }

            document.getElementById("listaEsperaModal_cliePrioritario").innerHTML = rOBS;
            document.getElementById("listaEsperaModal_edit_text").value = 0;
            document.getElementById("listaEsperaModal_descricao_os").disabled = true;

            var current_setor = getURLparameter('s');
            current_setor = ( current_setor != undefined && current_setor != 9999 && current_setor > 0 ) ? current_setor : 0;
            $('#atendEsperaMvto_setor').val(current_setor);

            document.getElementById("listaEsperaModal_divDetalhes").innerHTML =
            "<b>Fone: </b>" + details.FONE + "<br>"
            + "<b>Aberta em </b>" + details.DATA_HORA + " por " +  details.USUA_ABRIU + " - " + details.USUA_ABRIU_NOME + "<br>"
            + "<b>Alterada em </b>" + details.ULT_GRAVACAO + " por " +  details.ULT_USUA + " - " + details.ULT_USUA_NOME + "<br>";

            var now = new Date();

            $('#listaEsperaModal_prazo_data_detalhes').removeClass('data-atrasadaListaEspera');
            var prazoDT = new Date(details.PRAZO_DATA);
            if( now.getTime() > prazoDT.getTime() ){
              $('#listaEsperaModal_prazo_data_detalhes').addClass('data-atrasadaListaEspera');
            }

            $('#listaEsperaModal_meta_data_detalhes').removeClass('data-atrasadaListaEspera');
            var metaDT = new Date(details.META_DATA);
            if( now.getTime() > metaDT.getTime() ){
              $('#listaEsperaModal_meta_data_detalhes').addClass('data-atrasadaListaEspera');
            }

            window.onbeforeunload = function(){ }

            var moreOptions = "<div class='btn-group dropup' style='margin-right:10px'><button type='button' class='btn'>Mais opções</button><button type='button' class='btn dropdown-toggle' data-toggle='dropdown'><span class='caret'></span></button><span class='sr-only'>Clique para expandir</span></button><ul class='dropdown-menu pull-right' role='menu'>";
            moreOptions += "<li><a href='javascript:void(0)' onclick='atendimento_SalvaConfigLayout()' target='_self' >Salvar altura da descrição do atendimento</a></li>";
            moreOptions += "<li><a href='javascript:void(0)' onclick='atendimento_historico_edicao_os(\""+id+"\")' target='_self'>Histórico de edições</a></li>";
            moreOptions += "<li><a href='atendimento_lista_espera.php?cli="+details.CLIENTE_MORE_OPTIONS+"' target='_blank' >Últimas Listas de espera deste cliente</a></li>";
            moreOptions += "<li><a href='atendimento_lista_os.php?cli="+details.CLIENTE_MORE_OPTIONS+"&osptcl="+details.ID_ATEND+"&osptclorg=3' target='_blank' >Listar OS's desta lista</a></li>";
            moreOptions += "<li><a href='#' onclick='baixarAtendimento(\""+id+"\", \""+ug+"\", \""+pos+"\")' target='_self' >Baixar esta lista</a></li>";
            moreOptions += "<li><a href='#' onclick='javascript: $(\"#modal_detalhes_atendimentoLista_close\").attr(\"data-dismiss\", \"modal\");$(\"#modal_detalhes_atendimentoLista_close\").removeAttr(\"onclick\");carregaDetalhesListaGeralV2(\""+id+"\","+pos+")'>Cancelar as alterações</a></li>";
            moreOptions += "<li><a href='#' onclick='javascript: window.open(\"atendimento_anexos.php?id="+id+"\",\"_blank\")'>Anexar arquivo</a></li>";
            moreOptions += "<li><a href='#' onclick='javascript: window.open(\"atendimento_registrar.php?cli="+details.CLIENTE_MORE_OPTIONS+"&lista="+details.ID_ATEND+"\",\"_blank\")'>Gerar atividade</a></li>";
            if( details.CAN_EDIT_TEXT == true ){
              moreOptions += "<li><a href='#' onclick='javascript: document.getElementById(\"listaEsperaModal_edit_text\").value = 1;document.getElementById(\"listaEsperaModal_descricao_os\").disabled = false;'>Editar descrição do chamado</a></li>";
            }
            moreOptions += "</ul></div>";

            moreOptions += "<a style='margin-right:5px;' class='btn btn-normal' onclick='imprimeDIVstyled(\"modal_detalhes_atendimentoLista\")'><i class='glyphicon glyphicon-print'></i>&nbsp;&nbsp;Imprimir</a>";

            if(details.QTD_IMG > 0){
              btnImg = "<a style='margin-right:10px' class='btn btn-primary' href='atendimento_anexos.php?id="+id+"' target='_blank'>Anexos da lista de espera</a>";
            } else {
              btnImg = '';
            }

            document.getElementById("listaEsperaModal_botoes").innerHTML = "<button type='button' id='listaEsperaModal_anterior' onclick='carregaDetalhesListaGeralV2(null,"+(pos-1)+",\"prev\")' class='btn btn-normal' />Anterior</button>&nbsp;<button type='button' onclick='carregaDetalhesListaGeralV2(null,"+(pos+1)+", \"next\")' id='listaEsperaModal_proxima' class='btn btn-normal' />Próxima</button><div style='display:inline;float:right;'>"+btnImg+moreOptions+"<button class='btn btn-success' id='btn_salvaEditAtend' style='float:right' type='button'><i class='glyphicon glyphicon-save'></i>&nbsp;&nbsp;Salvar alterações</button></div><br><br>" ;

            $('#modal_detalhes_atendimentoLista .nav-tabs a[href="#home"]').tab('show');
            $('#atendEsperaMvto_inputDiv').hide();
            $('#atendEsperaMvto_Txt').val('');
            $('#listaEsperaModal_tabMvto .badge').remove();
            $('#listaEsperaModal_tabMvto').append('<badge class="badge badge-' + ( details.QTD_MVTO > 0 ? 'danger' : 'secondary' ) + ' ml-2">' + details.QTD_MVTO + '</badge>');

            if(id != ''){
              $("#btn_salvaEditAtend").attr('onclick', 'salvarEdicaoLista(\''+id+'\', \''+ug+'\', \''+pos+'\')');
              $('#listaEsperaModal_tabMvto').attr('onclick', 'carregaMvtoListaEspera(\''+id+'\')');
              $('#atendEsperaMvto_btnInsere').attr('onclick', 'insereMvtoListaEspera(\''+id+'\')')
            } else {
              $("#btn_salvaEditAtend").attr('onclick', null);
              $('#listaEsperaModal_tabMvto').attr('onclick', null);
              $('#atendEsperaMvto_btnInsere').attr('onclick', null)
            }

            $(document).on('hide.bs.modal','#modal_detalhes_atendimentoLista', function () {
              $('input').blur();
              $('textarea').blur();
              var attr = $("#modal_detalhes_atendimentoLista_close").attr('data-dismiss');
              if (attr != 'modal') {
                aviso('Você deve salvar as alterações antes de ir para outra lista.',2);
                return false;
              }
            });

            $("#modal_detalhes_atendimentoLista #home").on("change", function(event) {
              $("#listaEsperaModal_anterior").attr('onclick', 'aviso(\'Você deve salvar as alterações antes de ir para outra lista.\',2)');
              $("#listaEsperaModal_proxima").attr('onclick', 'aviso(\'Você deve salvar as alterações antes de ir para outra lista.\',2)');
              $("#modal_detalhes_atendimentoLista_close").removeAttr('data-dismiss');
              $("#modal_detalhes_atendimentoLista_close").attr('onclick', 'aviso(\'Você deve salvar as alterações antes de fechar esta janela.\',2)');
              window.onbeforeunload = function(){
                return 'Tem certeza que deseja sair desta página ?';
              }
            });


            $("#modal_detalhes_atendimentoLista").modal('show');


          } else {
            aviso("Nenhum registro aberto localizado",2);
            carregando(2);
            resetaDetalhesListaGeral(pos);

          }
        } else {
          aviso(result.mensagem,3);
        }
      }, error: function(result) {
        swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
      }, complete: function(result){
        carregando(2);
      }
    });

  } else {
    console.log("Não foi possível obter o ID de registro.");
    $('#modal_detalhes_atendimentoLista').modal('close');
  }

}

function carregaDetalhesListaGeral(pos){

  try {
    el_details = 'listaEsperaModal_dtl_'+pos;
    details =  JSON.parse( atob( document.getElementById(el_details).value ) );
    if(details.ID_ATEND != '' && details.RESUMO != '' && details.CLIENTE > 0){

      id = details.ID_ATEND;
      ug = details.UG;
      document.getElementById("listaEsperaModal_cod_atend").innerHTML = details.COD_ATEND;
      document.getElementById("listaEsperaModal_descricao_os").value = details.RESUMO;
      document.getElementById("listaEsperaModal_setor_detalhes").value = details.SETOR;
      document.getElementById("listaEsperaModal_status_detalhes").value = details.STATUS;
      document.getElementById("listaEsperaModal_ult_gravacao_detalhes").value = details.ULT_GRAVACAO;
      document.getElementById("listaEsperaModal_data_detalhes").value = details.DATA_HORA;
      document.getElementById("listaEsperaModal_prioridade_detalhes").value = details.PRIORIDADE;
      document.getElementById("listaEsperaModal_tecnico_resp_detalhes").value = details.TECNICO_RESP;
      document.getElementById("listaEsperaModal_fone_detalhes").innerHTML = details.FONE;
      document.getElementById("listaEsperaModal_nome_detalhes").value = details.NOME;
      document.getElementById("listaEsperaModal_cliente_detalhes").value = details.CLIENTE;
      document.getElementById("listaEsperaModal_prioridade_icon_detalhes").innerHTML = atob(details.PRIORIDADE_ICON);
      document.getElementById("listaEsperaModal_prazo_data_detalhes").value = details.PRAZO_DATA;
      document.getElementById("listaEsperaModal_meta_data_detalhes").value = details.META_DATA;
      document.getElementById("listaEsperaModal_dt_criacao_us_detalhes").value = details.DT_CRIACAO_US;
      document.getElementById("listaEsperaModal_usua_abriu_detalhes").value = details.USUA_ABRIU;
      document.getElementById("listaEsperaModal_usua_abriu_detalhes").title = details.USUA_ABRIU_NOME;
      document.getElementById("listaEsperaModal_ult_usua_detalhes").value = details.ULT_USUA;
      document.getElementById("listaEsperaModal_ult_usua_detalhes").title = details.ULT_USUA_NOME;
      document.getElementById("listaEsperaModal_tot_hrs_estimado").value = details.TOT_HRS_ESTIMADO;
      document.getElementById("listaEsperaModal_cliat").value = btoa(details.CLIENTE);
      document.getElementById("listaEsperaModal_setat").value = btoa(details.SETOR);

      window.onbeforeunload = function(){ }

      var moreOptions = "<div class='btn-group dropup' style='margin-right:10px'><button type='button' class='btn'>Mais opções</button><button type='button' class='btn dropdown-toggle' data-toggle='dropdown'><span class='caret'></span></button><span class='sr-only'>Clique para expandir</span></button><ul class='dropdown-menu pull-right' role='menu'>";
      moreOptions += "<li><a href='javascript:void(0)' onclick='atendimento_SalvaConfigLayout()' target='_self' >Salvar altura da descrição do atendimento</a></li>";
      moreOptions += "<li><a href='javascript:void(0)' onclick='atendimento_historico_edicao_os(\""+id+"\")' target='_self'>Histórico de edições</a></li>";
      moreOptions += "<li><a href='atendimento_lista_espera.php?cli="+details.CLIENTE_MORE_OPTIONS+"' target='_blank' >Últimas Listas de espera deste cliente</a></li>";
      moreOptions += "<li><a href='atendimento_lista_os.php?cli="+details.CLIENTE_MORE_OPTIONS+"&osptcl="+details.ID_ATEND+"&osptclorg=3' target='_blank' >Listar OS's desta lista</a></li>";
      moreOptions += "<li><a href='#' onclick='baixarAtendimento(\""+id+"\", \""+ug+"\", \""+pos+"\")' target='_self' >Baixar esta lista</a></li>";
      moreOptions += "<li><a href='#' onclick='javascript: $(\"#modal_detalhes_atendimentoLista_close\").attr(\"data-dismiss\", \"modal\");$(\"#modal_detalhes_atendimentoLista_close\").removeAttr(\"onclick\");carregaDetalhesListaGeral("+pos+")'>Cancelar as alterações</a></li>";
      moreOptions += "<li><a href='#' onclick='javascript: window.open(\"atendimento_anexos.php?id="+id+"\",\"_blank\")'>Anexar arquivo</a></li>";
      moreOptions += "</ul></div>";
      moreOptions += "<a style='margin-right:5px;' class='btn btn-normal' onclick='imprimeDIVstyled(\"modal_detalhes_atendimentoLista\")'><i class='glyphicon glyphicon-print'></i>&nbsp;&nbsp;Imprimir</a>";

      if(details.QTD_IMG > 0){
        btnImg = "<a style='margin-right:10px' class='btn btn-primary' href='atendimento_anexos.php?id="+id+"' target='_blank'>Anexos da lista de espera</a>";
      } else {
        btnImg = '';
      }

      document.getElementById("listaEsperaModal_botoes").innerHTML = "<button type='button' id='listaEsperaModal_anterior' onclick='carregaDetalhesListaGeral("+(pos-1)+", \"prev\")' class='btn btn-normal' />Anterior</button>&nbsp;<button type='button' onclick='carregaDetalhesListaGeral("+(pos+1)+", \"next\")' id='listaEsperaModal_proxima' class='btn btn-normal' />Próxima</button><div style='display:inline;float:right;'>"+btnImg+moreOptions+"<button class='btn btn-success' id='btn_salvaEditAtend' style='float:right' type='button'><i class='glyphicon glyphicon-save'></i>&nbsp;&nbsp;Salvar alterações</button></div><br><br>" ;

      $('#modal_detalhes_atendimentoLista .nav-tabs a[href="#home"]').tab('show');
      $('#atendEsperaMvto_inputDiv').hide();
      $('#atendEsperaMvto_Txt').val('');
      $('#listaEsperaModal_tabMvto .badge').remove();
      $('#listaEsperaModal_tabMvto').append('<badge class="badge badge-'+(details.QTD_MVTO > 0 ? 'danger' : 'secondary')+' ml-2">'+details.QTD_MVTO+'</badge>');

      if(id != ''){
        $("#btn_salvaEditAtend").attr('onclick', 'salvarEdicaoLista(\''+id+'\', \''+ug+'\', \''+pos+'\')');
        $('#listaEsperaModal_tabMvto').attr('onclick', 'carregaMvtoListaEspera(\''+id+'\')');
        $('#atendEsperaMvto_btnInsere').attr('onclick', 'insereMvtoListaEspera(\''+id+'\')')
      } else {
        $("#btn_salvaEditAtend").attr('onclick', null);
        $('#listaEsperaModal_tabMvto').attr('onclick', null);
        $('#atendEsperaMvto_btnInsere').attr('onclick', null)
      }

      $(document).on('hide.bs.modal','#modal_detalhes_atendimentoLista', function () {
        $('input').blur();
        $('textarea').blur();
        var attr = $("#modal_detalhes_atendimentoLista_close").attr('data-dismiss');
        if (attr != 'modal') {
          aviso('Você deve salvar as alterações antes de ir para outra lista.',2);
          return false;
        }
      });

      $("#modal_detalhes_atendimentoLista #home").on("change", function(event) {
        $("#listaEsperaModal_anterior").attr('onclick', 'aviso(\'Você deve salvar as alterações antes de ir para outra lista.\',2)');
        $("#listaEsperaModal_proxima").attr('onclick', 'aviso(\'Você deve salvar as alterações antes de ir para outra lista.\',2)');
        $("#modal_detalhes_atendimentoLista_close").removeAttr('data-dismiss');
        $("#modal_detalhes_atendimentoLista_close").attr('onclick', 'aviso(\'Você deve salvar as alterações antes de fechar esta janela.\',2)');
        window.onbeforeunload = function(){
          return 'Tem certeza que deseja sair desta página ?';
        }
      });

    } else {
      resetaDetalhesListaGeral(pos);
    }
  } catch(err){
    if(pos > 0){
      carregaDetalhesListaGeral(pos-1);
    }
  }

}

function atendimento_SalvaConfigLayout(){
  var $element = $("#listaEsperaModal_descricao_os");
  LAST_HEIGHT = $element.css('height');
  localStorage.setItem('listaEsperaModal_descricao_os_height',LAST_HEIGHT);
  avisoDown("Configuração salva com sucesso.");
}

function inputOnlyNumber(evt)
{

  var charCode = (evt.which) ? evt.which : evt.keyCode;
  if (charCode > 31  && (charCode < 48 || charCode > 57)){

    return false;

  }else{
    //
    return true;

  }

}

function salvarEdicaoLista(ID, UG, POS){

  if(ID != '' && UG != ''){

    var ERROR = null;
    var PRIORIDADE = $("#listaEsperaModal_prioridade_detalhes").val();
    var SETOR = $("#listaEsperaModal_setor_detalhes").val();
    var RESPONSAVEL = $("#listaEsperaModal_tecnico_resp_detalhes").val();
    var CLIENTE = $("#listaEsperaModal_cliente_detalhes").val();
    var NOME = $("#listaEsperaModal_nome_detalhes").val();
    var DESCRICAO = $("#listaEsperaModal_descricao_os").val();
    var PRAZO_DATA = $("#listaEsperaModal_prazo_data_detalhes").val();
    var META_DATA = $("#listaEsperaModal_meta_data_detalhes").val();
    var DT_CRIACAO = $("listaEsperaModal_#dt_criacao_us_detalhes").val();
    var TOT_HRS_ESTIMADO = $("#listaEsperaModal_tot_hrs_estimado").val();
    var CLIAT = atob($("#listaEsperaModal_cliat").val());
    var SETAT = atob($("#listaEsperaModal_setat").val());
    var EDIT_TEXT = $('#listaEsperaModal_edit_text').val();
    if(!CLIAT){ ERROR = "Erro L1421 ao verificar integridade."; }
    if(PRIORIDADE < 1){ ERROR = "Não foi possível obter a PRIORIDADE."; }
    if(SETOR < 1){ ERROR = "Não foi possível obter o SETOR."; }
    if(CLIENTE < 1 && !NOME){ ERROR = "Não foi possível obter o NOME.";}
    if(!DESCRICAO){ ERROR = "Não foi possível obter a DESCRIÇÃO."; }
    if(!PRAZO_DATA){ ERROR = "Não foi possível obter o PRAZO DATA."; }
    if(!META_DATA){ ERROR = "Não foi possível obter a META DATA."; }
    if(META_DATA < DT_CRIACAO || PRAZO_DATA < DT_CRIACAO) { ERROR = "O PRAZO DATA e META DATA devem ser superiores a data da criação."; }
    if(ERROR == null){
      carregando(1);
      $.ajax({
        url:"ajax_atendimentoSalvarEdicaoLista.php",
        type:"post",
        timeout:10000,
        data: {
          ID : ID,
          CLIAT : CLIAT,
          UG : UG,
          PRIORIDADE : PRIORIDADE,
          CLIENTE : CLIENTE,
          NOME : NOME,
          DESCRICAO : DESCRICAO,
          SETOR : SETOR,
          NOME : NOME,
          RESPONSAVEL : RESPONSAVEL,
          PRAZO_DATA : PRAZO_DATA,
          META_DATA : META_DATA,
          TOT_HRS_ESTIMADO : TOT_HRS_ESTIMADO,
          EDIT_TEXT : EDIT_TEXT
        },
        success: function (result){
          var resultado = null;
          try {
            resultado = JSON.parse(result);
            if(resultado.status == 1){
              carregando(2);
              aviso(resultado.mensagem,1);
              $("#modal_detalhes_atendimentoLista_close").attr('data-dismiss','modal');
              $("#modal_detalhes_atendimentoLista_close").removeAttr('onclick');
              if( document.URL.includes("atendimento_registrar.php") ){
                atendimentoStatusCliente( getURLparameter('cli') );
              } else {
                if(SETAT != SETOR){
                  removeTRatend(POS);
                } else {
                  if( !document.URL.includes("ntfPulseItem.php") ){
                    atendimentoListaEsperaGeral($('#filtroSetor').val(), getURLparameter('o') );
                  }
                }
              }
              $('#modal_detalhes_atendimentoLista').modal('hide');
            } else {
              carregando(2);
              swal("Ops..", resultado.mensagem, "warning");
            }
          } catch(err){
            carregando(2);
            swal("Ops..", "L2685 Erro na solicitação\n"+err, "warning");
          }
        }, error: function(result) {
          carregando(2);
          swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
        }

      });
    } else {
      aviso(ERROR, 2);
    }

  } else {
    aviso("Erro ao obter dados do atendimento", 2);
  }

}


function baixarAtendimento(ID, UG, POS){

  if(ID != '' && UG != ''){
    swal({
      title: "Você tem certeza?",
      text: "Não será possível reverter estas alterações.",
      icon: "warning",
      buttons: ["Não", "Sim"],
      dangerMode: false,
    }).then(function(podeSalvar){
      if (podeSalvar) {
        carregando(1);
        $.ajax({
          url:"ajax_atendimentoBaixarLista.php",
          type:"post",
          data: {
            ID : ID,
            UG : UG
          },
          success: function (result){
            var resultado = null;
            try {
              resultado = JSON.parse(result);
              if(resultado.status == 1){
                carregando(2);
                swal("Sucesso", "Lista baixada com sucesso.", "success");
                //location.reload();
                removeTRatend(POS);
              } else {
                carregando(2);
                swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
              }

            } catch(err){
              carregando(2);
              swal("Ops..", "Erro na solicitação\n"+err, "warning");
            }
          }, error: function(result) {
            carregando(2);
            swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
          }

        });
      }
    });
  }

}


function restaurarAtendimento(ID){

  swal({
    title: "Você tem certeza?",
    text: "Não será possível reverter estas alterações.",
    icon: "warning",
    buttons: ["Não", "Sim"],
    dangerMode: false,
  }).then(function(podeSalvar){
    if (podeSalvar) {
      if(ID){
        carregando(1);
        $.ajax({
          url:"ajax_atendimentoRestaurarLista.php",
          type:"post",
          data: {
            ID : ID
          },
          success: function (result){
            var resultado = null;
            try {
              resultado = JSON.parse(result);
              if(resultado.status == 1){
                carregando(2);
                swal("Sucesso", "Lista restaurada com sucesso.", "success");
                location.reload();
              } else {
                carregando(2);
                swal("Ops..", "Erro na solicitação\n"+resultado.mensagem, "warning");
              }

            } catch(err){
              carregando(2);
              swal("Ops..", "Erro na solicitação\n"+err, "warning");
            }
          }, error: function(result) {
            carregando(2);
            swal("Ops..", "Erro na solicitação\n"+result.statusText, "error");
          }
        });
      } else {
        aviso("Erro ao obter os dados para restaurar o atendimento.", 2);
      }

    }
  });

}

function criaModalDetalhesCli(){
  criaModal("modalDetalhesCli", "Detalhes do cliente", "modal-lg");
  $('#modalDetalhesCli_content').html('<table width="100%" class="table table-bordered table-striped"><tr> <th><i class="glyphicon glyphicon-user"></i>&nbsp;&nbsp;Cliente</th> <th>Fantasia</th> <th>Cnpj</th> </tr> <tr> <td width="100px"><input disabled="disabled" type="text" maxlength="4" class="form-control" id="id_cliente_detalhes"></td> <td><input disabled="disabled" type="text" class="form-control" id="fantasia_cliente_detalhes" maxlength="50"></td> <td><input disabled="disabled" type="text" class="form-control" id="cnpj_cliente_detalhes" maxlength="50"></label></td> </tr> <tr> <th>UF</th> <th>Cidade</th> <th>Classe</th> </tr> <tr> <td width="100px"><input disabled="disabled" type="text" maxlength="4" class="form-control" id="uf_cliente_detalhes"></td> <td><input disabled="disabled" type="text" class="form-control" id="cidade_cliente_detalhes" maxlength="50"></td> <td><input disabled="disabled" type="text" class="form-control" id="nome_classe_cliente_detalhes" maxlength="50"></label></td> </tr> <tr> <th colspan="2"><i class="glyphicon glyphicon-house"></i>Endereço</th> <th>Contato</th> </tr> <tr> <td colspan="2" ondbclick="javascript:  window.open(\'https://www.google.com.br/maps/place/'+$('#endereco_cliente_detalhes').val()+'\',\'_blank\')" ><input type="text" disabled="disabled" id="endereco_cliente_detalhes"  title="Dois clicks para abrir no GOOGLE MAPS" class="form-control"></td> <td><input type="text" disabled="disabled" id="contato_cliente_detalhes" class="form-control"></td> </tr> <tr> <td colspan="3"> <label class="foneOS" id="atendBtnDetailsFone"><i class="glyphicon glyphicon-phone"></i>&nbsp;Listar todos contatos</label> </td> </tr> </table> <table class="table table-striped table-bordered"> <tr> <th>Observações</th> </tr> <tr> <td> <textarea id="obs_cliente_detalhes" disabled="disabled" name="obs_cliente_detalhes" class="form-control" rows="7" ></textarea> </td> </tr> </table><br><br>');
  $('#modalDetalhesCli').modal('show');
}

function atendDetalhesCli(pos){

  criaModalDetalhesCli();

  el_details = 'dtl_'+pos;
  details =  JSON.parse( atob(document.getElementById(el_details).value) );

  $("#nome_razao_detalhes").html(details.NOME_RAZAO + ' - LOJA : ' + details.LOJA);
  $("#id_cliente_detalhes").val(details.ID_CLIENTE);
  $("#fantasia_cliente_detalhes").val(details.FANTASIA);
  $("#cnpj_cliente_detalhes").val(details.CNPJ_CPF);
  $("#uf_cliente_detalhes").val(details.UF);
  $("#cidade_cliente_detalhes").val(details.CIDADE);
  $("#nome_classe_cliente_detalhes").val(details.NOME_CLASSE);
  $("#endereco_cliente_detalhes").val(details.ENDERECO + ', Num: ' + details.ENDER_NUM + ' Bairro: ' + details.BAIRRO + ' - ' + details.CIDADE + ' - CEP: ' + details.CEP);
  $("#contato_cliente_detalhes").val(details.CONTATO);
  $("#obs_cliente_detalhes").val(details.OBS_SUPORTE);

  $("#atendBtnDetailsFone").attr('onclick', 'atendimento_ListaContatos('+ details.ID_CLIENTE +')');


}

function atendConfirmaVend_Repr(pos){
  swal({
    title: "Re-locadora responsável pelo suporte",
    text: "Deseja continuar ? .",
    icon: "warning",
    buttons: ["Não", "Sim"],
    dangerMode: false,
  }).then(function(podeSalvar){
    if (podeSalvar) {
      $("#btnDpd_"+pos).removeAttr('onclick');
      $("#btnDpd_"+pos).attr('data-toggle', 'dropdown');
      $("#btnDpd_"+pos).click();
    }
  });
}

function formUploadDocumento(origem, cliente, tipo){

  function setaModalUploadDocumento(){
    var modal = '<div class="modal fade" id="modal_upload_documento" style="background-color: rgba(0,0,0,0.5);" role="dialog" style="z-index:1100 !important;"><div class="modal-dialog" style="width:750px; z-index:1101 !important;"><div class="modal-content"> <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button> <h4 class="modal-title">Carregar documento</h4></div><div class="modal-body" id="modal_upload_documento_content" style="padding:10px"></div></div></div></div>';
    $('body').append(modal);
  }

  if ($("#modal_upload_documento").length === 0){
    setaModalUploadDocumento();
  }

  var disCli = null;
  var disTipo = null;
  var disPriv = null;

  //TIPO = OS(3), OUTROS(99)
  if(tipo == 3 || tipo == 99){
    disTipo = " disabled='disabled' ";
    disPriv = " disabled='disabled' ";
  }

  var tipos = JSON.parse( atob( $("#dcs").val() ) ); var select;
  select  = '<select '+disTipo+' class="form-control" id="arqUpload_tipo">';
  select += '<option>Selecione..</option>';
  $.each( tipos, function( key, value ) {
    select += '<option value="'+value.ID_TIPO+'">'+value.DESCRICAO+'</option>';
  });
  select += '</select>';

  if(cliente > 0){
    disCli = " disabled='disabled' value='"+cliente+"' ";
  }

  var form = '<form action=" method="post" id="formUploadDOCUMENTO"  enctype="multipart/form-data"><table class="table table-striped table-bordered"><tr><th>Arquivo</th><th>Privacidade</th><th>Tipo de documento</th></tr>';
  form += '<tr><td><input  type="file" required="required" id="arqUpload" name="arqUpload"></td><td><select class="form-control" name="arqUpload_exibition" '+disPriv+' required="required" id="arqUpload_exibition"><option value="">Selecione..</option><option value="N">Privado</option><option value="S">Público</option></select></td><td>'+select+'</td></tr>';
  form += '<tr><th>Cliente</th><th colspan="2">Legenda</th></tr>';
  form += '<tr><td><input type="number" '+disCli+' id="arqUpload_cod_clie" class="form-control" ></td><td colspan="2"><input type="text" class="form-control" maxlength="50" id="arqUpload_legenda" name="arqUpload_legenda"></td></tr>';
  form += '<tr><th colspan="3"><button type="button" name="arqUpload_send" class="btn btn-success" onclick="uploadDocumento()"><i class="glyphicon glyphicon-floppy-disk"></i>&nbsp;&nbsp;Carregar</button></th></tr>';
  form += '</table>';
  form += '<input type="hidden" value="'+origem+'" id="arqUpload_origem" name="arqUpload_origem">';
  form += '</form>';
  $("#modal_upload_documento_content").html(form);

  //TIPO = OS
  if(tipo == 3){
    $("#arqUpload_exibition").val('S');
    $("#arqUpload_tipo").val(tipo);
  }
  //TIPO OUTROS
  if(tipo == 99){
    $("#arqUpload_exibition").val('N');
    $("#arqUpload_tipo").val(tipo);
  }

}

