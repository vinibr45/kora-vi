function alterarAtualizacaoUrgente(ID_APP, HASH_SHA256, ATUALIZACAO_URGENTE_ATUAL){
  if(ID_APP && HASH_SHA256){
    carregando(1);
    criaModal('modalAtualizacaoUrgente', 'Alterar atualização urgente - ' + ID_APP);
    
    var statusTexto = ATUALIZACAO_URGENTE_ATUAL == 1 ? 'Sim' : 'Não';
    var novoStatus = ATUALIZACAO_URGENTE_ATUAL == 1 ? 0 : 1;
    var novoStatusTexto = novoStatus == 1 ? 'Sim' : 'Não';
    
    var html = '<form id="formAtualizacaoUrgente" class="form-horizontal">';
    html += '<div class="form-group">';
    html += '<label class="col-sm-4 control-label">ID do Aplicativo</label>';
    html += '<div class="col-sm-8">';
    html += '<input type="text" class="form-control" value="' + ID_APP + '" readonly>';
    html += '</div></div>';
    
    html += '<div class="form-group">';
    html += '<label class="col-sm-4 control-label">Status atual</label>';
    html += '<div class="col-sm-8">';
    html += '<input type="text" class="form-control" value="' + (ATUALIZACAO_URGENTE_ATUAL == 1 ? 'Sim - Atualização Urgente' : 'Não - Atualização Normal') + '" readonly>';
    html += '</div></div>';
    
    html += '<div class="form-group">';
    html += '<label class="col-sm-4 control-label">Novo status</label>';
    html += '<div class="col-sm-8">';
    html += '<input type="text" class="form-control" value="' + (novoStatus == 1 ? 'Sim - Atualização Urgente' : 'Não - Atualização Normal') + '" readonly>';
    html += '</div></div>';
    
    html += '<hr>';
    html += '<div class="text-right">';
    html += '<button type="button" class="btn btn-default" data-dismiss="modal"><i class="glyphicon glyphicon-remove mr-2"></i>Cancelar</button>';
        html += '&nbsp;&nbsp;';
    html += '<button type="button" class="btn btn-success" onclick="confirmarAtualizacaoUrgente(\'' + HASH_SHA256 + '\', ' + novoStatus + ')"><i class="glyphicon glyphicon-ok mr-2"></i>Confirmar alteração</button>';
    html += '</div>';
    html += '<hr>';
    html += '</form>';
    
    $("#modalAtualizacaoUrgente_content").html(html);
    $("#modalAtualizacaoUrgente").modal('show');
    carregando(2);
  } else {
    aviso("Erro ao obter dados da versão.",2);
  }
}

function confirmarAtualizacaoUrgente(HASH_SHA256, NOVO_STATUS){
  if(HASH_SHA256){
    carregando(1);
    $.ajax({
      url:"appsWeberBetaChangeUrgentUpdate.php",
      type:"get",
      data: {
        hashsha256 : HASH_SHA256,
        atualizacaoUrgente : NOVO_STATUS,
        prevUrl : btoa(window.location.href)
      },
      success: function (result){
        //Se result começa com OK: é sucesso, caso contrário é erro
        if(result.substring(0,3) == "OK:"){
        carregando(2);
        $("#modalAtualizacaoUrgente").modal('hide');
        aviso("Atualização urgente alterada com sucesso!",1);
        location.reload();
        } else {
          carregando(2);
          aviso("Erro ao processar a solicitação.\n" + result,3);
        }
      }, error: function(result) {
        carregando(2);
        $("#modalAtualizacaoUrgente").modal('hide');
        aviso("Erro ao processar a solicitação.\n" + result.statusText,3);
      }
    });
  } else {
    aviso("Erro ao processar a solicitação.",3);
  }
}

