        H : H
      },
      success: function (result){
        var resultado = null;
        var doc = null;
        try {
          resultado = JSON.parse(result);
          if(resultado.status == 1){
            if(resultado.ext.includes("image")){
              doc = "<img width='100%' src='data:image/jpeg;base64,"+resultado.conteudo+"'>";
            } else {
              if(resultado.ext.includes("xml")){
                window.open('ajax_documentoIframe.php', '_blank');
              } else {
                doc = "<iframe src='ajax_documentoIframe.php' width='100%' height='500px'></iframe>"
              }
