// SparkMD5 ArrayBuffer implementation
var SparkMD5 = (function() {
    // MD5 helper functions
    function safeAdd(x, y) {
        var lsw = (x & 0xFFFF) + (y & 0xFFFF);
        var msw = (x >> 16) + (y >> 16) + (lsw >> 16);
        return (msw << 16) | (lsw & 0xFFFF);
    }

    function md5cmn(q, a, b, x, s, t) {
        return safeAdd(bitRotateLeft(safeAdd(safeAdd(a, q), safeAdd(x, t)), s), b);
    }

    function md5ff(a, b, c, d, x, s, t) {
        return md5cmn((b & c) | ((~b) & d), a, b, x, s, t);
    }

    function md5gg(a, b, c, d, x, s, t) {
        return md5cmn((b & d) | (c & (~d)), a, b, x, s, t);
    }

    function md5hh(a, b, c, d, x, s, t) {
        return md5cmn(b ^ c ^ d, a, b, x, s, t);
    }

    function md5ii(a, b, c, d, x, s, t) {
        return md5cmn(c ^ (b | (~d)), a, b, x, s, t);
    }

    function bitRotateLeft(num, cnt) {
        return (num << cnt) | (num >>> (32 - cnt));
    }

    function binlMD5(x, len) {
        x[len >> 5] |= 0x80 << (len % 32);
        x[(((len + 64) >>> 9) << 4) + 14] = len;

        var a = 1732584193,
            b = -271733879,
            c = -1732584194,
            d = 271733878;

        for (var i = 0; i < x.length; i += 16) {
            var olda = a,
                oldb = b,
                oldc = c,
                oldd = d;

            a = md5ff(a, b, c, d, x[i + 0], 7, -680876936);
            d = md5ff(d, a, b, c, x[i + 1], 12, -389564586);
            c = md5ff(c, d, a, b, x[i + 2], 17, 606105819);
            b = md5ff(b, c, d, a, x[i + 3], 22, -1044525330);
            a = md5ff(a, b, c, d, x[i + 4], 7, -176418897);
            d = md5ff(d, a, b, c, x[i + 5], 12, 1200080426);
            c = md5ff(c, d, a, b, x[i + 6], 17, -1473231341);
            b = md5ff(b, c, d, a, x[i + 7], 22, -45705983);
            a = md5ff(a, b, c, d, x[i + 8], 7, 1770035416);
            d = md5ff(d, a, b, c, x[i + 9], 12, -1958414417);
            c = md5ff(c, d, a, b, x[i + 10], 17, -42063);
            b = md5ff(b, c, d, a, x[i + 11], 22, -1990404162);
            a = md5ff(a, b, c, d, x[i + 12], 7, 1804603682);
            d = md5ff(d, a, b, c, x[i + 13], 12, -40341101);
            c = md5ff(c, d, a, b, x[i + 14], 17, -1502002290);
            b = md5ff(b, c, d, a, x[i + 15], 22, 1236535329);

            a = md5gg(a, b, c, d, x[i + 1], 5, -165796510);
            d = md5gg(d, a, b, c, x[i + 6], 9, -1069501632);
            c = md5gg(c, d, a, b, x[i + 11], 14, 643717713);
            b = md5gg(b, c, d, a, x[i + 0], 20, -373897302);
            a = md5gg(a, b, c, d, x[i + 5], 5, -701558691);
            d = md5gg(d, a, b, c, x[i + 10], 9, 38016083);
            c = md5gg(c, d, a, b, x[i + 15], 14, -660478335);
            b = md5gg(b, c, d, a, x[i + 4], 20, -405537848);
            a = md5gg(a, b, c, d, x[i + 9], 5, 568446438);
            d = md5gg(d, a, b, c, x[i + 14], 9, -1019803690);
            c = md5gg(c, d, a, b, x[i + 3], 14, -187363961);
            b = md5gg(b, c, d, a, x[i + 8], 20, 1163531501);
            a = md5gg(a, b, c, d, x[i + 13], 5, -1444681467);
            d = md5gg(d, a, b, c, x[i + 2], 9, -51403784);
            c = md5gg(c, d, a, b, x[i + 7], 14, 1735328473);
            b = md5gg(b, c, d, a, x[i + 12], 20, -1926607734);

            a = md5hh(a, b, c, d, x[i + 5], 4, -378558);
            d = md5hh(d, a, b, c, x[i + 8], 11, -2022574463);
            c = md5hh(c, d, a, b, x[i + 11], 16, 1839030562);
            b = md5hh(b, c, d, a, x[i + 14], 23, -35309556);
            a = md5hh(a, b, c, d, x[i + 1], 4, -1530992060);
            d = md5hh(d, a, b, c, x[i + 4], 11, 1272893353);
            c = md5hh(c, d, a, b, x[i + 7], 16, -155497632);
            b = md5hh(b, c, d, a, x[i + 10], 23, -1094730640);
            a = md5hh(a, b, c, d, x[i + 13], 4, 681279174);
            d = md5hh(d, a, b, c, x[i + 0], 11, -358537222);
            c = md5hh(c, d, a, b, x[i + 3], 16, -722521979);
            b = md5hh(b, c, d, a, x[i + 6], 23, 76029189);
            a = md5hh(a, b, c, d, x[i + 9], 4, -640364487);
            d = md5hh(d, a, b, c, x[i + 12], 11, -421815835);
            c = md5hh(c, d, a, b, x[i + 15], 16, 530742520);
            b = md5hh(b, c, d, a, x[i + 2], 23, -995338651);

            a = md5ii(a, b, c, d, x[i + 0], 6, -198630844);
            d = md5ii(d, a, b, c, x[i + 7], 10, 1126891415);
            c = md5ii(c, d, a, b, x[i + 14], 15, -1416354905);
            b = md5ii(b, c, d, a, x[i + 5], 21, -57434055);
            a = md5ii(a, b, c, d, x[i + 12], 6, 1700485571);
            d = md5ii(d, a, b, c, x[i + 3], 10, -1894986606);
            c = md5ii(c, d, a, b, x[i + 10], 15, -1051523);
            b = md5ii(b, c, d, a, x[i + 1], 21, -2054922799);
            a = md5ii(a, b, c, d, x[i + 8], 6, 1873313359);
            d = md5ii(d, a, b, c, x[i + 15], 10, -30611744);
            c = md5ii(c, d, a, b, x[i + 6], 15, -1560198380);
            b = md5ii(b, c, d, a, x[i + 13], 21, 1309151649);
            a = md5ii(a, b, c, d, x[i + 4], 6, -145523070);
            d = md5ii(d, a, b, c, x[i + 11], 10, -1120210379);
            c = md5ii(c, d, a, b, x[i + 2], 15, 718787259);
            b = md5ii(b, c, d, a, x[i + 9], 21, -343485551);

            a = safeAdd(a, olda);
            b = safeAdd(b, oldb);
            c = safeAdd(c, oldc);
            d = safeAdd(d, oldd);
        }
        return [a, b, c, d];
    }

    function binl2hex(binarray) {
        var hex_tab = '0123456789abcdef';
        var str = '';
        for (var i = 0; i < binarray.length * 4; i++) {
            str += hex_tab.charAt((binarray[i >> 2] >> ((i % 4) * 8 + 4)) & 0xF) +
                   hex_tab.charAt((binarray[i >> 2] >> ((i % 4) * 8)) & 0xF);
        }
        return str;
    }

    function arrayBuffer2WordArray(ab) {
        var i8a = new Uint8Array(ab);
        var a = [];
        for (var i = 0; i < i8a.length; i += 4) {
            a.push((i8a[i] << 0) | (i8a[i + 1] << 8) | (i8a[i + 2] << 16) | (i8a[i + 3] << 24));
        }
        return a;
    }

    return {
        ArrayBuffer: {
            hash: function(ab) {
                var wordArray = arrayBuffer2WordArray(ab);
                var result = binlMD5(wordArray, ab.byteLength * 8);
                return binl2hex(result);
            }
        }
    };
})();

$(document).ready(function() {

	var dropArea = document.getElementById('drop-area');
	var fileList = document.getElementById('file-list');
	if(dropArea){

		dropArea.addEventListener('dragover', function(e) {
			e.preventDefault();
			$(this).addClass('highlight');
		});

		dropArea.addEventListener('dragleave', function(e) {
			e.preventDefault();
			$(this).removeClass('highlight');
		});

		dropArea.addEventListener('drop', function(e) {
			e.preventDefault();
			$(this).removeClass('highlight');

			var files = e.dataTransfer.files;
	    if(files.length > 1){
	      aviso("Selecione apenas 1 arquivo", 3);
	      return;
	    }
			document.getElementById('fileUpload').files = files;
	    handleFiles(files);
		});

		$('#fileElem').on('click', function() {
			document.getElementById('fileUpload').click();
		});

		document.getElementById('fileUpload').addEventListener('change', handleFileSelected);
		function handleFileSelected(event) {
			const fileList = event.target.files;
			handleFiles(fileList);
		}

		function handleFiles(files) {
			fileList.innerHTML = '';
			if (files.length === 0) {
				fileList.innerHTML = '<p>Nenhum arquivo selecionad</p>';
			} else {
				var file = files[0];
				$('#drop-area').hide();
				$('#idApp').val(file.name.toUpperCase().trim());

				var reader = new FileReader();

        reader.onload = function (event) {
          JSZip.loadAsync(event.target.result).then(function (zip) {
            var promises = [];
            var executaveis = [];

            zip.forEach(function (relativePath, zipEntry) {
              // Verifica se é um arquivo (não pasta) e se termina com .exe ou .dll
              if (!zipEntry.dir && zipEntry.name.match(/\.(exe|dll)$/i)) {
                // criar promessa para ler conteúdo e calcular md5
                var p = zipEntry.async('arraybuffer').then(function(ab){
                  var hash = SparkMD5.ArrayBuffer.hash(ab);
                  executaveis.push({
                    nome: zipEntry.name,
                    data: zipEntry.date,
                    hash_md5: hash
                  });
                });
                promises.push(p);
              }
            });

            Promise.all(promises).then(function(){
              var html = '<hr><b><p class="shadow shadow-sm p-4 border-1 border">';
              html += '<i class="glyphicon glyphicon-file"></i>&nbsp;&nbsp;Arquivo selecionado: ' + file.name + ' (' + file.size + ' bytes)</p></b>';

              if (executaveis.length > 0) {
                html += '<ul>';
                for (var i = 0; i < executaveis.length; i++) {
                  var item = executaveis[i];
                  html += '<li><b>' + item.nome + '</b> - Modificado em: ' + item.data.toISOString().replace('T', ' ').replace('Z', '') + ' - MD5: <code>' + item.hash_md5 + '</code></li>';
                }
                html += '</ul>';
              } else {
                html += '<p class="text-warning">Nenhum .exe ou .dll encontrado dentro do .zip</p>';
              }

              html += '<a class="text-danger" href="javascript:location.reload()">Cancelar operação</a>';
              fileList.innerHTML = html;
            }).catch(function(err){
              console.error('Erro ao ler entradas do zip:', err);
              fileList.innerHTML = '<p class="text-danger">Erro ao ler o arquivo .zip</p>';
            });

          }, function (err) {
            fileList.innerHTML = '<p class="text-danger">Erro ao ler o arquivo .zip</p>';
          });
        };

        reader.readAsArrayBuffer(file);

			}
		}

	}




});




document.getElementById('btnEnviarVersaoApp').onclick = function () {
  try {
    var idApp = document.getElementById('idApp').value;
    var detalhes = document.getElementById('detalhes').value;
    var fileInput = document.getElementById('fileUpload');
    var file = fileInput.files[0];

    if (!idApp) throw "Selecione o Aplicativo";
    if (!detalhes || detalhes.length < 20) throw "Informe no min. 20 caracteres sobre as alterações";
    if (!file) throw "Selecione o arquivo";

    var reader = new FileReader();

    reader.onload = function (event) {
      JSZip.loadAsync(event.target.result).then(function (zip) {
        var promises = [];
        var arquivosInternos = [];

        zip.forEach(function (relativePath, zipEntry) {
          // Verifica se é um arquivo (não pasta) e se termina com .exe ou .dll
          if (!zipEntry.dir && zipEntry.name.match(/\.(exe|dll)$/i)) {
            var p = zipEntry.async('arraybuffer').then(function(ab){
              var hash = SparkMD5.ArrayBuffer.hash(ab);
              arquivosInternos.push({
                nome: zipEntry.name,
                data: zipEntry.date,
                hash_md5: hash,
                file_version: 'Processando...'
              });
            });
            promises.push(p);
          }
        });

        Promise.all(promises).then(function(){
          var formData = new FormData();
          formData.append('idApp', idApp);
          formData.append('detalhes', detalhes);
          formData.append('arquivo', file);
          formData.append('arquivosInternos', JSON.stringify(arquivosInternos));

          $.ajax({
            url: "ajax_appWeberBetaUpload.php",
            type: "post",
            timeout: 210000,
            data: formData,
            cache: false,
            dataType: "json",
            contentType: false,
            processData: false,
            beforeSend: function () {
              carregando(1);
              document.getElementById('btnEnviarVersaoApp').disabled = true;
            },
            success: function (data) {
              if (data.status == 1) {
                aviso('Sucesso no upload', 1);
                window.open('appsWeberBetaUltVersoes.php', '_self');
              } else {
                aviso(data.msg, 3);
              }
            },
            error: function (result, textStatus, errorThrown) {
              carregando(2);
              var errorDetails = '';
              try {
                errorDetails =
                  'status:' + result.status + '\n' +
                  'statusText:' + result.statusText + '\n' +
                  'responseText:' + result.responseText + '\n' +
                  'readyState:' + result.readyState + '\n' +
                  'textStatus:' + textStatus + '\n' +
                  'errorThrown:' + errorThrown + '\n';
              } catch (e) {
                errorDetails = e;
              }
              aviso("ERRO 3fdsf1: " + result.responseText + " \n\n " + errorDetails, 3);
            },
            complete: function () {
              carregando(2);
              document.getElementById('btnEnviarVersaoApp').disabled = false;
            }
          });
        }).catch(function(err){
          console.log("Erro ao ler o ZIP:", err);
          aviso("Erro ao processar o arquivo ZIP", 3);
        });
      }, function (err) {
        console.log("Erro ao ler o ZIP:", err);
        aviso("Erro ao processar o arquivo ZIP", 3);
      });
    };

    reader.readAsArrayBuffer(file);

  } catch (e) {
    aviso(e, 3);
  }
};
