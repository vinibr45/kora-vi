function abreModalTask(tituloSugerido){
  const idForm = 'frmCreateTask' + generateUUID();
  criaModal('modalTaskTeams', 'Criar Tarefa no Microsoft Teams');
  html = `
  <form action="" enctype="multipart/form-data" id="`+idForm+`" >
  <hr class="mt-0">
  <div class="row">

  <div class="col-md-12 col-sm-12">
  <div class="form-group">
  <label for="">Título da tarefa</label>
  <input type="text" maxlength="50" minlength="5" name="title" id="title" class="form-control" value="` + ( tituloSugerido ? tituloSugerido : '' ) + `" required />
  </div>
  </div>

  <div class="col-md-12 col-sm-12">
  <div class="form-group">
  <label for="">Data para conclusão</label>
  <input type="date" name="dueDateTime" id="dueDateTime" class="form-control" required />
  </div>
  </div>

  <div class="col-md-12 col-sm-12">
  <div class="form-group">
  <label for="">Lembrar-me na data</label>
  <input type="datetime-local" name="reminderDateTime" id="reminderDateTime" class="form-control" />
  </div>
  </div>

  <div class="col-md-12 col-sm-12">
  <div class="form-group">
  <label for="">Observações</label>
  <textarea name="bodyContent" id="bodyContent" class="form-control" rows="3"></textarea>
  </div>
  </div>

  </div>
  <hr>
  <button type="submit" class="btn float-right btn-success" id="btnCreateTaskTeams" >Criar Tarefa</button>
  <div id="taskLoadingDiv"></div>
  <br><br><br>

  </form>`;

  $("#modalTaskTeams_content").html(html);
  $('#dueDateTime').on('change', function(){
    try {
      console.log('here11');
      // Get the values of the datetime-local inputs
      let reminderDateTimeTxt = document.getElementById('reminderDateTime').value;
      let dueDateTimeTxt = document.getElementById('dueDateTime').value;

      // Convert the values to Date objects
      let dueDateTime = new Date(dueDateTimeTxt);
      let newReminderDateTime = new Date(dueDateTimeTxt);
      let reminderDateTime = new Date(reminderDateTimeTxt);

      if(newReminderDateTime <= reminderDateTime || reminderDateTime == 'Invalid Date'){

        // Adjust the date to Brazil time (-03:00)
        let timezoneOffset = 0 * 60; // -03:00 in minutes
        newReminderDateTime.setMinutes(newReminderDateTime.getMinutes() - newReminderDateTime.getTimezoneOffset() + timezoneOffset);

        // Subtract 0.5 hour
        newReminderDateTime.setMinutes(newReminderDateTime.getMinutes() - 15);


        // Get the current time in Brazil timezone
        let now = new Date();
        // Calculate Brazil timezone offset (-03:00)
        let brazilOffset = -3 * 60; // -03:00 in minutes
        // Adjust the current time to Brazil timezone
        now.setMinutes(now.getMinutes() + brazilOffset);

        if(newReminderDateTime < dueDateTime && newReminderDateTime > now){

          // Format the date back to a datetime-local string
          let formattedReminderDateTime = newReminderDateTime.toISOString().slice(0, 16);
          document.getElementById('reminderDateTime').value = formattedReminderDateTime;

        } else {
          document.getElementById('reminderDateTime').value = '';
        }


      }

    } catch (e) {
      console.log(e);
    } finally {

    }

  });
  $('#'+idForm).on('submit', function(){

    try {

      event.preventDefault();

      $('#btnCreateTaskTeams').hide();
      $('#taskLoadingDiv').html('<div style="width:100%;text-align:center;"><img src="imagens/loadingRoll.svg" width="30px"></div>');

      $.ajax({
        url:"ajax_msTeamsCreateTask.php",
        type:"post",
        dataType:"json",
        timeout: 60 * 1000, //60 seconds
        data: new FormData(this),
        processData: false,
        contentType: false,
        beforeSend: function(result){
          carregando(1);
        },
        success: function (result){

          if(result.status == 1){
            $("#modalTaskTeams").modal('hide');
            var currentUrl = window.location.href;
            if (currentUrl.indexOf("menu.php") !== -1) {
              listTasksUserToDiv('#msTasksList');
            }
          } else {
            aviso("Erro na solicitação\n"+result.mensagem, 3);
          }

        },
        error: function(result) {
          aviso("Erro na solicitação\n"+result.statusText, 3);
        },
        complete: function(result){
          carregando(2);
          $('#btnCreateTaskTeams').show();
          $('#taskLoadingDiv').html('');
        }
      });

    } catch (ex) {

      aviso("ERRO FSDRES:" + ex, 3);
      carregando(2);
    }

  });
  $("#modalTaskTeams").modal('show');
  $("#modalTaskTeams_content #title").focus();
}

function checkMicrosoftToDoApp() {
  var uri = 'ms-todo://';
  var isSupported = false;

  var testLink = document.createElement('a');
  testLink.href = uri;

  if (typeof testLink.href === 'string' && testLink.href.indexOf(uri) === 0) {
    isSupported = true;
  }

  return isSupported;
}


function openMicrosoftToDo() {

  if(isMobileDevice() == true){
    window.open('https://to-do.office.com/tasks/inbox', '_blank');
  } else {
    if(checkMicrosoftToDoApp() == true){
      var uri = 'ms-todo://';
      window.location.href = uri;
    } else {
      aviso("Instale o App Microsoft To Do");
    }
  }


}

function listTasksUserToDiv(divId){

  try {


    $.ajax({
      url:"ajax_msTeamsListTasks.php",
      type:"post",
      dataType:"json",
      timeout: 20 * 1000, //20 seconds
      data: { },
      beforeSend: function(result){
        $(divId).html(setaLoadingModal());
      },
      success: function (result){

        var html  = '<div class="pricing"><div class="price-body bg-white shadow-sm">';
        if(result.status == 1){
          var tasks = result.obj.value;
          if(tasks.length > 0){
            $.each(tasks, function(key,value){

              html += '<badge class="badge mr-2 mt-2" style="color:#000 !Important; background: #eee !important;">';

              var formattedDate = " {Sem data cadastrada} ";
              if(value.dueDateTime){
                // Parse the date string into a Date object
                const date = new Date(value.dueDateTime.dateTime);

                // Extract day, month, and year from the Date object
                const day = date.getDate().toString().padStart(2, '0');
                const month = (date.getMonth() + 1).toString().padStart(2, '0'); // Months are zero-based
                const year = date.getFullYear();

                // Formatted date in dd/mm/yyyy format
                formattedDate = `${day}/${month}/${year}`;
              }


                html += "<h6><i class='fa fa-check mr-2'></i>"+value.title+"</h6>";
                html += "<small>Concluir em " + formattedDate + "</small>";
                html += "</badge>";

            });

          } else {
            html += "Nenhuma tarefa pendente."
          }

        } else {
          html += "Erro na solicitação\n"+result.mensagem;
        }
        html += "<hr><a class='btn btn-outline' href='javascript:abreModalTask()'>Criar Tarefa</a>  <a class='btn btn-outline' href='javascript:openMicrosoftToDo();'>Acessar Tarefas</a> <a class='btn btn-outline' href='javascript:listTasksUserToDiv(\"" + divId + "\")'>Atualizar</a>";
        html += '</div></div>';
        $(divId).html(html);

      },
      error: function(result) {
        aviso("Erro na solicitação\n"+result.statusText, 3);
      },
      complete: function(result){

      }
    });

  } catch (ex) {
    aviso("ERRO FMES:" + ex, 3);
  }

}

document.addEventListener('keydown', function(event) {
  if (event.altKey && event.key === 't') {
    abreModalTask();
  }
});
