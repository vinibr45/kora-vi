function atualizaCategorias(){
  //Salva em sessionstorage
  sessionStorage.removeItem("tree_categories");
  window.open('menu.php','_self');
}

function criaModal(id_modal, title, modal_largura){
  try {
    $("#"+id_modal).remove();
  } catch(err){

  }
  var div_modal = '<div class="modal fade" data-backdrop="static" id="'+id_modal+'" role="dialog"> <div class="modal-dialog '+modal_largura+'"><div class="modal-content"> <div class="modal-header"> <h4 class="modal-title">'+title+'</h4></div><div id="'+id_modal+'_content" class="modal-body"></div></div></div></div>'
  $('body').append(div_modal);
}

function setaLoadingModal(){
  return '<div class="spinner-border m-5 p-3" role="status"><span class="visually-hidden"></span></div>';
}

function accessObjectVersion(objectKey, versionId){
  carregando(1);
  $.ajax({
    url: "accessObjectVersion.php",
    type: "post",
    data: { objectKey : objectKey, versionId : versionId  },
    success: function (result){
      window.open(result,'_blank');
    }, error: function(result) {
      swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
    }, complete:function(result){
      carregando(2);
    }
  });
}


function continueAddNewArticle(){

  var articleTitle = $('#tituloAddNewArticleModal').val();
  if(!articleTitle || articleTitle.length < 4){
    swal("Ops..", "Descreva mais o título do artigo", "error");
  }

  carregando(1);
  $('#divButtonsAddNewArticle').html(setaLoadingModal());
  $.ajax({
    url:"ajax/ajax_Add.php",
    type:"post",
    dataType:"json",
    data: {
      categoria : null,
      ordem_cat : 99,
      data1 : null,
      data2 : null,
      titulo : articleTitle,
      id_reg : null,
      artigo_Publico : null,
    },
    success: function (result){

      if(result.status == 1){
        window.onbeforeunload = function (event) {
          event.preventDefault();
          event.returnValue = '';
        };
        // Depois: Removendo o evento
        window.onbeforeunload = null;
        window.open('add.php?artigo=' + result.id_artigo, '_self');
      } else {
        alert("ERRO: " + result.mensagem);
      }
    },
    complete: function(result){
      carregando(2);
    },
    error: function(result){
      alert("ERRO: " + result.statusText);
    }
  });


}

function closeAddNewArticle(){

  var idModal = "modalAddNewArticle";
  $('#'+idModal).modal('hide');

}

function addNovoArtigo(){

  var idModal = "modalAddNewArticle";

  criaModal(idModal, 'Adicionar novo artigo');

  $.ajax({
    url:"add_new.php",
    type:"post",
    data: {  },
    success: function (result){
      $('#'+idModal+'_content').html(result);
    },
    error: function(result){
      $('#tree_categories').html("Erro ao obter formulario:\n" + result.statusText);
    },
    complete:function(){
      $('#'+idModal).modal('show');
    }
  });

}

function getObjectVersionsAutoSave(id_publico, title){
  criaModal('modalVersoesArquivoAutoSave', title, 'modal-lg');
  $("#modalVersoesArquivoAutoSave_content").html(setaLoadingModal());
  $("#modalVersoesArquivoAutoSave").modal('show');
  $.ajax({
    url: "objectVersionsAutoSave.php",
    type: "post",
    data: { id_publico : id_publico  },
    success: function (result){
      html = result;
    }, error: function(result) {
      swal("Ops..", "Erro na solicitação \n"+result.statusText, "error");
    }, complete:function(result){
      $("#modalVersoesArquivoAutoSave_content").html(html);
    }
  });
}

