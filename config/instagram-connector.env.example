# KORA private Instagram connector example
# Copy this file to C:\KORA\.env through a secure local process and fill real values there.
# Never commit, paste, or store real values in public repositories or chat.

INSTAGRAM_MARCOS_DEV_ACCESS_TOKEN=<token-de-acesso>
INSTAGRAM_MARCOS_DEV_ACCOUNT_ID=<id-da-conta-profissional>
# INSTAGRAM_MARCOS_DEV_API_VERSION=v26.0